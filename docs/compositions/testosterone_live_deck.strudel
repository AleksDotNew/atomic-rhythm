// ============================================================================
// TESTOSTERONE (C19H28O2) — LIVE DECK (GOJIRA / MESHUGGAH)
// Interactive Live-Coding Jam Deck with Realtime Control Sliders
//
// Controls:
// - djentGain:  Громкость стены звука 8-струнных гитар (0.0..1.2)
// - djentDrive: Уровень дисторшна и сатурации перегруза (0.2..0.95)
// - pickScrape: Интенсивность фирменного скрежета медиатора Gojira (0.0..1.0)
// - leadGain:   Громкость парящего 17-OH соло-лида (0.0..1.0)
// - doubleKick: Плотность пулемётных очередей бас-бочки (0.5..1.3)
// ============================================================================

setcps(125 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// Безопасный загрузчик слайдеров Strudel: slider(default, min, max, step)
const getSlider = (val, min, max, step) => (typeof slider === 'function' ? slider(val, min, max, step) : val);

const djentGain  = getSlider(0.92, 0.0, 1.2, 0.02);
const djentDrive = getSlider(0.80, 0.2, 0.95, 0.05);
const pickScrape = getSlider(0.40, 0.0, 1.0, 0.05);
const leadGain   = getSlider(0.85, 0.0, 1.0, 0.05);
const doubleKick = getSlider(1.05, 0.0, 1.3, 0.05);

stack(
  // --------------------------------------------------------------------------
  // СЛОЙ 1: АКУСТИЧЕСКОЕ ВОДОРОДНОЕ ОБЛАКО (Clean Arpeggio)
  // --------------------------------------------------------------------------
  note("<[c#3 g#3 e4 d#4 g#3 e4] [c#3 a3 e4 f#4 a3 e4] [c#3 g#3 e4 d#4 g#3 e4] [b2 f#3 d4 e4 f#4 d4]>")
    .s("gtr:0")
    .decay(0.4).sustain(0.25)
    .delay(0.45).delaytime(3/16).delayfeedback(0.65)
    .room(0.8).size(0.9)
    .pan(0.2)
    .gain(0.7),

  // --------------------------------------------------------------------------
  // СЛОЙ 2: 19 УГЛЕРОДНЫХ АТОМОВ — MESHUGGAH 19/16 POLYMETER CHUG
  // Drop C# (C#1 -> D1) с полиметрическим сдвигом: [3+3+3+3+3+4] = 19 шестнадцатых
  // --------------------------------------------------------------------------
  note("c#1!2 ~ c#1!2 ~ c#1!2 ~ c#1!2 ~ c#1!2 ~ d1!3 ~")
    .slow(19/16)
    .s("gtr:2")
    .decay(0.12).sustain(0.14)
    .distort(djentDrive)
    .lpf(3200).lpq(3.5)
    .hpf(85)
    .pan(0.35)
    .gain(djentGain),

  // Стерео-дублирование синтезатором saw:
  note("c#1!2 ~ c#1!2 ~ c#1!2 ~ c#1!2 ~ c#1!2 ~ d1!3 ~")
    .slow(19/16)
    .s("saw")
    .decay(0.14).sustain(0.16)
    .distort(djentDrive)
    .lpf(2600).lpq(4.0)
    .hpf(75)
    .pan(0.65)
    .gain(djentGain),

  // Чистый суб-бас C#1:
  note("c#1!2 ~ c#1!2 ~ c#1!2 ~ c#1!2 ~ c#1!2 ~ d1!3 ~")
    .slow(19/16)
    .s("sine")
    .decay(0.35).sustain(0.35)
    .lpf(110)
    .gain(1.05),

  // --------------------------------------------------------------------------
  // СЛОЙ 3: БАРАБАНЫ — MESHUGGAH HERTA & MARIO DUPLANTIER SNARE
  // --------------------------------------------------------------------------
  // Двойная бочка под полиметром 19/16:
  s("[bd,gretsch:13]!2 ~ [bd,gretsch:13]!2 ~ [bd,gretsch:13]!2 ~ [bd,gretsch:13]!2 ~ [bd,gretsch:13]!2 ~ [bd,gretsch:13]!3 ~")
    .slow(19/16)
    .lpf(6000)
    .distort(0.4)
    .gain(doubleKick),

  // 4/4 Снейр-метроном (Mario Duplantier snap):
  s("~ [gretsch:20,sd] ~ [gretsch:20,sd]")
    .hpf(160)
    .room(0.25)
    .gain(0.95),

  // Чайна / Крэш:
  s("cr*4")
    .hpf(3500)
    .room(0.3)
    .gain(0.8),

  // --------------------------------------------------------------------------
  // СЛОЙ 4: GOJIRA PICK SCRAPE & МЕТАЛЛИЧЕСКИЙ СКРЕЖЕТ
  // --------------------------------------------------------------------------
  s("<~!3 [metal:1*2] ~!3 [metal:1*4]>")
    .speed("<0.7 0.45 0.3>")
    .distort(0.9)
    .hpf(350).lpf(5500)
    .delay(0.35).delaytime(2/16).delayfeedback(0.55)
    .room(0.6)
    .gain(pickScrape),

  // --------------------------------------------------------------------------
  // СЛОЙ 5: 17β-OH СОЛО-ЛИД (Gojira Silvera style)
  // --------------------------------------------------------------------------
  note("<[c#5@2 e5@2 f#5@2 g5@2] [f#5@2 e5@2 d5@2 c#5@2] [c#5@2 g5@3 f#5@2 e5] [d5@2 c#5@2 b4@2 c#5@2]>")
    .s("gtr:2")
    .attack(0.04).decay(0.55).sustain(0.4)
    .lpf(5200)
    .distort(0.45)
    .delay(0.45).delaytime(3/16).delayfeedback(0.6)
    .room(0.75).size(0.88)
    .pan(0.55)
    .jux(rev)
    .gain(leadGain)
)
