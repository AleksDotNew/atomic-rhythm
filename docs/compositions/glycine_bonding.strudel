// ============================================================================
// GLYCINE (NCC(=O)O) — MOLECULAR BONDING & DISTANCE APPROACH (124 BPM)
// Concept: Simulation of physical distance, spiral trajectory approach,
// and covalent bonding between Amino (H2N-CH2-) and Carboxyl (-COOH) fragments.
// Genre: Hypnotic Organic Deep Techno / Melodic Minimal
// Key: A Minor / C Lydian | BPM: 124
// ============================================================================

setcps(124 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ============================================================================
// TIMELINE (64 cycles @ 124 BPM, ~2:04):
// Phase 1 (cycles 0-3):   Одиночный атом/фрагмент А (Аминогруппа: сухой кик и рим)
// Phase 2 (cycles 4-11):  Сближение фрагмента Б (Карбоксил) витками спирали:
//                         рассинхрон, движение по панораме, нарастание частот и громкости
// Phase 3 (cycles 12):    КОВАНТНАЯ СВЯЗЬ — Фазовый щелчок и соединение орбиталей
// Phase 4 (cycles 13-51): Цельная молекула Глицина H2N-CH2-COOH (полный монолитный грув)
// Phase 5 (cycles 52-63): Связывание с рецептором GlyR — успокоение и мягкий фейдаут
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // ФРАГМЕНТ А: АМИНОГРУППА H2N-CH2- (Углерод C1 и Азот N)
  // Исходный атом: звучит в центре/слева с самого начала (сухой, стабильный пульс)
  // --------------------------------------------------------------------------
  // Кик фрагмента А (углерод альфа)
  s("<[bd:3 ~ ~ ~ ~ ~ bd:3 ~]!12 [bd:3 ~ ~ ~ bd:3 ~ ~ ~]!40 [bd:3 ~ ~ ~]!12>")
    .pan(0.35)
    .gain(0.92),

  // Римшот/щелчок фрагмента А (азот аминогруппы)
  s("<[~ ~ ~ ~ rim ~ ~ ~]!12 [~ ~ ~ ~ rim ~ ~ ~]!40 [~ ~ ~ ~ rim ~ ~ ~]!12>")
    .hpf(600)
    .pan(0.3)
    .gain(0.75),

  // --------------------------------------------------------------------------
  // ФРАГМЕНТ Б: КАРБОКСИЛЬНАЯ ГРУППА -COOH (Углерод C=O и Кислороды)
  // ЭФФЕКТ СБЛИЖЕНИЯ:
  // - Такты 0-3: тишина (атом еще бесконечно далеко)
  // - Такты 4-11: 8 витков спирали сближения:
  //   * Панорама ходит восьмеркой: pan("<0.95 0.1 0.85 0.2 0.75 0.3 0.6 0.5>")
  //   * Фильтр раскрывается от глухого гула до четкого щелчка: lpf("<300 450 700 1100 1800 2800 4500 8000>")
  //   * Пространство переходит из далекой пещеры в ближнее поле: room("<0.9 0.85 0.75 0.65 0.5 0.4 0.3 0.2>")
  //   * Рассинхрон задержки сжимается с каждым витком до идеального фазового нуля!
  // --------------------------------------------------------------------------
  s("<~!4 [~ ~ ~ ~ ~ ~ ~ bd:4] [~ ~ ~ ~ ~ bd:4 ~ ~] [~ ~ bd:4 ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ bd:4 ~] [~ ~ ~ bd:4 ~ ~ ~ ~] [~ bd:4 ~ ~ ~ ~ bd:4 ~] [~ ~ bd:4 ~ ~ ~ bd:4 ~] [~ bd:4 ~ ~ bd:4 ~ ~ ~] [~ ~ ~ ~ bd:4 ~ ~ bd:4]!40 [~ ~ ~ ~ bd:4 ~ ~ ~]!12>")
    // Спиральная панорама сближения:
    .pan("<0.95 0.1 0.85 0.2 0.75 0.3 0.6 0.5 0.5!40 0.5!12>")
    // Раскрытие частот с приближением:
    .lpf("<300 450 700 1100 1800 2800 4500 8000 8000!40 1200!12>")
    // Дистанция реверберации:
    .room("<0.9 0.85 0.75 0.65 0.5 0.4 0.3 0.2 0.25!40 0.7!12>")
    // Громкость приближающегося объекта:
    .gain("<0.25 0.35 0.48 0.6 0.72 0.82 0.9 0.95 0.92!40 0.4!12>")
    // Микро-рассинхрон (Doppler / Phase offset), уходящий в 0:
    .delay("<0.6 0.5 0.4 0.3 0.2 0.1 0.05 0 0!40 0!12>")
    .delaytime("<0.08 0.06 0.04 0.03 0.02 0.01 0.005 0 0!40 0!12>"),

  // Снэр/клэп карбоксильного кислорода C=O (также сближается на витках 4-11):
  s("<~!4 ~ [~ ~ ~ ~ ~ ~ ~ cp] ~ [~ ~ ~ ~ ~ cp ~ ~] ~ [~ ~ ~ ~ ~ cp ~ cp] [~ ~ ~ ~ cp ~ ~ ~] [~ ~ ~ ~ cp ~ ~ ~]!40 ~!12>")
    .pan("<0.95 0.1 0.85 0.2 0.75 0.3 0.6 0.5 0.65!40 0.5!12>")
    .lpf("<350 500 800 1400 2200 3500 6000 8000 7000!40 1000!12>")
    .room("<0.9 0.85 0.75 0.65 0.5 0.4 0.3 0.2 0.3!40 0.7!12>")
    .gain("<0.2 0.3 0.42 0.55 0.68 0.78 0.85 0.88 0.82!40 0!12>"),

  // --------------------------------------------------------------------------
  // МОМЕНТ СОЕДИНЕНИЯ: КОВАЛЕНТНАЯ СВЯЗЬ C-C (Вспышка на такте 12)
  // Яркий металлический щелчок замыкания электронных оболочек
  // --------------------------------------------------------------------------
  s("<~!12 [industrial:4, cp]!1 ~!51>")
    .hpf(1000)
    .crush(4)
    .distort(0.4)
    .room(0.6).size(0.8)
    .gain(0.95),

  // --------------------------------------------------------------------------
  // ЦЕЛЬНАЯ МОЛЕКУЛА: ОБЛАКО 5 ВОДОРОДОВ (H5 — 16-дольный роллинг)
  // Начинает шелестеть после объединения молекулы (с такта 13)
  // --------------------------------------------------------------------------
  s("<~!12 [hh*16]!40 [hh*8]!12>")
    .gain("<[0.2 0.6 0.35 0.7 0.25 0.65 0.4 0.75]*2>")
    .hpf(3500)
    .pan(0.4)
    .gain("<0!12 0.65!40 0.25!12>"),

  // --------------------------------------------------------------------------
  // ЦЕЛЬНАЯ МОЛЕКУЛА: КИСЛОРОДНЫЙ ХРУСТАЛЬНЫЙ АРПЕДЖИО (-COOH Кислороды)
  // Чистый, медитативный, седативный мотив Глицина в ладу C Lydian / A Minor
  // Просыпается в момент образования связи и мягко переливается
  // --------------------------------------------------------------------------
  s("<~!12 [triangle*2]!40 triangle!12>")
    .note("<[0 4 7 11 12 14 16 14] [2 6 9 12 14 16 18 16] [4 7 11 14 16 18 19 18] [0 2 4 7 11 12 14 12]>".scale("c4:lydian"))
    .decay(0.12).sustain(0)
    .lpf(slider(3200, 400, 7500, 50))
    .lpq(2.5)
    .delay(0.38).delaytime(3/16).delayfeedback(0.52)
    .jux(rev)
    .gain("<0!12 0.72!40 0.3!12>"),

  // --------------------------------------------------------------------------
  // ЦЕЛЬНАЯ МОЛЕКУЛА: ГЛУБОКИЙ ТЕПЛЫЙ БАС ГЛИЦИНА (Тормозной медиатор ЦНС)
  // Обволакивающий аналоговый саб-бас, приносящий спокойствие и фокус
  // --------------------------------------------------------------------------
  s("<~!12 [~ saw*3]*2!40 [~ saw*2]!12>")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.2).sustain(0.1)
    .lpf(slider(450, 150, 1200, 20))
    .lpq(3)
    .distort(0.25)
    .pan(0.5)
    .gain("<0!12 0.88!40 0.35!12>"),

  // Чистый 40-55 Гц саб под басом
  s("<~!12 sine*2!40 sine!12>")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.3).sustain(0.2)
    .lpf(90)
    .gain("<0!12 0.92!40 0.4!12>"),

  // --------------------------------------------------------------------------
  // АТМОСФЕРНЫЙ РЕЛАКСАЦИОННЫЙ ПЭД (Cmaj9 - Am9 - Fmaj7#11 - Em7)
  // --------------------------------------------------------------------------
  s("<sine!12 sine!40 sine!12>")
    .note("<[c3,e3,g3,b3,d4] [a2,c3,e3,g3,b3] [f2,a2,c3,e3,g3] [e2,g2,b2,d3,f#3]>")
    .attack(0.5).release(0.9)
    .lpf("<400!4 800!8 1400!40 500!12>")
    .room(0.8).size(0.85)
    .gain("<0.3!4 0.45!8 0.55!40 0.25!12>")
)
