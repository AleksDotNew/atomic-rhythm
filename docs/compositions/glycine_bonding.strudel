// ============================================================================
// GLYCINE (NCC(=O)O) — MOLECULAR BONDING & DISTANCE APPROACH (124 BPM)
// Concept: Simulation of physical distance, spiral trajectory approach,
// and covalent bonding between Amino (H2N-CH2-) and Carboxyl (-COOH) fragments.
// FEATURING: Memorable Lead Hook, Breathing 8th-note Arpeggio with pauses,
// stereo panoramic motion & seamless cross-morphing!
// Genre: Hypnotic Melodic Deep Techno / Organic Electronica
// Key: A Minor / C Lydian | BPM: 124
// ============================================================================

setcps(124 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ============================================================================
// TIMELINE (64 cycles @ 124 BPM, ~2:04):
// Phase 1 (cycles 0-3):   Одиночный атом А (Аминогруппа: сухой кик и рим слева)
// Phase 2 (cycles 4-11):  Сближение атома Б (Карбоксил) витками спирали:
//                         рассинхрон, блуждание по панораме, раскрытие частот
// Phase 3 (cycle 12):     КОВАЛЕНТНАЯ СВЯЗЬ — Вспышка и соединение электронных оболочек
// Phase 4 (cycles 13-51): Цельная молекула Глицина: запоминающийся хук лида,
//                         дышащее 1/8 арпеджио с паузами, глубокий аналоговый бас
// Phase 5 (cycles 52-63): Связывание с рецептором GlyR — успокоение и мягкий фейдаут
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // ФРАГМЕНТ А: АМИНОГРУППА H2N-CH2- (Углерод C1 и Азот N)
  // Базовый неподвижный фрагмент (сухой аналоговый кик и римшот)
  // --------------------------------------------------------------------------
  s("<[bd:3 ~ ~ ~ ~ ~ bd:3 ~]!12 [bd:3 ~ ~ ~ bd:3 ~ ~ ~]!40 [bd:3 ~ ~ ~]!12>")
    .pan(0.35)
    .gain(0.92),

  s("<[~ ~ ~ ~ rim ~ ~ ~]!12 [~ ~ ~ ~ rim ~ ~ ~]!40 [~ ~ ~ ~ rim ~ ~ ~]!12>")
    .hpf(600)
    .pan(0.3)
    .gain(0.75),

  // --------------------------------------------------------------------------
  // ФРАГМЕНТ Б: КАРБОКСИЛЬНАЯ ГРУППА -COOH (Приближающийся атом)
  // 8 витков сближения: панорама восьмеркой, раскрытие LPF, сжатие рассинхрона
  // --------------------------------------------------------------------------
  s("<~!4 [~ ~ ~ ~ ~ ~ ~ bd:4] [~ ~ ~ ~ ~ bd:4 ~ ~] [~ ~ bd:4 ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ bd:4 ~] [~ ~ ~ bd:4 ~ ~ ~ ~] [~ bd:4 ~ ~ ~ ~ bd:4 ~] [~ ~ bd:4 ~ ~ ~ bd:4 ~] [~ bd:4 ~ ~ bd:4 ~ ~ ~] [~ ~ ~ ~ bd:4 ~ ~ bd:4]!40 [~ ~ ~ ~ bd:4 ~ ~ ~]!12>")
    .pan("<0.95 0.1 0.85 0.2 0.75 0.3 0.6 0.5 0.5!40 0.5!12>")
    .lpf("<300 450 700 1100 1800 2800 4500 8000 8000!40 1200!12>")
    .room("<0.9 0.85 0.75 0.65 0.5 0.4 0.3 0.2 0.25!40 0.7!12>")
    .gain("<0.25 0.35 0.48 0.6 0.72 0.82 0.9 0.95 0.92!40 0.4!12>")
    .delay("<0.6 0.5 0.4 0.3 0.2 0.1 0.05 0 0!40 0!12>")
    .delaytime("<0.08 0.06 0.04 0.03 0.02 0.01 0.005 0 0!40 0!12>"),

  // Снэр/клэп карбоксильного кислорода C=O:
  s("<~!4 ~ [~ ~ ~ ~ ~ ~ ~ cp] ~ [~ ~ ~ ~ ~ cp ~ ~] ~ [~ ~ ~ ~ ~ cp ~ cp] [~ ~ ~ ~ cp ~ ~ ~] [~ ~ ~ ~ cp ~ ~ ~]!40 ~!12>")
    .pan("<0.95 0.1 0.85 0.2 0.75 0.3 0.6 0.5 0.65!40 0.5!12>")
    .lpf("<350 500 800 1400 2200 3500 6000 8000 7000!40 1000!12>")
    .room("<0.9 0.85 0.75 0.65 0.5 0.4 0.3 0.2 0.3!40 0.7!12>")
    .gain("<0.2 0.3 0.42 0.55 0.68 0.78 0.85 0.88 0.82!40 0!12>"),

  // --------------------------------------------------------------------------
  // МОМЕНТ СОЕДИНЕНИЯ: КОВАЛЕНТНАЯ СВЯЗЬ C-C (Вспышка на такте 12)
  // Яркий щелчок замыкания связи, хвост которого перетекает в атаку лида
  // --------------------------------------------------------------------------
  s("<~!12 [industrial:4, cp]!1 ~!51>")
    .hpf(1000)
    .crush(4)
    .distort(0.4)
    .room(0.6).size(0.8)
    .gain(0.95),

  // --------------------------------------------------------------------------
  // УЗНАВАЕМАЯ МЕЛОДИЯ ЛИДА (Glycine Neuro-Tranquil Lead Hook)
  // Запоминающийся, глубокий мелодический рифф (Call & Response):
  // Такт 1: ~ E5 ~ [C5 D5] | E5 ~ A4 ~  (Призывный взлет)
  // Такт 2: F5 ~ E5 D5     | C5 ~ B4 ~  (Ниспадающий ответ)
  // Такт 3: C5 ~ D5 E5     | G5 ~ E5 ~  (Подъем в светлый квинтет)
  // Такт 4: F5 ~ E5 D5     | C5 E5 B4 A4 (Красивое каденционное разрешение)
  // --------------------------------------------------------------------------
  s("<~!12 saw!40 [saw/2]!12>")
    .note("<[~ 4 ~ [2 3]] [4 ~ 0 ~]  [5 ~ 4 3] [2 ~ 1 ~]  [2 ~ 3 4] [6 ~ 4 ~]  [5 ~ 4 3] [2 4 1 0]>".scale("a4:minor"))
    .attack(0.02).decay(0.35).sustain(0.38).release(0.35)
    .lpf(slider(3400, 800, 7500, 50))
    .lpq(2.2)
    .delay(0.42).delaytime(3/16).delayfeedback(0.5)
    .jux(rev)
    .room(0.5).size(0.8)
    .gain("<0!12 0.78!40 0.3!12>"),

  // --------------------------------------------------------------------------
  // ДЫШАЩЕЕ АРПЕДЖИО: 4 1/8 НОТЫ С ПАУЗАМИ И ПАНОРАМНОЙ ИГРОЙ
  // Вместо монотонной стены 16-х — 4 выразительных 1/8 шага с пространством
  // и легкими вероятностными мерцаниями (?0.6), плавно переливающиеся в стерео!
  // --------------------------------------------------------------------------
  s("<[triangle/2]!12 triangle!40 triangle!12>")
    .note("<[0 ~ 2?0.6 ~ 4 ~ 6?0.7 ~] [~ 1 ~ 3?0.6 ~ 4 ~ 7] [7 ~ 5?0.7 ~ 4 ~ 2 ~] [~ 0 ~ 2?0.6 ~ 4 ~ 6]>".scale("a3:minor"))
    .decay(0.18).sustain(0)
    .lpf(slider(2600, 500, 6500, 50))
    .lpq(2.2)
    .pan("<0.25!2 0.75!2 0.35!2 0.65!2 0.5!4>") // Игра панорамой
    .delay(0.38).delaytime(2/16).delayfeedback(0.5)
    .jux(rev)
    .gain("<0!4 0.35!8 0.7!40 0.3!12>"),

  // --------------------------------------------------------------------------
  // 5 ВОДОРОДОВ (H5 — 16-дольный шелест хэтов)
  // --------------------------------------------------------------------------
  s("<~!12 [hh*16]!40 [hh*8]!12>")
    .gain("<[0.2 0.6 0.35 0.7 0.25 0.65 0.4 0.75]*2>")
    .hpf(3500)
    .pan(0.4)
    .gain("<0!12 0.65!40 0.25!12>"),

  // --------------------------------------------------------------------------
  // ГЛУБОКИЙ ТЕПЛЫЙ БАС ГЛИЦИНА (Тормозной медиатор ЦНС)
  // Мягкий аналоговый саб-бас: перетекает из подложки в пульсирующий бас
  // --------------------------------------------------------------------------
  s("<~!12 [~ saw*3]*2!40 [~ saw*2]!12>")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.2).sustain(0.1)
    .lpf(slider(450, 150, 1200, 20))
    .lpq(3)
    .distort(0.22)
    .pan(0.5)
    .gain("<0!12 0.88!40 0.35!12>"),

  // Чистый 40-55 Гц саб-синус
  s("<~!12 sine*2!40 sine!12>")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.3).sustain(0.2)
    .lpf(90)
    .gain("<0!12 0.92!40 0.4!12>"),

  // --------------------------------------------------------------------------
  // АТМОСФЕРНЫЙ РЕЛАКСАЦИОННЫЙ ПЭД (Cmaj9 - Am9 - Fmaj7#11 - Em7)
  // --------------------------------------------------------------------------
  s("<sine!12 sine!40 sine!12>")
    .note("<[c3,e3,g3,b3,d4] [a2,c3,e3,g3,b3] [f2,a2,c3,e3,g3] [e2,g2,b2,d3,f#3]>")
    .attack(0.5).release(0.9)
    .lpf("<400!4 800!8 1400!40 500!12>")
    .room(0.8).size(0.85)
    .gain("<0.3!4 0.45!8 0.55!40 0.25!12>"),

  // --------------------------------------------------------------------------
  // ХРУСТАЛЬНЫЙ КОЛОКОЛЬЧИК КИСЛОРОДОВ (-COOH Chime)
  // Воздушное сияние в конце фразы, растворяющееся в бесконечном ревербераторе
  // --------------------------------------------------------------------------
  s("<~!12 sine!40 sine!12>")
    .note("<[~ ~ ~ [e6,b6]] [~ ~ ~ [f6,c7]] [~ ~ ~ [g6,d7]] [~ ~ ~ [a6,e7]]>")
    .attack(0.02).decay(0.4).sustain(0)
    .lpf(2000)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain("<0!12 0.25!40 0.12!12>")
)
