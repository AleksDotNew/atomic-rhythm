// ============================================================================
// GLYCINE (NCC(=O)O) — MOLECULAR BONDING & DISTANCE APPROACH (124 BPM)
// Powered by Deep Dirt-Samples: moog, arpy, jvbass, sprvibe, pebbles, water, 808/909, tabla
// Concept: Simulation of physical distance, spiral trajectory approach,
// and covalent bonding between Amino (H2N-CH2-) and Carboxyl (-COOH) fragments.
// FEATURING: Iconic Moog Lead, Arpy 8th-note plucks with pauses, Roland Juno bass,
// and organic mineral/water textures!
// Genre: Hypnotic Melodic Deep Techno / Organic Electronica
// Key: A Minor / C Lydian | BPM: 124
// ============================================================================

setcps(124 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// РЕГУЛЯТОРЫ (Именованные слайдеры верхнего уровня)
// ----------------------------------------------------------------------------
const leadCutoff = slider(3200, 800, 7000, 50)
const arpCutoff  = slider(2800, 600, 6500, 50)
const bassCutoff = slider(500, 150, 1400, 20)

// ============================================================================
// TIMELINE (64 cycles @ 124 BPM, ~2:04):
// Phase 1 (cycles 0-3):   Одиночный атом А (Аминогруппа: 909 кик, tabla и pebbles слева)
// Phase 2 (cycles 4-11):  Сближение атома Б (Карбоксил: 808bd, 808sd) витками спирали:
//                         рассинхрон, блуждание по панораме, раскрытие частот
// Phase 3 (cycle 12):     КОВАЛЕНТНАЯ СВЯЗЬ — Вспышка future:1 + industrial:4
// Phase 4 (cycles 13-51): Цельная молекула Глицина: поющий Moog-лид, капли arpy,
//                         теплый Juno-бас, шелест водородов и минеральные микро-текстуры
// Phase 5 (cycles 52-63): Связывание с рецептором GlyR — умиротворение и мягкий фейдаут
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // ФРАГМЕНТ А: АМИНОГРУППА H2N-CH2- (Углерод C1 и Азот N)
  // Базовый неподвижный фрагмент: панчевый 909-й кик и органическая табла слева
  // --------------------------------------------------------------------------
  s("<[909:0 ~ ~ ~ ~ ~ 909:0 ~]!12 [909:0 ~ ~ ~ 909:0 ~ ~ ~]!40 [909:0 ~ ~ ~]!12>")
    .pan(0.35)
    .gain(0.92),

  // Органический азот аминогруппы (глубокий отклик таблы tabla:2):
  s("<[~ ~ ~ ~ tabla:2 ~ ~ ~]!12 [~ ~ ~ ~ tabla:2 ~ ~ ~]!40 [~ ~ ~ ~ tabla:2 ~ ~ ~]!12>")
    .hpf(300)
    .pan(0.3)
    .gain(0.85),

  // --------------------------------------------------------------------------
  // ФРАГМЕНТ Б: КАРБОКСИЛЬНАЯ ГРУППА -COOH (Приближающийся атом)
  // Глубокий 808-й суб-кик (808bd:2) и теплый 808-й снэр (808sd:1):
  // 8 витков сближения: панорама восьмеркой, раскрытие LPF, сжатие рассинхрона
  // --------------------------------------------------------------------------
  s("<~!4 [~ ~ ~ ~ ~ ~ ~ 808bd:2] [~ ~ ~ ~ ~ 808bd:2 ~ ~] [~ ~ 808bd:2 ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ 808bd:2 ~] [~ ~ ~ 808bd:2 ~ ~ ~ ~] [~ 808bd:2 ~ ~ ~ ~ 808bd:2 ~] [~ ~ 808bd:2 ~ ~ ~ 808bd:2 ~] [~ 808bd:2 ~ ~ 808bd:2 ~ ~ ~] [~ ~ ~ ~ 808bd:2 ~ ~ 808bd:2]!40 [~ ~ ~ ~ 808bd:2 ~ ~ ~]!12>")
    .pan("<0.95 0.1 0.85 0.2 0.75 0.3 0.6 0.5 0.5!40 0.5!12>")
    .lpf("<300 450 700 1100 1800 2800 4500 8000 8000!40 1200!12>")
    .room("<0.9 0.85 0.75 0.65 0.5 0.4 0.3 0.2 0.25!40 0.7!12>")
    .gain("<0.25 0.35 0.48 0.6 0.72 0.82 0.9 0.95 0.92!40 0.4!12>")
    .delay("<0.6 0.5 0.4 0.3 0.2 0.1 0.05 0 0!40 0!12>")
    .delaytime("<0.08 0.06 0.04 0.03 0.02 0.01 0.005 0 0!40 0!12>"),

  // Снэр карбоксильного кислорода C=O (808sd:1):
  s("<~!4 ~ [~ ~ ~ ~ ~ ~ ~ 808sd:1] ~ [~ ~ ~ ~ ~ 808sd:1 ~ ~] ~ [~ ~ ~ ~ ~ 808sd:1 ~ 808sd:1] [~ ~ ~ ~ 808sd:1 ~ ~ ~] [~ ~ ~ ~ 808sd:1 ~ ~ ~]!40 ~!12>")
    .pan("<0.95 0.1 0.85 0.2 0.75 0.3 0.6 0.5 0.65!40 0.5!12>")
    .lpf("<350 500 800 1400 2200 3500 6000 8000 7000!40 1000!12>")
    .room("<0.9 0.85 0.75 0.65 0.5 0.4 0.3 0.2 0.3!40 0.7!12>")
    .gain("<0.2 0.3 0.42 0.55 0.68 0.78 0.85 0.88 0.82!40 0!12>"),

  // --------------------------------------------------------------------------
  // МИКРО-СОУДАРЕНИЯ В ПУСТОТЕ: СЭМПЛ PEBBLES (Минеральные микро-столкновения)
  // --------------------------------------------------------------------------
  s("<[pebbles:1(5,16)]!12 [pebbles:2(7,16)]!40 [pebbles:0(3,16)]!12>")
    .hpf(2500)
    .pan("<0.1 0.9 0.3 0.7 0.5>")
    .gain("<0.3!4 0.45!8 0.52!40 0.2!12>"),

  // --------------------------------------------------------------------------
  // МОМЕНТ СОЕДИНЕНИЯ: КОВАЛЕНТНАЯ СВЯЗЬ C-C (Вспышка на такте 12)
  // Роскошный космический щелчок: future:1 + industrial:4
  // --------------------------------------------------------------------------
  s("<~!12 [future:1, industrial:4]!1 ~!51>")
    .hpf(800)
    .crush(4)
    .distort(0.35)
    .room(0.7).size(0.85)
    .gain(0.95),

  // --------------------------------------------------------------------------
  // ГЛАВНАЯ МЕЛОДИЯ ЛИДА: ЛЕГЕНДАРНЫЙ СИНТЕЗАТОР MOOG (Сэмпл moog!)
  // Жирный, поющий, аналоговый тон Боба Муга с переливами фильтра в A Minor
  // --------------------------------------------------------------------------
  note("<[~ 4 ~ [2 3]] [4 ~ 0 ~]  [5 ~ 4 3] [2 ~ 1 ~]  [2 ~ 3 4] [6 ~ 4 ~]  [5 ~ 4 3] [2 4 1 0]>".scale("a2:minor"))
    .s("moog")
    .decay(0.38).sustain(0.4)
    .lpf(leadCutoff)
    .lpq(2.5)
    .delay(0.42).delaytime(3/16).delayfeedback(0.5)
    .jux(rev)
    .room(0.5).size(0.8)
    .gain("<0!12 0.85!40 0.35!12>"),

  // --------------------------------------------------------------------------
  // ДЫШАЩЕЕ АРПЕДЖИО: ЗНАМЕНИТЫЙ ПЛАК ARPY (Сэмпл arpy!)
  // 4 выразительных 1/8 шага с паузами и вероятностями, мягко покачивающиеся в стерео
  // --------------------------------------------------------------------------
  note("<[0 ~ 2?0.6 ~ 4 ~ 6?0.7 ~] [~ 1 ~ 3?0.6 ~ 4 ~ 7] [7 ~ 5?0.7 ~ 4 ~ 2 ~] [~ 0 ~ 2?0.6 ~ 4 ~ 6]>".scale("a3:minor"))
    .s("arpy")
    .lpf(arpCutoff)
    .pan("<0.25!2 0.75!2 0.35!2 0.65!2 0.5!4>") // Движение по стереопанораме
    .delay(0.38).delaytime(2/16).delayfeedback(0.5)
    .jux(rev)
    .gain("<0!4 0.38!8 0.72!40 0.3!12>"),

  // --------------------------------------------------------------------------
  // ГЛУБОКИЙ ТЕПЛЫЙ БАС: ROLAND JUNO BASS (Сэмпл jvbass!)
  // Плотный, упругий аналоговый локомотив бас-машины Juno
  // --------------------------------------------------------------------------
  note("<[~ a1*3]!2 [~ c2*3]!2 [~ d2*3]!2 [~ e2*3]!2>")
    .s("jvbass")
    .decay(0.24).sustain(0.12)
    .lpf(bassCutoff)
    .lpq(3)
    .distort(0.2)
    .pan(0.5)
    .gain("<0!12 0.88!40 0.35!12>"),

  // Фундаментальный саб-синус (40-55 Гц) под басом Juno
  note("<a1!2 c2!2 d2!2 e2!2>")
    .s("sine")
    .decay(0.3).sustain(0.2)
    .lpf(90)
    .gain("<0!12 0.92!40 0.4!12>"),

  // --------------------------------------------------------------------------
  // 5 ВОДОРОДОВ (H5 — 16-дольный шелест хэтов)
  // --------------------------------------------------------------------------
  s("<~!12 [hh*16]!40 [hh*8]!12>")
    .gain("<[0.2 0.6 0.35 0.7 0.25 0.65 0.4 0.75]*2>")
    .hpf(3500)
    .pan(0.4)
    .gain("<0!12 0.65!40 0.25!12>"),

  // --------------------------------------------------------------------------
  // ПЕРВОБЫТНЫЙ ОКЕАН: ОРГАНИЧЕСКАЯ ЖИДКОСТЬ (Сэмпл water:0)
  // Нежное дыхание водной среды, в которой зародилась жизнь и аминокислоты
  // --------------------------------------------------------------------------
  s("water:0/4")
    .lpf(1400)
    .pan("<0.3 0.7 0.4 0.6>")
    .gain("<0.18!12 0.25!40 0.15!12>"),

  // --------------------------------------------------------------------------
  // РЕЛАКСАЦИОННЫЙ ПЭД (Cmaj9 - Am9 - Fmaj7#11 - Em7)
  // --------------------------------------------------------------------------
  note("<[c3,e3,g3,b3,d4] [a2,c3,e3,g3,b3] [f2,a2,c3,e3,g3] [e2,g2,b2,d3,f#3]>")
    .s("sine")
    .attack(0.5).release(0.9)
    .lpf("<400!4 800!8 1400!40 500!12>")
    .room(0.8).size(0.85)
    .gain("<0.3!4 0.45!8 0.55!40 0.25!12>"),

  // --------------------------------------------------------------------------
  // КИСЛОРОДНЫЙ ХРУСТАЛЬ: КОСМИЧЕСКИЙ ВИБРАФОН (Сэмпл sprvibe!)
  // Искристый, парящий колокольчик в конце фразы
  // --------------------------------------------------------------------------
  note("<[~ ~ ~ [e5,b5]] [~ ~ ~ [f5,c6]] [~ ~ ~ [g5,d6]] [~ ~ ~ [a5,e6]]>")
    .s("sprvibe")
    .attack(0.02).decay(0.4)
    .lpf(2200)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain("<0!12 0.35!40 0.18!12>")
)
