// ============================================================================
// GLYCINE (NCC(=O)O) — INTERACTIVE DISTANCE & APPROACH LIVE DECK (124 BPM)
// Interactive Slider: Move the "dist" slider to physically move the second atom!
// dist = 1.0 -> Atom is far away in deep space (muffled, quiet, cavernous, panned, delayed)
// dist = 0.0 -> Atom has bonded into the united Glycine molecule!
// ============================================================================

setcps(124 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// ИНТЕРАКТИВНЫЙ СЛАЙДЕР РАССТОЯНИЯ МЕЖДУ АТОМАМИ:
// Потяните ползунок dist влево (к 0), чтобы сблизить атомы и соединить их в молекулу!
// ----------------------------------------------------------------------------
const dist = slider(0.0, 0, 1, 0.01) // 1.0 = далеко, 0.0 = ковалентная связь!

stack(
  // --------------------------------------------------------------------------
  // АТОМ / ФРАГМЕНТ А: АМИНОГРУППА H2N-CH2- (Углерод C1 и Азот N)
  // Базовый неподвижный фрагмент (кик и рим)
  // --------------------------------------------------------------------------
  s("bd:3 ~ ~ ~ [bd:3 ~]?0.5 ~ ~ ~")
    .pan(0.35)
    .gain(0.92),

  s("~ ~ ~ ~ rim ~ ~ ~")
    .hpf(600)
    .pan(0.3)
    .gain(0.75),

  // --------------------------------------------------------------------------
  // АТОМ / ФРАГМЕНТ Б: КАРБОКСИЛЬНАЯ ГРУППА -COOH (Приближающийся атом)
  // Все физические параметры привязаны к слайдеру dist:
  // - Панорама: от 0.95 (справа) до 0.5 (центр)
  // - Срез частот: от 400 Гц (глухой) до 8000 Гц (яркий)
  // - Пространство: от 0.9 (далекая пещера) до 0.2 (передний план)
  // - Рассинхрон задержки: от 0.08с (рассинхронизирован) до 0с (слияние фаз)
  // --------------------------------------------------------------------------
  s("~ ~ bd:4 ~ ~ ~ bd:4 ~")
    .pan(0.5 + dist * 0.45)
    .lpf(8000 - dist * 7500)
    .room(0.2 + dist * 0.7).size(0.8)
    .gain(0.95 - dist * 0.65)
    .delay(dist * 0.7)
    .delaytime(dist * 0.08),

  s("~ ~ ~ ~ cp ~ ~ ~")
    .pan(0.5 + dist * 0.45)
    .lpf(8000 - dist * 7400)
    .room(0.25 + dist * 0.65)
    .gain(0.85 - dist * 0.6)
    .delay(dist * 0.7)
    .delaytime(dist * 0.08),

  // --------------------------------------------------------------------------
  // 5 ВОДОРОДОВ (H5 — 16-дольный роллинг):
  // Громкость растет по мере уменьшения расстояния (полноценно звучит при слиянии)
  // --------------------------------------------------------------------------
  s("hh*16")
    .gain("<[0.2 0.6 0.35 0.7 0.25 0.65 0.4 0.75]*2>")
    .hpf(3500)
    .pan(0.4)
    .gain(0.65 - dist * 0.45),

  // --------------------------------------------------------------------------
  // КИСЛОРОДНЫЙ ХРУСТАЛЬНЫЙ АРПЕДЖИО (C Lydian / A Minor):
  // Просыпается и раскрывается, когда атомы соединены (dist -> 0)
  // --------------------------------------------------------------------------
  s("triangle*2")
    .note("<[0 4 7 11 12 14 16 14] [2 6 9 12 14 16 18 16] [4 7 11 14 16 18 19 18] [0 2 4 7 11 12 14 12]>".scale("c4:lydian"))
    .decay(0.12).sustain(0)
    .lpf(5500 - dist * 4500)
    .lpq(2.5)
    .delay(0.38).delaytime(3/16).delayfeedback(0.52)
    .jux(rev)
    .gain(0.72 - dist * 0.5),

  // --------------------------------------------------------------------------
  // ГЛУБОКИЙ ТЕПЛЫЙ БАС ГЛИЦИНА:
  // --------------------------------------------------------------------------
  s("[~ saw*3]*2")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.2).sustain(0.1)
    .lpf(600 - dist * 400)
    .lpq(3)
    .distort(0.25)
    .pan(0.5)
    .gain(0.88 - dist * 0.6),

  s("sine*2")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.3).sustain(0.2)
    .lpf(90)
    .gain(0.92 - dist * 0.6),

  // --------------------------------------------------------------------------
  // АТМОСФЕРНЫЙ РЕЛАКСАЦИОННЫЙ ПЭД (Cmaj9 - Am9 - Fmaj7#11 - Em7)
  // --------------------------------------------------------------------------
  s("sine")
    .note("<[c3,e3,g3,b3,d4] [a2,c3,e3,g3,b3] [f2,a2,c3,e3,g3] [e2,g2,b2,d3,f#3]>")
    .attack(0.5).release(0.9)
    .lpf(1600 - dist * 1000)
    .room(0.75).size(0.85)
    .gain(0.52)
)
