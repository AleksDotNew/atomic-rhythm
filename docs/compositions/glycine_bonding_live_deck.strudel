// ============================================================================
// GLYCINE (NCC(=O)O) — INTERACTIVE DISTANCE & APPROACH LIVE DECK (124 BPM)
// Interactive Slider: Move the "dist" slider to physically move the second atom!
// FEATURING: Memorable Lead Hook, Breathing 8th-note Arpeggio with pauses!
// dist = 1.0 -> Atom is far away in deep space (muffled, quiet, cavernous, panned, delayed)
// dist = 0.0 -> Atom has bonded into the united Glycine molecule!
// ============================================================================

setcps(124 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// ИНТЕРАКТИВНЫЙ СЛАЙДЕР РАССТОЯНИЯ МЕЖДУ АТОМАМИ:
// Потяните ползунок dist влево (к 0), чтобы сблизить атомы и соединить их в молекулу!
// ----------------------------------------------------------------------------
const dist = slider(0.0, 0, 1, 0.01) // 1.0 = далеко, 0.0 = ковалентная связь!

stack(
  // --------------------------------------------------------------------------
  // АТОМ А: АМИНОГРУППА H2N-CH2- (Углерод C1 и Азот N)
  // --------------------------------------------------------------------------
  s("bd:3 ~ ~ ~ [bd:3 ~]?0.5 ~ ~ ~")
    .pan(0.35)
    .gain(0.92),

  s("~ ~ ~ ~ rim ~ ~ ~")
    .hpf(600)
    .pan(0.3)
    .gain(0.75),

  // --------------------------------------------------------------------------
  // АТОМ Б: КАРБОКСИЛЬНАЯ ГРУППА -COOH (Приближающийся атом)
  // --------------------------------------------------------------------------
  s("~ ~ bd:4 ~ ~ ~ bd:4 ~")
    .pan(0.5 + dist * 0.45)
    .lpf(8000 - dist * 7500)
    .room(0.2 + dist * 0.7).size(0.8)
    .gain(0.95 - dist * 0.65)
    .delay(dist * 0.7)
    .delaytime(dist * 0.08),

  s("~ ~ ~ ~ cp ~ ~ ~")
    .pan(0.5 + dist * 0.45)
    .lpf(8000 - dist * 7400)
    .room(0.25 + dist * 0.65)
    .gain(0.85 - dist * 0.6)
    .delay(dist * 0.7)
    .delaytime(dist * 0.08),

  // --------------------------------------------------------------------------
  // УЗНАВАЕМАЯ МЕЛОДИЯ ЛИДА (Glycine Neuro-Tranquil Lead Hook)
  // Раскрывается по мере сближения атомов (dist -> 0)
  // --------------------------------------------------------------------------
  s("saw")
    .note("<[~ 4 ~ [2 3]] [4 ~ 0 ~]  [5 ~ 4 3] [2 ~ 1 ~]  [2 ~ 3 4] [6 ~ 4 ~]  [5 ~ 4 3] [2 4 1 0]>".scale("a4:minor"))
    .attack(0.02).decay(0.35).sustain(0.38).release(0.35)
    .lpf(5500 - dist * 3500)
    .lpq(2.2)
    .delay(0.42).delaytime(3/16).delayfeedback(0.5)
    .jux(rev)
    .room(0.5).size(0.8)
    .gain(0.78 - dist * 0.5),

  // --------------------------------------------------------------------------
  // ДЫШАЩЕЕ АРПЕДЖИО: 4 1/8 НОТЫ С ПАУЗАМИ И ПАНОРАМНОЙ ИГРОЙ
  // --------------------------------------------------------------------------
  s("triangle")
    .note("<[0 ~ 2?0.6 ~ 4 ~ 6?0.7 ~] [~ 1 ~ 3?0.6 ~ 4 ~ 7] [7 ~ 5?0.7 ~ 4 ~ 2 ~] [~ 0 ~ 2?0.6 ~ 4 ~ 6]>".scale("a3:minor"))
    .decay(0.18).sustain(0)
    .lpf(4500 - dist * 3000)
    .lpq(2.2)
    .pan("<0.25!2 0.75!2 0.35!2 0.65!2 0.5!4>")
    .delay(0.38).delaytime(2/16).delayfeedback(0.5)
    .jux(rev)
    .gain(0.7 - dist * 0.45),

  // --------------------------------------------------------------------------
  // 5 ВОДОРОДОВ (H5 — 16-дольный роллинг)
  // --------------------------------------------------------------------------
  s("hh*16")
    .gain("<[0.2 0.6 0.35 0.7 0.25 0.65 0.4 0.75]*2>")
    .hpf(3500)
    .pan(0.4)
    .gain(0.65 - dist * 0.45),

  // --------------------------------------------------------------------------
  // ГЛУБОКИЙ ТЕПЛЫЙ БАС ГЛИЦИНА:
  // --------------------------------------------------------------------------
  s("[~ saw*3]*2")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.2).sustain(0.1)
    .lpf(600 - dist * 400)
    .lpq(3)
    .distort(0.22)
    .pan(0.5)
    .gain(0.88 - dist * 0.6),

  s("sine*2")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.3).sustain(0.2)
    .lpf(90)
    .gain(0.92 - dist * 0.6),

  // --------------------------------------------------------------------------
  // АТМОСФЕРНЫЙ РЕЛАКСАЦИОННЫЙ ПЭД (Cmaj9 - Am9 - Fmaj7#11 - Em7)
  // --------------------------------------------------------------------------
  s("sine")
    .note("<[c3,e3,g3,b3,d4] [a2,c3,e3,g3,b3] [f2,a2,c3,e3,g3] [e2,g2,b2,d3,f#3]>")
    .attack(0.5).release(0.9)
    .lpf(1600 - dist * 1000)
    .room(0.75).size(0.85)
    .gain(0.52),

  // --------------------------------------------------------------------------
  // ХРУСТАЛЬНЫЙ КОЛОКОЛЬЧИК КИСЛОРОДОВ (-COOH Chime)
  // --------------------------------------------------------------------------
  s("sine")
    .note("<[~ ~ ~ [e6,b6]] [~ ~ ~ [f6,c7]] [~ ~ ~ [g6,d7]] [~ ~ ~ [a6,e7]]>")
    .attack(0.02).decay(0.4).sustain(0)
    .lpf(2000)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain(0.25 - dist * 0.15)
)
