// ============================================================================
// GLYCINE (NCC(=O)O) — INTERACTIVE DISTANCE & APPROACH LIVE DECK (124 BPM)
// Powered by Deep Dirt-Samples: moog, arpy, jvbass, sprvibe, pebbles, water, 808/909, tabla
// Interactive Slider: Move the "dist" slider to physically move the second atom!
// dist = 1.0 -> Atom is far away in deep space (muffled, quiet, cavernous, panned, delayed)
// dist = 0.0 -> Atom has bonded into the united Glycine molecule!
// ============================================================================

setcps(124 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// ИНТЕРАКТИВНЫЙ СЛАЙДЕР РАССТОЯНИЯ МЕЖДУ АТОМАМИ:
// Потяните ползунок dist влево (к 0), чтобы сблизить атомы и соединить их в молекулу!
// ----------------------------------------------------------------------------
const dist = slider(0.0, 0, 1, 0.01) // 1.0 = далеко, 0.0 = ковалентная связь!

stack(
  // --------------------------------------------------------------------------
  // АТОМ А: АМИНОГРУППА H2N-CH2- (Углерод C1 и Азот N)
  // 909-й кик и органическая табла tabla:2 слева
  // --------------------------------------------------------------------------
  s("909:0 ~ ~ ~ [909:0 ~]?0.5 ~ ~ ~")
    .pan(0.35)
    .gain(0.92),

  s("~ ~ ~ ~ tabla:2 ~ ~ ~")
    .hpf(300)
    .pan(0.3)
    .gain(0.85),

  // --------------------------------------------------------------------------
  // АТОМ Б: КАРБОКСИЛЬНАЯ ГРУППА -COOH (Приближающийся атом: 808bd:2 и 808sd:1)
  // Все физические параметры привязаны к слайдеру dist:
  // --------------------------------------------------------------------------
  s("~ ~ 808bd:2 ~ ~ ~ 808bd:2 ~")
    .pan(0.5 + dist * 0.45)
    .lpf(8000 - dist * 7500)
    .room(0.2 + dist * 0.7).size(0.8)
    .gain(0.95 - dist * 0.65)
    .delay(dist * 0.7)
    .delaytime(dist * 0.08),

  s("~ ~ ~ ~ 808sd:1 ~ ~ ~")
    .pan(0.5 + dist * 0.45)
    .lpf(8000 - dist * 7400)
    .room(0.25 + dist * 0.65)
    .gain(0.85 - dist * 0.6)
    .delay(dist * 0.7)
    .delaytime(dist * 0.08),

  // --------------------------------------------------------------------------
  // МИКРО-СОУДАРЕНИЯ В ПУСТОТЕ: СЭМПЛ PEBBLES (Минеральные столкновения)
  // --------------------------------------------------------------------------
  s("pebbles:2(7,16)")
    .hpf(2500)
    .pan("<0.1 0.9 0.3 0.7 0.5>")
    .gain(0.52 - dist * 0.25),

  // --------------------------------------------------------------------------
  // ГЛАВНАЯ МЕЛОДИЯ ЛИДА: ЛЕГЕНДАРНЫЙ СИНТЕЗАТОР MOOG (Сэмпл moog!)
  // Жирный поющий аналоговый тон Боба Муга в A Minor
  // --------------------------------------------------------------------------
  s("moog")
    .note("<[~ 4 ~ [2 3]] [4 ~ 0 ~]  [5 ~ 4 3] [2 ~ 1 ~]  [2 ~ 3 4] [6 ~ 4 ~]  [5 ~ 4 3] [2 4 1 0]>".scale("a2:minor"))
    .decay(0.38).sustain(0.4)
    .lpf(5500 - dist * 3500)
    .lpq(2.2)
    .delay(0.42).delaytime(3/16).delayfeedback(0.5)
    .jux(rev)
    .room(0.5).size(0.8)
    .gain(0.85 - dist * 0.55),

  // --------------------------------------------------------------------------
  // ДЫШАЩЕЕ АРПЕДЖИО: ЗНАМЕНИТЫЙ ПЛАК ARPY (Сэмпл arpy!)
  // 4 1/8 шага с паузами и вероятностями, плавно покачивающиеся в стерео
  // --------------------------------------------------------------------------
  s("arpy")
    .note("<[0 ~ 2?0.6 ~ 4 ~ 6?0.7 ~] [~ 1 ~ 3?0.6 ~ 4 ~ 7] [7 ~ 5?0.7 ~ 4 ~ 2 ~] [~ 0 ~ 2?0.6 ~ 4 ~ 6]>".scale("a3:minor"))
    .lpf(4500 - dist * 2500)
    .pan("<0.25!2 0.75!2 0.35!2 0.65!2 0.5!4>")
    .delay(0.38).delaytime(2/16).delayfeedback(0.5)
    .jux(rev)
    .gain(0.72 - dist * 0.45),

  // --------------------------------------------------------------------------
  // ГЛУБОКИЙ ТЕПЛЫЙ БАС: ROLAND JUNO BASS (Сэмпл jvbass!)
  // --------------------------------------------------------------------------
  s("[~ jvbass*3]*2")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.24).sustain(0.12)
    .lpf(650 - dist * 450)
    .lpq(3)
    .distort(0.2)
    .pan(0.5)
    .gain(0.88 - dist * 0.6),

  // Чистый 40-55 Гц саб-синус
  s("sine*2")
    .note("<a1!2 c2!2 d2!2 e2!2>")
    .decay(0.3).sustain(0.2)
    .lpf(90)
    .gain(0.92 - dist * 0.6),

  // --------------------------------------------------------------------------
  // 5 ВОДОРОДОВ (H5 — 16-дольный роллинг)
  // --------------------------------------------------------------------------
  s("hh*16")
    .gain("<[0.2 0.6 0.35 0.7 0.25 0.65 0.4 0.75]*2>")
    .hpf(3500)
    .pan(0.4)
    .gain(0.65 - dist * 0.45),

  // --------------------------------------------------------------------------
  // ПЕРВОБЫТНЫЙ ОКЕАН: ОРГАНИЧЕСКАЯ ВОДА (Сэмпл water:0)
  // --------------------------------------------------------------------------
  s("water:0/4")
    .lpf(1400)
    .pan("<0.3 0.7 0.4 0.6>")
    .gain(0.25),

  // --------------------------------------------------------------------------
  // РЕЛАКСАЦИОННЫЙ ПЭД (Cmaj9 - Am9 - Fmaj7#11 - Em7)
  // --------------------------------------------------------------------------
  s("sine")
    .note("<[c3,e3,g3,b3,d4] [a2,c3,e3,g3,b3] [f2,a2,c3,e3,g3] [e2,g2,b2,d3,f#3]>")
    .attack(0.5).release(0.9)
    .lpf(1600 - dist * 1000)
    .room(0.75).size(0.85)
    .gain(0.52),

  // --------------------------------------------------------------------------
  // КИСЛОРОДНЫЙ ХРУСТАЛЬ: КОСМИЧЕСКИЙ ВИБРАФОН (Сэмпл sprvibe!)
  // --------------------------------------------------------------------------
  s("sprvibe")
    .note("<[~ ~ ~ [e5,b5]] [~ ~ ~ [f5,c6]] [~ ~ ~ [g5,d6]] [~ ~ ~ [a5,e6]]>")
    .attack(0.02).decay(0.4)
    .lpf(2200)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain(0.35 - dist * 0.2)
)
