// ============================================================================
// DYNAMITE (NITROGLYCERIN IN DIATOMITE) — POST-ROCK / ESCAPE TO SILENCE (72 BPM)
// Inspired by: Félperc ("Escape to the World of Silence", "Follow the Compass")
// Powered by Dirt-Samples: gretsch (acoustic kit), gtr (clean/ovrd/dist), tink, wind, pebbles, cr
// 
// Chemical Architecture:
// 1. Diatomaceous Earth Matrix (SiO2 / Kieselgur): "The World of Silence" — ancient porous
//    silica shells absorbing volatility, expressed via ambient wind and delicate pebble textures.
// 2. 3-Carbon Glycerol Backbone (C1-C2-C3): 16-bar evolving clean guitar arpeggio with
//    dotted-eighth delay, cascading arpeggios, 9ths, #11s and breathing syncopations.
// 3. 3 Nitrate Tails (-NO3): Melodic, singing counterpoint bassline with octave leaps and slides.
// 4. Stored Chemical Potential: A slow, breathtaking Post-Rock Crescendo from fragile silence
//    into an immense, roaring wall of sound (distorted guitars, crashing cymbals, thunderous toms)
//    that gently dissolves back into stillness.
//
// Key: D Minor / F Major | Meter: Fluid 6/8 triplet feel | Tempo: 72 BPM
// ============================================================================

setcps(72 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// TIMELINE (64 cycles @ 72 BPM, ~3:33):
// Phase 1 (cycles 0-11):  "The Silica Shells" — шелест ветра и диатомита, одинокая чистая гитара
// Phase 2 (cycles 12-23): "The Liquid Heart" — поющий мелодический бас, щеточный снейр, кристальные капли
// Phase 3 (cycles 24-35): "Follow the Compass" — вступает райд, гитара переходит в теплый овердрайв
// Phase 4 (cycles 36-51): "The Latent Cataclysm" — полный Post-Rock Crescendo, стена звука и дисторшна
// Phase 5 (cycles 52-63): "Escape to Silence" — возвращение в тишину, затухающие переборы и ветер
// ----------------------------------------------------------------------------

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: КИЗЕЛЬГУР (ДИАТОМИТ) — ВЕТЕР И КРЕМНИСТЫЙ МИКРО-ШЕЛЕСТ
  // Пористая губка из древних водорослей, дарящая покой нитроглицерину
  // --------------------------------------------------------------------------
  s("wind:3/8")
    .lpf("<1000!12 1400!12 1800!12 2500!16 1000!12>")
    .room(0.9).size(0.95)
    .pan(0.3)
    .gain("<0.25!12 0.15!12 0.08!12 0!16 0.22!12>"),

  // Текстура кремниевого песка диатомита:
  s("<[pebbles:0(3,8)]!12 [pebbles:0(5,16)]!12 [pebbles:0(3,8)]!12 ~!16 [pebbles:0(2,8)]!12>")
    .hpf(3000)
    .pan(0.75)
    .room(0.7)
    .gain("<0.28!12 0.18!12 0.1!12 0!16 0.25!12>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ГЛИЦЕРИНОВЫЙ КАРКАС (C3) — НЕОДНООБРАЗНОЕ ГИТАРНОЕ АРПЕДЖИО
  // 16-тактовый развивающийся цикл: восходящие волны, водопады, ноны, терции и паузы
  // Сэмпл gtr:0 (настоящая чистая электрогитара с ленточным дилеем и ревербом)
  // --------------------------------------------------------------------------
  note("<[d3 a3 f4 e4 a4 f4] [bb2 f3 d4 e4 a4 d4] [f2 c3 a3 e4 g4 a3] [c3 g3 e4 d4 g4 e4] [d3 f3 a3 c4 e4 a4] [bb2 d3 f3 a3 d4 f4] [f2 a2 c3 e4 a4 c5] [c3 g3 c4 d4 e4 g4] [d4 a4 f5 ~ a4 e5] [d5 ~ f5 e5 a5 d5] [c5 a4 e5 ~ g5 a4] [e5 d5 c5 ~ g4 c5] [a4 f4 d4 e4 f4 a4] [bb4 f4 d4 e4 f4 a4] [c5 a4 f4 g4 a4 c5] [d5 c5 g4 e4 d4 c4]>")
    .s("gtr:0")
    .decay(0.4).sustain(0.2)
    .lpf("<2200!12 3200!12 4500!12 6000!16 2400!12>")
    .delay(0.48).delaytime(3/16).delayfeedback(0.65)
    .room(0.75).size(0.85)
    .pan(0.35)
    .gain("<0.85!24 0.6!12 0!16 0.85!12>"),

  // --------------------------------------------------------------------------
  // TRACK 3: НАРАСТАНИЕ ТЕПЛОГО ОВЕРДРАЙВА (gtr:1) — ЭТАП "FOLLOW THE COMPASS"
  // Прорезает микс во 2-й и 3-й четверти трека
  // --------------------------------------------------------------------------
  note("<[d3 a3 f4 e4 a4 f4] [bb2 f3 d4 e4 a4 d4] [f2 c3 a3 e4 g4 a3] [c3 g3 e4 d4 g4 e4] [d3 f3 a3 c4 e4 a4] [bb2 d3 f3 a3 d4 f4] [f2 a2 c3 e4 a4 c5] [c3 g3 c4 d4 e4 g4] [d4 a4 f5 ~ a4 e5] [d5 ~ f5 e5 a5 d5] [c5 a4 e5 ~ g5 a4] [e5 d5 c5 ~ g4 c5] [a4 f4 d4 e4 f4 a4] [bb4 f4 d4 e4 f4 a4] [c5 a4 f4 g4 a4 c5] [d5 c5 g4 e4 d4 c4]>")
    .s("gtr:1")
    .decay(0.35).sustain(0.25)
    .lpf(4200)
    .delay(0.42).delaytime(3/16).delayfeedback(0.6)
    .room(0.65).size(0.8)
    .pan(0.65)
    .gain("<0!24 0.8!12 0!16 0!12>"),

  // --------------------------------------------------------------------------
  // TRACK 4: КАТАКЛИЗМ / СТЕНА ЗВУКА (gtr:2) — ПОЛНЫЙ ДИСТОРШН В КРЕЩЕНДО
  // Перегруженная электрогитара, разрывающая пространство в кульминации
  // --------------------------------------------------------------------------
  note("<[d3 a3 f4 e4 a4 f4] [bb2 f3 d4 e4 a4 d4] [f2 c3 a3 e4 g4 a3] [c3 g3 e4 d4 g4 e4] [d3 f3 a3 c4 e4 a4] [bb2 d3 f3 a3 d4 f4] [f2 a2 c3 e4 a4 c5] [c3 g3 c4 d4 e4 g4] [d4 a4 f5 ~ a4 e5] [d5 ~ f5 e5 a5 d5] [c5 a4 e5 ~ g5 a4] [e5 d5 c5 ~ g4 c5] [a4 f4 d4 e4 f4 a4] [bb4 f4 d4 e4 f4 a4] [c5 a4 f4 g4 a4 c5] [d5 c5 g4 e4 d4 c4]>")
    .s("gtr:2")
    .decay(0.45).sustain(0.35)
    .distort(0.5)
    .lpf(5500)
    .room(0.7).size(0.9)
    .delay(0.38).delaytime(3/16).delayfeedback(0.55)
    .pan(0.5)
    .jux(rev)
    .gain("<0!36 0.9!16 0!12>"),

  // Соло-лид в крещендо (парящая мелодия сквозь дисторшн):
  note("<[a4 ~ c5 ~ d5 ~ e5 ~] [f5 ~ e5 ~ d5 ~ c5 ~] [e5 ~ f5 ~ g5 ~ a5 ~] [g5 ~ f5 ~ e5 ~ d5 ~]>")
    .s("gtr:2")
    .attack(0.05).decay(0.6).sustain(0.5)
    .lpf(4800)
    .delay(0.5).delaytime(3/16).delayfeedback(0.65)
    .room(0.8).size(0.95)
    .pan(0.55)
    .gain("<0!36 0.82!16 0!12>"),

  // --------------------------------------------------------------------------
  // TRACK 5: ТРИ НИТРАТНЫЕ ГРУППЫ (-NO3) — МЕЛОДИЧЕСКИЙ ПОСТ-РОК БАС
  // Поющий контрапункт с октавными прыжками, секундами и терциями (8-тактовый цикл)
  // --------------------------------------------------------------------------
  note("<[d2 ~ a2 ~ f2 ~ [e2 d2]] [bb1 ~ f2 ~ d2 ~ [c2 bb1]] [f1 ~ c2 ~ a2 ~ [g2 f2]] [c2 ~ g2 ~ e2 ~ [d2 c2]] [d2 a2 d3 ~ c3 ~ a2 ~] [bb1 f2 bb2 ~ a2 ~ f2 ~] [f1 c2 f2 ~ e2 ~ c2 ~] [c2 g2 c3 ~ [b2 a2] [g2 e2]]>")
    .s("saw")
    .decay(0.45).sustain(0.35)
    .lpf("<350!12 550!12 750!12 1400!16 380!12>")
    .lpq(2.5)
    .distort("<0.1!12 0.2!12 0.3!12 0.65!16 0.1!12>")
    .room(0.4).size(0.6)
    .pan(0.5)
    .gain("<0!12 0.8!12 0.85!12 0.92!16 0.4!12>"),

  // Фундаментальный саб-бас (40-60 Гц под риффом):
  note("<d1!2 bb0!2 f1!2 c1!2>")
    .s("sine")
    .decay(0.5).sustain(0.4)
    .lpf(95)
    .gain("<0!12 0.75!12 0.82!12 0.9!16 0.3!12>"),

  // --------------------------------------------------------------------------
  // TRACK 6: КРИСТАЛЬНЫЙ ШИММЕР — СЭМПЛ TINK (Хрустальные капли нитроглицерина)
  // Верхние парящие гармоники в 6/8
  // --------------------------------------------------------------------------
  note("<[~ a5 ~ e6] [~ f5 ~ a5] [~ g5 ~ c6] [~ e5 ~ d6] [~ a5 ~ c6] [~ d6 ~ f6] [~ c6 ~ e6] [~ g5 ~ d6]>")
    .s("tink")
    .decay(0.5)
    .lpf(3500)
    .delay(0.5).delaytime(3/16).delayfeedback(0.7)
    .room(0.85).size(0.92)
    .pan("<0.2 0.8 0.3 0.7>")
    .gain("<0!12 0.4!12 0.6!12 0.75!16 0.2!12>"),

  // --------------------------------------------------------------------------
  // TRACK 7: АКУСТИЧЕСКАЯ БАРАБАННАЯ УСТАНОВКА GRETSCH (Сэмплы gretsch)
  // Настоящий живой щеточный снейр, мягкий кик, шепот хай-хэта и райд-тарелки
  // --------------------------------------------------------------------------
  // Мягкий акустический кик (gretsch:13):
  s("<~!16 [gretsch:13 ~ ~ ~ gretsch:13 ~ ~ ~]!8 [gretsch:13 ~ gretsch:13 ~ gretsch:13 ~ ~ ~]!12 [[gretsch:13 ~ gretsch:13 ~] [gretsch:13 ~ ~ gretsch:13]]!16 ~!12>")
    .lpf(3000)
    .room(0.3)
    .gain("<0!16 0.75!8 0.85!12 0.95!16 0!12>"),

  // Щеточный снейр и призрачные ноты (gretsch:2, gretsch:3):
  s("<~!12 [~ gretsch:3 ~ gretsch:2 ~ gretsch:3 gretsch:2 ~]!12 [~ gretsch:2 ~ gretsch:2 ~ gretsch:3 gretsch:2 ~]!12 ~!16 [~ gretsch:3 ~ gretsch:2 ~ ~ ~ ~]!12>")
    .hpf(400)
    .room(0.5).size(0.7)
    .pan(0.45)
    .gain("<0!12 0.65!12 0.75!12 0!16 0.4!12>"),

  // Мощный акустический снейр в крещендо (gretsch:20):
  s("<~!36 [~ gretsch:20 ~ gretsch:20]!16 ~!12>")
    .hpf(250)
    .room(0.65).size(0.85)
    .pan(0.5)
    .gain("<0!36 0.88!16 0!12>"),

  // 16-дольный шелест хэта / райда (gretsch:4, gretsch:19):
  s("<~!12 [gretsch:4*6]!12 [gretsch:19*6]!12 [gretsch:19*6]!16 ~!12>")
    .velocity("<[0.3 0.6 0.4 0.7 0.35 0.65]*2>")
    .hpf(3500)
    .pan(0.65)
    .gain("<0!12 0.55!12 0.7!12 0.82!16 0!12>"),

  // Крэш на начало квадратов в кульминации:
  s("<~!36 [cr ~!3]!16 ~!12>")
    .gain("<0!36 0.75!16 0!12>"),

  // --------------------------------------------------------------------------
  // TRACK 8: КИНЕМАТОГРАФИЧЕСКИЙ ЭМБИЕНТ-ПЭД (Dm9 - Bbmaj7 - Fmaj7 - C)
  // Воздушная текстура бесконечного пространства
  // --------------------------------------------------------------------------
  note("<[d3,a3,f4,c5,e5] [bb2,f3,d4,a4,e5] [f2,c3,a3,e4,g4] [c3,g3,e4,d4,g4]>")
    .s("sine")
    .attack(0.8).release(1.2)
    .lpf("<600!12 1000!12 1600!12 2800!16 800!12>")
    .room(0.88).size(0.95)
    .gain("<0.4!12 0.55!12 0.65!12 0.8!16 0.35!12>")
)
