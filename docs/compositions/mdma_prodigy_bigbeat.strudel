// ============================================================================
// MDMA (3,4-METHYLENEDIOXYMETHAMPHETAMINE, C11H15NO2) — BIG BEAT / RAVE V2 (136 BPM)
// High-energy Big Beat / Rave Rock in the spirit of Liam Howlett & The Prodigy
// Feat: 1/16 Driving Palm-Mute Guitars, Tamed Deep Moog, Soaring Voodoo Rave Hook
//
// Chemical Architecture:
// 1. Benzene Core (C6): Monolithic, swaggering 136 BPM Big Beat groove (gretsch:13 kick & gretsch:20 snare cracks).
// 2. Methylenedioxy Ring (-O-CH2-O- at C3,C4): Tamed, squelching acid 303-style Moog bass riff (moog:0).
// 3. Amphetamine Carbon Tail (-CH2-CH(CH3)-): Relentless 1/16th-note palm-mute punk-rock guitar chug (gtr:2 + saw).
// 4. Secondary Methylamine (-NH-CH3): Soaring, fluid, singable rave synth hook & legendary rave:6 ("prodigyloop")!
// 5. Monoamine Flood (5-HT / DA / NE Surge): Euphoric rave drops, Amen break rolls, reverse cymbals & crash explosions.
//
// Key: F# Minor / F# Dorian | Tempo: 136 BPM
// ============================================================================

// Автономные фоллбэки макросов (код работает автономно, даже если prebake.strudel не загружен):
const chemTempo    = globalThis.chemTempo || ((bpm, temp = 0) => setcps((bpm * (1 + temp / 100)) / 60 / 4));
const subBass      = globalThis.subBass || ((pat, lpf = 95) => note(pat).s("sine").decay(0.5).sustain(0.4).lpf(lpf));
const hydrogenHats = globalThis.hydrogenHats || ((pat = "hh*16", hpf = 3500) => s(pat).velocity("<[0.25 0.75 0.35 0.9 0.25 0.8 0.4 0.95]*2>").hpf(hpf));
const ambientPad   = globalThis.ambientPad || ((chords, lpf = 1200) => note(chords).s("sine").attack(0.8).release(1.2).lpf(lpf).room(0.88).size(0.95));

chemTempo(136)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// TIMELINE (64 cycles @ 136 BPM, ~1:53):
// Phase 1 (cycles 0-7):   Сборка бензольного ядра — Big Beat кик, вкрадчивый Moog-бас
// Phase 2 (cycles 8-15):  Ввод амфетаминового хвоста — Взрывной 1/16 палм-мьют гитарный кач
// Phase 3 (cycles 16-39): ЭЙФОРИЧЕСКИЙ ВСПЛЕСК / RAVE DROP — Парящая мелодия, Amen break, полный рейв
// Phase 4 (cycles 40-47): Брейкдаун — Кик молчит, 1/16 палм-мьют гитара соло с кислотным басом
// Phase 5 (cycles 48-63): МАКСИМАЛЬНЫЙ УДАР (Invaders Must Die) — Максимальный напор, финал
// ----------------------------------------------------------------------------

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: БЕНЗОЛЬНОЕ КОЛЬЦО (C6) — BIG BEAT PUNCH KICK (gretsch:13 + feel:0)
  // Синкопированный классический брейкбит-кик на 1-ю долю и синкопу перед 3-й
  // --------------------------------------------------------------------------
  s("<[gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~]!8 [gretsch:13 ~ ~ ~ gretsch:13 ~ gretsch:13 ~]!8 [gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~]!24 [gretsch:13 ~ ~ ~ ~ ~ ~ ~]!8 [gretsch:13 ~ ~ ~ ~ ~ gretsch:13 ~]!15 [gretsch:13*4]!1>")
    .lpf("<1800!8 3200!8 8000!24 600!8 8000!16>")
    .distort("<0.2!8 0.35!8 0.5!24 0.1!8 0.6!16>")
    .gain("<0.85!8 0.9!8 0.95!24 0!8 0.98!16>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ХЛЕСТКИЙ СНЕЙР THE PRODIGY (gretsch:20 + sd:1 + призрачные дроби)
  // Мощный удар на 2 и 4 долю с легким аналоговым дилеем
  // --------------------------------------------------------------------------
  s("<[~ ~ ~ ~ [gretsch:20,sd:1] ~ ~ ~]!8 [~ ~ ~ ~ [gretsch:20,sd:1] ~ ~ [gretsch:3]?0.6 ~ ~ ~ ~ [gretsch:20,sd:1] ~ ~ ~]!8 [~ ~ ~ ~ [gretsch:20,sd:1] ~ ~ [gretsch:3]?0.6 ~ ~ ~ ~ [gretsch:20,sd:1] ~ ~ ~]!24 ~!8 [~ ~ ~ ~ [gretsch:20,sd:1] ~ ~ [gretsch:3]?0.6 ~ ~ ~ ~ [gretsch:20,sd:1] ~ ~ ~]!15 [gretsch:20*8]!1>")
    .hpf(180)
    .distort(0.35)
    .room(0.25)
    .gain("<0.75!8 0.82!8 0.88!24 0!8 0.92!16>"),

  // --------------------------------------------------------------------------
  // TRACK 3: НАРЕЗКА КУЛЬТОВОГО AMEN BREAK (Сэмпл amencutup)
  // Живая перебивка барабанов, добавляющая фирменную ярость The Prodigy
  // --------------------------------------------------------------------------
  s("<[amencutup:0 amencutup:1 amencutup:2 amencutup:3] [amencutup:4 amencutup:5 amencutup:6 amencutup:7] [amencutup:8 amencutup:9 amencutup:10 amencutup:11] [amencutup:12 amencutup:13 amencutup:14 amencutup:15]>")
    .hpf(300).lpf(6500)
    .pan(0.5)
    .gain("<0!8 0.65!8 0.75!24 0.3!8 0.8!16>"),

  // --------------------------------------------------------------------------
  // TRACK 4: АМФЕТАМИНОВЫЙ ХВОСТ — ПАНК-ГИТАРА 1/16 ПАЛМ-МЬЮТ (The Prodigy / Pendulum)
  // Бешеный 16-дольный палм-мьют кач с акцентами в F# Minor!
  // Слой 1: gtr:2 (перегруз)
  // --------------------------------------------------------------------------
  note("<[f#1*12 a1 f#1 e1 f#1] [f#1*8 b1 f#1 a1 f#1 c2 b1 a1 f#1] [f#1*12 a1 f#1 e1 f#1] [f#1*8 b1 c2 b1 a1 d2 c2 b1 a1]>")
    .s("gtr:2")
    .decay(0.14).sustain(0.15)
    .velocity("<[0.7 0.5 0.6 0.5 0.85 0.5 0.65 0.5 0.7 0.5 0.6 0.5 0.95 0.6 0.8 0.7]>")
    .hpf(160)
    .lpf("<2200!8 4500!8 6500!24 3500!8 7000!16>")
    .room(0.25).size(0.7)
    .pan(0.35)
    .gain("<0!4 0.85!12 0.92!24 0.5!8 0.96!16>"),

  // Слой суб-дисторшна под гитарным палм-мьютом:
  note("<[f#1*12 a1 f#1 e1 f#1] [f#1*8 b1 f#1 a1 f#1 c2 b1 a1 f#1] [f#1*12 a1 f#1 e1 f#1] [f#1*8 b1 c2 b1 a1 d2 c2 b1 a1]>")
    .s("saw")
    .decay(0.12).sustain(0.08)
    .distort(0.75)
    .hpf(120).lpf("<1500!8 2400!8 3200!24 1800!8 3500!16>")
    .lpq(3.2)
    .pan(0.65)
    .gain("<0!4 0.75!12 0.85!24 0.4!8 0.88!16>"),

  // --------------------------------------------------------------------------
  // TRACK 5: МЕТИЛЕНДИОКСИ-КОЛЬЦО — ПРИРУЧЕННЫЙ КИСЛОТНЫЙ БАС (moog:0)
  // Играет в промежутках между долями, не забивая гитары и вокал!
  // --------------------------------------------------------------------------
  note("<[f#1 ~ ~ f#1 ~ ~ a1 ~] [~ f#1 ~ ~ c2 b1 a1 ~] [f#1 ~ ~ f#1 ~ ~ e1 ~] [~ f#1 ~ ~ a1 b1 c2 ~]>")
    .s("moog")
    .decay(0.2).sustain(0.12)
    .lpf("<450!8 650!8 850!24 600!8 900!16>")
    .lpq(3.5)
    .distort(0.3)
    .pan(0.5)
    .gain("<0.68!8 0.72!8 0.75!24 0.6!8 0.78!16>"),

  // Фундаментальный саб-бас (макрос subBass):
  subBass("<f#1!2 a1!2 b1!2 e1!2>")
    .gain("<0.7!8 0.75!8 0.82!24 0.4!8 0.85!16>"),

  // --------------------------------------------------------------------------
  // TRACK 6: ВТОРИЧНЫЙ МЕТИЛАМИН — ПАРЯЩАЯ РЕЙВ-МЕЛОДИЯ (Voodoo / Omen Lead)
  // Плавная, непрерывная, динамичная и запоминающаяся хук-мелодия в F# Minor!
  // --------------------------------------------------------------------------
  note("<[f#4@3 a4@2 b4@3 c#5@3 b4 a4@2 b4@2] [c#5@2 e5@2 c#5@2 b4@2 a4@2 b4@2 f#4@4] [f#4@2 a4@2 b4@2 c#5@2 e5@3 f#5@3 e5@2] [f#5@2 e5@2 c#5@2 b4@2 c#5 b4 a4 f#4 e4@2 f#4@2]>")
    .s("saw")
    .decay(0.42).sustain(0.6)
    .lpf("<1800!16 5200!24 2200!8 6500!16>")
    .lpq(2.8)
    .delay(0.42).delaytime(3/16).delayfeedback(0.6)
    .room(0.55).size(0.85)
    .pan(0.5)
    .jux(rev)
    .gain("<0!16 0.85!24 0!8 0.9!16>"),

  // --------------------------------------------------------------------------
  // TRACK 7: КУЛЬТОВЫЙ РЕЙВ-СЭМПЛ PRODIGYLOOP (rave:6)
  // --------------------------------------------------------------------------
  s("<rave:6 ~!3>")
    .hpf(400)
    .room(0.35)
    .gain("<0!16 0.7!24 0!8 0.75!16>"),

  // --------------------------------------------------------------------------
  // TRACK 8: ВОДОРОДНЫЕ ХЭТЫ (макрос hydrogenHats)
  // --------------------------------------------------------------------------
  hydrogenHats("hh*16", 4000)
    .pan(0.65)
    .gain("<0.5!8 0.65!8 0.75!24 0.3!8 0.78!16>"),

  // Открытый оффбитный хэт:
  s("<~!8 [~ oh ~ oh]!32 ~!8 [~ oh ~ oh]!16>")
    .hpf(3500)
    .decay(0.18)
    .gain("<0!8 0.7!32 0!8 0.75!16>"),

  // --------------------------------------------------------------------------
  // TRACK 9: ИНДУСТРИАЛЬНЫЙ ЛЯЗГ ШЕСТЕРЕНОК (industrial:2, click:0 — БЕЗ ФОНКА)
  // --------------------------------------------------------------------------
  s("<[industrial:2(3,8)] [click:0(7,16)] [industrial:4(3,8)] [click:0(5,16)]>")
    .hpf(1500)
    .pan("<0.3 0.7 0.4 0.6>")
    .gain("<0.3!8 0.45!8 0.55!24 0.25!8 0.6!16>"),

  // --------------------------------------------------------------------------
  // TRACK 10: ДРОП-ВСПЫШКА И КРЭШ (future:1, cr)
  // --------------------------------------------------------------------------
  s("<~!15 [future:1, cr]!1 ~!31 [future:1, cr]!1 ~!16>")
    .hpf(500)
    .crush(5)
    .distort(0.35)
    .room(0.7).size(0.85)
    .gain(0.95),

  // Крэш на начало 8-тактовых квадратов
  s("<cr ~!7>")
    .gain("<0!16 0.65!24 0!8 0.7!16>")
)
