// ============================================================================
// SEROTONIN (C10H12N2O) — CLOCKWORK GEAR TRANCE (138 BPM)
// New Harmony & Melody: F# Minor / F# Dorian (F#m9 - Dmaj7#11 - Bm9 - C#m7)
// FEATURING: Heavy Pendulum-style distorted guitar riff!
// Concept: Mechanical clockwork mechanism where atomic bonds are rotating
// cogs, teeth mesh and collide, sparking emergent arpeggios note-by-note.
// Genre: Melodic Cyberpunk Trance / Industrial Progressive (138 BPM)
// Key: F# Minor (6 semitones higher than D Dorian) | BPM: 138
// ============================================================================

setcps(138 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// ИНТЕРАКТИВНЫЕ РЕГУЛЯТОРЫ (Именованные слайдеры верхнего уровня)
// ----------------------------------------------------------------------------
const bassCutoff = slider(3400, 400, 8000, 50)
const guitarDist = slider(0.78, 0.4, 0.95, 0.02)
const arpCutoff  = slider(2800, 400, 7000, 50)
const sparkGain  = slider(0.58, 0, 0.9, 0.02)

// ============================================================================
// TIMELINE (144 cycles @ 138 BPM, ~4:10):
// Part 1 (cycles 0-39):   СБОРКА МЕХАНИЗМА / СОЕДИНЕНИЕ АТОМОВ
// Part 2 (cycles 40-71):  ПОЛНЫЙ ХОД МЕХАНИЗМА (Full euphoria)
// Part 3 (cycles 72-119): ТЯЖЕЛЫЙ PENDULUM РИФФ В ЦЕНТРЕ ТРЕКА
// Part 4 (cycles 120-143): РАЗБОРКА И ЗАТУХАНИЕ
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 1: ТЯЖЕЛЫЙ УГЛЕРОДНЫЙ МАХОВИК C10 (10 зубцов)
  // В части 1 спит; на такте 32 дает первые толчки; с такта 40 — полный 4x4
  // --------------------------------------------------------------------------
  s("<~!32 [~ bd:4]*2!8 [bd:4*4]!40 [bd:4*4]!40 [bd:4*2]!16 ~!8>")
    .gain(0.95),

  // K-B-B-B Rolling Trance Bass в F# Minor (<f#1 d1 b0 c#1>)
  note("<[~ f#1*3]!4 [~ d1*3]!4 [~ b0*3]!4 [~ c#1*3]!4>")
    .s("saw")
    .decay(0.13).sustain(0.04)
    .lpf(bassCutoff)
    .lpq(3.5)
    .distort(0.3)
    .pan(0.5)
    .gain("<0!40 0.88!80 0.4!16 0!8>"),

  // Чистый саб-бас сердечника (46 Гц тоника F#)
  note("<f#1!4 d1!4 b0!4 c#1!4>")
    .s("sine")
    .decay(0.22).sustain(0.18)
    .lpf(95)
    .gain("<0!40 0.92!80 0.45!16 0!8>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 2A: 12 ВОДОРОДОВ (H12 — Движение по панораме)
  // В части 1 медленно блуждает слева направо
  // --------------------------------------------------------------------------
  s("<[hh*4]!40 [hh*4]!40 [hh*4]!40 [hh*4]!16 ~!8>")
    .hpf(4000)
    .pan("<0.1!8 0.3!8 0.6!8 0.85!8 0.5!8 0.25!80 0.5!24>")
    .gain("<0.35!40 0.48!40 0.52!40 0.25!16 0!8>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 2B: ЭМЕРДЖЕНТНОЕ ОБЛАКО ЭЛЕКТРОНОВ (Интерференция через 3/16 эхо)
  // Движется в противофазе по панораме навстречу водородам!
  // --------------------------------------------------------------------------
  s("<[click*4]!40 [click*4]!40 [click*4]!40 [click*4]!16 ~!8>")
    .hpf(4500)
    .crush(6)
    .delay(0.75).delaytime(3/16).delayfeedback(0.68)
    .pan("<0.9!8 0.7!8 0.4!8 0.15!8 0.5!8 0.75!80 0.5!24>")
    .gain("<0.3!40 0.45!40 0.48!40 0.2!16 0!8>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 3: ПИРРОЛЬНОЕ КОЛЬЦО (5 зубцов: сближение из крайнего левого канала)
  // Движется от pan 0.05 к центру
  // --------------------------------------------------------------------------
  s("<~!8 rim(5,16)!8 rim(5,16,1)!8 rim(5,16,2)!8 rim(5,16,3)!8 [rim(5,16) rim(5,16,1) rim(5,16,2) rim(5,16,3) rim(5,16,4)]!80 rim(5,16)!24>")
    .hpf(700)
    .pan("<0.05!8 0.1!8 0.15!8 0.2!8 0.25!112>")
    .delay(0.4).delaytime(2/16)
    .gain("<0!8 0.55!32 0.72!80 0.3!24>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 4: БЕНЗОЛЬНОЕ КОЛЬЦО (Мягкий полый резонатор can:1 вместо резкого металла)
  // --------------------------------------------------------------------------
  s("<~!8 can:1(6,16)!8 can:1(6,16,2)!8 can:1(6,16,4)!8 can:1(6,16,1)!8 [can:1(6,16) can:1(6,16,2) can:1(6,16,4) can:1(6,16,1) can:1(6,16,3)]!80 can:1(6,16)!24>")
    .hpf(500).lpf(2200)
    .pan("<0.95!8 0.9!8 0.85!8 0.8!8 0.75!112>")
    .delay(0.35).delaytime(3/16).delayfeedback(0.4)
    .gain("<0!8 0.4!32 0.52!80 0.22!24>"),

  // --------------------------------------------------------------------------
  // COLLISION ENGINE: ИСКРЫ ПРИ СОПРИКОСНОВЕНИИ ЗУБЦОВ / КОВАЛЕНТНОЙ СВЯЗИ
  // В части 1 высекаются редкие искры на стыках шестерен, с 40-го такта — фейерверк
  // --------------------------------------------------------------------------
  s("<~!12 [industrial:4(3,16)]!12 [industrial:4(5,16,2)]!16 [industrial:4(11,16) industrial:4(11,16,3) industrial:4(11,16,6) industrial:4(11,16,2)]!80 industrial:4(3,16)!24>")
    .hpf(1200)
    .crush(5)
    .distort(0.32)
    .pan("<0.2 0.8 0.35 0.65 0.5 0.85>")
    .gain(sparkGain),

  // --------------------------------------------------------------------------
  // РОЖДЕНИЕ АРПЕДЖИО ИЗ СОПРИКОСНОВЕНИЯ ШЕСТЕРЕНОК (Emergent Crystallization)
  // 0-7: тишина
  // 8-15: 1-я нота F#4 [0]
  // 16-23: квинта F#4, C#5 [0 4]
  // 24-31: трезвучие F#4, C#5, G#5 [0 4 8]
  // 32-39: 5-нотный аккорд F#m9 [[0 ~ 2 ~] [4 ~ 6 ~] [8 ~ ~ ~]]
  // 40+: ПОЛНОЕ 16-ДОЛЬНОЕ КАСКАДНОЕ ВОДОПАДНОЕ АРПЕДЖИО!
  // --------------------------------------------------------------------------
  note("<[~]!8 [~ ~ 0 ~]!8 [~ [0 4] ~ ~]!8 [[~ 0] [~ 4] [~ 8] ~]!8 [[0 ~ 2 ~] [4 ~ 6 ~] [8 ~ ~ ~]]!8 [0 4 7 11 2 6 9 12 4 7 11 14 7 11 14 16]!20 [14 11 7 4 12 9 6 2 11 7 4 0 9 6 4 2]!20 [0 7 12 7 2 9 14 9 4 11 16 11 6 12 18 12]!20 [7 11 9 6 4 7 6 2 0 4 2 1 0 2 4 7]!20 [0 4 7 11]!24>".scale("f#4:minor"))
    .s("triangle")
    .decay("<0.25!40 0.09!80 0.18!24>").sustain(0)
    .lpf(arpCutoff)
    .lpq(2.5)
    .delay(0.42).delaytime(2/16).delayfeedback(0.55)
    .jux(rev)
    .gain("<0!8 0.45!8 0.5!8 0.55!8 0.6!8 0.75!80 0.35!24>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 7: ГЛАВНАЯ МЕЛОДИЯ (F# Minor Celestial Lead)
  // Парящая тема курантов: F#4 -> C#5 -> E5 -> F#5 -> G#5 -> A5
  // Звучит в кульминации (с такта 80)
  // --------------------------------------------------------------------------
  note("<[~ 4 ~ [6 7]] [8 ~ 7 ~]  [9 ~ 8 7] [6 ~ 4 ~]  [5 ~ 4 3] [4 ~ 2 ~]  [1 ~ 2 3] [4 6 8 7]>".scale("f#4:minor"))
    .s("saw")
    .attack(0.02).decay(0.32).sustain(0.4).release(0.35)
    .lpf(3400)
    .lpq(2.2)
    .delay(0.45).delaytime(3/16).delayfeedback(0.52)
    .jux(rev)
    .room(0.5).size(0.75)
    .gain("<0!80 0.8!40 0.35!16 0!8>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 9: ТЯЖЕЛЫЙ ГИТАРНЫЙ РИФФ В СТИЛЕ PENDULUM (Rob Swire Drop)
  // Врывается в середине трека (такты 72-119): перегруженные drop-чаги и пауэр-аккорды!
  // Dug-dug-dug... dug-dug-dug... DAH! DAH! в духе Showdown / Self vs Self
  // --------------------------------------------------------------------------
  note("<[f#1!3 ~ f#1!3 ~] [f#1 f#1 [a1,e2] ~]  [f#1!3 ~ f#1!3 ~] [[d1,a1] ~ [c#1,g#1] ~]  [f#1!3 ~ f#1!3 ~] [f#1 f#1 [b1,f#2] ~]  [f#1!2 a1!2 b1!2 c#2!2] [[d2,a2]!2 [c#2,g#2]!2]>")
    .s("saw")
    .attack(0.005).decay(0.14).sustain(0.12).release(0.05)
    .lpf(2600) // Эмуляция кабинета Marshall/Mesa Boogie
    .lpq(4)
    .hpf(120)  // Срез саб-мусора
    .distort(guitarDist) // Высокогейновый дисторшн
    .jux(rev)  // Дабл-трекинг по стереопанораме (стена звука)
    .gain("<0!72 0.85!48 0!24>"),

  // --------------------------------------------------------------------------
  // РЕЗОНАТОРНЫЙ КОРПУС: ТЕПЛЫЙ ПЭД (F#m9 - Dmaj7#11 - Bm9 - C#m7)
  // --------------------------------------------------------------------------
  note("<[f#3,a3,c#4,e4,g#4] [d3,f#3,a3,c#4,g#4] [b2,d3,f#3,a3,c#4] [c#3,e3,g#3,b3,d#4]>")
    .s("sine")
    .attack(0.4).release(0.9)
    .lpf("<600!16 1000!24 1600!40 2200!40 1000!24>")
    .room(0.75).size(0.85)
    .gain("<0.2!16 0.4!24 0.52!40 0.55!40 0.25!24>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 8: ХРУСТАЛЬНЫЙ КОЛОКОЛЬЧИК (5-OH Кислород в F# Minor)
  // --------------------------------------------------------------------------
  note("<[~ ~ ~ [f#6,c#7]] [~ ~ ~ [g#6,d7]] [~ ~ ~ [a6,e7]] [~ ~ ~ [b6,f#7]]>")
    .s("sine")
    .attack(0.02).decay(0.38).sustain(0)
    .lpf(1800)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain("<0!40 0.22!40 0.28!40 0.12!16 0!8>"),

  // --------------------------------------------------------------------------
  // ВЫПУСК ПАРА / СИНКОПИРОВАННЫЙ ОФФБИТ-ХЭТ
  // --------------------------------------------------------------------------
  s("<~!40 [~ oh]*4!40 [~ oh]*4!40 ~!24>")
    .hpf(1800)
    .gain("<0!40 0.68!40 0.72!40 0!24>")
)
