// ============================================================================
// SEROTONIN (NCCc1c[nH]c2ccc(O)cc12) — CLOCKWORK GEAR TRANCE (138 BPM)
// Concept: Molecular Clockwork Mechanism — every atom is a gear; rotating teeth
// collide and mesh to produce emergent rhythmic sparks and harmonic interference.
// Interactive UI Sliders enabled for live mechanical manipulation!
// ============================================================================

// ----------------------------------------------------------------------------
// 1. MASTER CLOCKWORK SLIDERS (Управление механической машиной):
// ----------------------------------------------------------------------------
const bpm        = slider(138, 110, 160, 1)    // 1. Скорость вращения шестерен (BPM)
const cutoff     = slider(3400, 400, 8000, 50) // 2. Резонансный срез фильтра (Гц)
const res        = slider(3.5, 1, 10, 0.1)     // 3. Звон зубцов (Resonance Q)
const friction   = slider(0.32, 0, 0.8, 0.02)  // 4. Трение и сатурация шестерен
const toothEcho  = slider(0.68, 0.1, 0.88, 0.01)// 5. Эхо-интерференция зубцов (Delay Feedback)
const sparkGain  = slider(0.58, 0, 0.9, 0.02)  // 6. Громкость искр столкновения зубцов
const bassDrive  = slider(0.88, 0, 1.2, 0.02)  // 7. Мощность углеродного маховика (Bass Gain)

setcps(bpm / 60 / 4)
samples('github:tidalcycles/dirt-samples')

stack(
  // --------------------------------------------------------------------------
  // GEAR 1: ТЯЖЕЛЫЙ УГЛЕРОДНЫЙ МАХОВИК C10 (10-зубчатый маховик)
  // Прямой 4-on-the-floor импульс хода часов
  // --------------------------------------------------------------------------
  s("bd:4*4")
    .gain(0.95),

  // K-B-B-B Rolling Trance Bass: передача вращения от маховика к шестерням
  s("[~ saw*3]*4")
    .note("<d1!4 f1!4 g1!4 eb1!4>")
    .decay(0.13).sustain(0.04)
    .lpf(cutoff)
    .lpq(res)
    .distort(friction)
    .pan(0.5)
    .gain(bassDrive),

  // Чистый саб-тон сердечника (45 Гц)
  s("sine*4")
    .note("<d1!4 f1!4 g1!4 eb1!4>")
    .decay(0.22).sustain(0.18)
    .lpf(95)
    .gain(0.92),

  // --------------------------------------------------------------------------
  // GEAR 2A: 12 ВОДОРОДОВ (H12 — 12-зубчатый храповик, сухой импульс)
  // 4 ровных четвертных тика храповика в левом канале
  // --------------------------------------------------------------------------
  s("hh*4")
    .hpf(4000)
    .pan(0.25)
    .gain(0.48),

  // --------------------------------------------------------------------------
  // GEAR 2B: ЭМЕРДЖЕНТНОЕ ОБЛАКО ЭЛЕКТРОНОВ (Интерференция зубцов через 3/16 эхо)
  // 4 тика + 3/16 эхо в правом канале рождают плотную 16-дольную сеть тиканья!
  // --------------------------------------------------------------------------
  s("click*4")
    .hpf(4500)
    .crush(6)
    .delay(0.75).delaytime(3/16).delayfeedback(toothEcho)
    .pan(0.75)
    .gain(0.46),

  // --------------------------------------------------------------------------
  // GEAR 3: ПИРРОЛЬНОЕ КОЛЬЦО (5-зубчатая латунная шестерня: вращение со сдвигом)
  // Шаг вращения зубцов: каждый такт шестерня поворачивается на 1 зубец <0 1 2 3 4>
  // --------------------------------------------------------------------------
  s("rim(5, 16, <0 1 2 3 4>)")
    .hpf(700)
    .pan(0.2)
    .delay(0.4).delaytime(2/16)
    .gain(0.72),

  // --------------------------------------------------------------------------
  // GEAR 4: БЕНЗОЛЬНОЕ КОЛЬЦО (6-зубчатая стальная шестерня: дифференциальный сдвиг)
  // Шаг вращения зубцов: <0 2 4 1 3 5> — вращается с другой угловой скоростью!
  // --------------------------------------------------------------------------
  s("metal:2(6, 16, <0 2 4 1 3 5>)")
    .hpf(900).lpf(3600)
    .pan(0.8)
    .delay(0.4).delaytime(3/16)
    .gain(0.56),

  // --------------------------------------------------------------------------
  // GEAR 5: ЭКСЦЕНТРИКОВЫЙ СПУСК АЗОТА N7 (7-зубчатый бронзовый анкер)
  // Смещенный 7-дольный спусковой механизм
  // --------------------------------------------------------------------------
  s("tok(7, 16, <0 3 1 4 2 5>)")
    .hpf(800)
    .pan(0.35)
    .gain(0.62),

  // --------------------------------------------------------------------------
  // COLLISION ENGINE: ИСКРЫ ПРИ СТОЛКНОВЕНИИ ЗУБЦОВ (Механическое пересечение)
  // При взаимном пересечении зубцов 5-й, 6-й и 7-й шестерен высекаются металлические искры!
  // --------------------------------------------------------------------------
  s("industrial:4(11, 16, <0 3 6 2 5 1>)")
    .hpf(1200)
    .crush(5)
    .distort(friction)
    .pan(rand)
    .gain(sparkGain),

  // --------------------------------------------------------------------------
  // GEAR 6: МЕХАНИЧЕСКИЙ ДИФФЕРЕНЦИАЛ АРПЕДЖИО (Каскадная зубчатая гребенка)
  // 4 эволюционирующих контура: терции, водопад, октавы и разворот шестерен
  // --------------------------------------------------------------------------
  s("triangle*2")
    .note("<[0 4 7 11 2 6 9 12 4 7 11 14 7 11 14 16] [14 11 7 4 12 9 6 2 11 7 4 0 9 6 4 2] [0 7 12 7 2 9 14 9 4 11 16 11 6 12 18 12] [7 11 9 6 4 7 6 2 0 4 2 1 0 2 4 7]>".scale("d4:dorian"))
    .decay(0.09).sustain(0)
    .lpf(cutoff)
    .lpq(res)
    .delay(0.42).delaytime(2/16).delayfeedback(toothEcho)
    .jux(rev)
    .gain("<[0.55 0.35 0.5 0.4]*4>")
    .gain(0.72),

  // --------------------------------------------------------------------------
  // GEAR 7: КУРАНТЫ / ПАРЯЩИЙ МЕЛОДИЧЕСКИЙ ЛИД (Главная тема механизма)
  // Узнаваемый гипнотический хук в D Dorian с объемным пространственным дилеем
  // --------------------------------------------------------------------------
  s("saw")
    .note("<[~ 4 ~ [6 7]] [8 ~ 7 ~]  [9 ~ 8 7] [5 ~ 4 ~]  [3 ~ 4 5] [4 ~ 2 ~]  [1 ~ 2 3] [4 6 8 7]>".scale("d4:dorian"))
    .attack(0.02).decay(0.32).sustain(0.4).release(0.35)
    .lpf(cutoff)
    .lpq(2.2)
    .delay(0.45).delaytime(3/16).delayfeedback(0.52)
    .jux(rev)
    .room(0.5).size(0.75)
    .gain(0.78),

  // --------------------------------------------------------------------------
  // GEAR 8: МЯГКИЙ ХРУСТАЛЬНЫЙ КОЛОКОЛЬЧИК (Кислород C5-OH: нежный кристалл)
  // Отклик часовой пружины в конце фразы, растворяющийся в реверберации
  // --------------------------------------------------------------------------
  s("sine")
    .note("<[~ ~ ~ [d6,a6]] [~ ~ ~ [e6,b6]] [~ ~ ~ [f6,c7]] [~ ~ ~ [g6,d7]]>")
    .attack(0.02).decay(0.38).sustain(0)
    .lpf(1800)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain(0.28),

  // --------------------------------------------------------------------------
  // РЕЗОНАТОРНЫЙ КОРПУС ЧАСОВ (Теплый атмосферный 5-HT пэд)
  // Гармонический фундамент Dm9 - G13 - Bbmaj7 - Am7
  // --------------------------------------------------------------------------
  s("sine")
    .note("<[d3,f3,a3,c4,e4] [g3,bb3,d4,f4,a4] [bb2,d3,f3,a3,c4] [a2,c3,e3,g3,b3]>")
    .attack(0.4).release(0.9)
    .lpf(1600)
    .room(0.75).size(0.85)
    .gain(0.52),

  // --------------------------------------------------------------------------
  // ВЫПУСК ПАРА / СИНКОПИРОВАННЫЙ ОФФБИТ-ХЭТ
  // --------------------------------------------------------------------------
  s("[~ oh]*4")
    .hpf(1800)
    .gain(0.72)
)
