// ============================================================================
// SEROTONIN (NCCc1c[nH]c2ccc(O)cc12) — CLOCKWORK GEAR TRANCE (138 BPM)
// Concept: Molecular Clockwork Mechanism — every atom is a gear; rotating teeth
// collide and mesh to produce emergent rhythmic sparks and harmonic interference.
// Interactive UI Sliders enabled for live mechanical manipulation!
// ============================================================================

setcps(138 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

stack(
  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 1: ТЯЖЕЛЫЙ УГЛЕРОДНЫЙ МАХОВИК C10 (10 зубцов)
  // Прямой 4-on-the-floor импульс хода часов
  // --------------------------------------------------------------------------
  s("bd:4*4")
    .gain(0.95),

  // K-B-B-B Rolling Trance Bass: передача вращения от маховика к трансмиссии
  s("[~ saw*3]*4")
    .note("<d1!4 f1!4 g1!4 eb1!4>")
    .decay(0.13).sustain(0.04)
    .lpf(slider(3400, 400, 8000, 50)) // Слайдер 1: Резонансный срез фильтра
    .lpq(slider(3.5, 1, 10, 0.1))     // Слайдер 2: Металлический звон (Resonance Q)
    .distort(slider(0.3, 0, 0.8, 0.02))// Слайдер 3: Трение шестерен (Distortion)
    .pan(0.5)
    .gain(slider(0.88, 0, 1.2, 0.02)), // Слайдер 4: Мощность привода маховика

  // Чистый саб-тон сердечника (45 Гц)
  s("sine*4")
    .note("<d1!4 f1!4 g1!4 eb1!4>")
    .decay(0.22).sustain(0.18)
    .lpf(95)
    .gain(0.92),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 2A: 12 ВОДОРОДОВ (H12 — 12-зубчатый храповик)
  // 4 ровных четвертных тика храповика в левом канале
  // --------------------------------------------------------------------------
  s("hh*4")
    .hpf(4000)
    .pan(0.25)
    .gain(0.48),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 2B: ЭМЕРДЖЕНТНОЕ ОБЛАКО ЭЛЕКТРОНОВ (Интерференция через 3/16 эхо)
  // 4 импульса + 3/16 дилей с обратной связью справа = плотная 16-дольная сеть!
  // --------------------------------------------------------------------------
  s("click*4")
    .hpf(4500)
    .crush(6)
    .delay(0.75).delaytime(3/16).delayfeedback(slider(0.68, 0.1, 0.88, 0.01)) // Слайдер 5: Эхо-интерференция
    .pan(0.75)
    .gain(0.46),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 3: ПИРРОЛЬНОЕ КОЛЬЦО (5-зубчатая латунная шестерня со сдвигом фазы)
  // Каждый такт шестерня проворачивается на 1 зубец (циклическая ротация 0..4)
  // --------------------------------------------------------------------------
  s("<rim(5,16) rim(5,16,1) rim(5,16,2) rim(5,16,3) rim(5,16,4)>")
    .hpf(700)
    .pan(0.2)
    .delay(0.4).delaytime(2/16)
    .gain(0.72),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 4: БЕНЗОЛЬНОЕ КОЛЬЦО (6-зубчатая стальная шестерня)
  // Дифференциальный сдвиг: поворот с другой угловой скоростью
  // --------------------------------------------------------------------------
  s("<metal:2(6,16) metal:2(6,16,2) metal:2(6,16,4) metal:2(6,16,1) metal:2(6,16,3)>")
    .hpf(900).lpf(3600)
    .pan(0.8)
    .delay(0.4).delaytime(3/16)
    .gain(0.56),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 5: ЭКСЦЕНТРИКОВЫЙ СПУСК АЗОТА N7 (7-зубчатый бронзовый анкер)
  // --------------------------------------------------------------------------
  s("<tok(7,16) tok(7,16,2) tok(7,16,4) tok(7,16,1) tok(7,16,3)>")
    .hpf(800)
    .pan(0.35)
    .gain(0.62),

  // --------------------------------------------------------------------------
  // COLLISION ENGINE: ИСКРЫ ПРИ СТОЛКНОВЕНИИ ЗУБЦОВ ШЕСТЕРЕН
  // Высекаются в точках пересечения 5-й, 6-й и 7-й шестерен — каждый такт новый узор!
  // --------------------------------------------------------------------------
  s("<industrial:4(11,16) industrial:4(11,16,3) industrial:4(11,16,6) industrial:4(11,16,2)>")
    .hpf(1200)
    .crush(5)
    .distort(0.3)
    .pan(rand)
    .gain(slider(0.58, 0, 0.9, 0.02)), // Слайдер 6: Громкость искр столкновения

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 6: МЕХАНИЧЕСКИЙ ДИФФЕРЕНЦИАЛ АРПЕДЖИО (Зубчатая гребенка)
  // 4 эволюционирующих контура: терции, водопад, октавы и разворот
  // --------------------------------------------------------------------------
  s("triangle*2")
    .note("<[0 4 7 11 2 6 9 12 4 7 11 14 7 11 14 16] [14 11 7 4 12 9 6 2 11 7 4 0 9 6 4 2] [0 7 12 7 2 9 14 9 4 11 16 11 6 12 18 12] [7 11 9 6 4 7 6 2 0 4 2 1 0 2 4 7]>".scale("d4:dorian"))
    .decay(0.09).sustain(0)
    .lpf(slider(2800, 400, 7000, 50)) // Слайдер 7: Яркость арпеджио
    .lpq(2.5)
    .delay(0.42).delaytime(2/16).delayfeedback(0.55)
    .jux(rev)
    .gain("<[0.55 0.35 0.5 0.4]*4>")
    .gain(0.72),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 7: КУРАНТЫ / ПАРЯЩИЙ МЕЛОДИЧЕСКИЙ ЛИД (Главная тема механизма)
  // Парящая мелодия в D Dorian с объемным аналоговым дилеем
  // --------------------------------------------------------------------------
  s("saw")
    .note("<[~ 4 ~ [6 7]] [8 ~ 7 ~]  [9 ~ 8 7] [5 ~ 4 ~]  [3 ~ 4 5] [4 ~ 2 ~]  [1 ~ 2 3] [4 6 8 7]>".scale("d4:dorian"))
    .attack(0.02).decay(0.32).sustain(0.4).release(0.35)
    .lpf(3200)
    .lpq(2.2)
    .delay(0.45).delaytime(3/16).delayfeedback(0.52)
    .jux(rev)
    .room(0.5).size(0.75)
    .gain(0.78),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 8: МЯГКИЙ ХРУСТАЛЬНЫЙ КОЛОКОЛЬЧИК (Кислород C5-OH: нежный кристалл)
  // --------------------------------------------------------------------------
  s("sine")
    .note("<[~ ~ ~ [d6,a6]] [~ ~ ~ [e6,b6]] [~ ~ ~ [f6,c7]] [~ ~ ~ [g6,d7]]>")
    .attack(0.02).decay(0.38).sustain(0)
    .lpf(1800)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain(0.28),

  // --------------------------------------------------------------------------
  // РЕЗОНАТОРНЫЙ КОРПУС ЧАСОВ (Теплый атмосферный 5-HT пэд: Dm9 - G13 - Bbmaj7 - Am7)
  // --------------------------------------------------------------------------
  s("sine")
    .note("<[d3,f3,a3,c4,e4] [g3,bb3,d4,f4,a4] [bb2,d3,f3,a3,c4] [a2,c3,e3,g3,b3]>")
    .attack(0.4).release(0.9)
    .lpf(1600)
    .room(0.75).size(0.85)
    .gain(0.52),

  // --------------------------------------------------------------------------
  // ВЫПУСК ПАРА / СИНКОПИРОВАННЫЙ ОФФБИТ-ХЭТ
  // --------------------------------------------------------------------------
  s("[~ oh]*4")
    .hpf(1800)
    .gain(0.72)
)
