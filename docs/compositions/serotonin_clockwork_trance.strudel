// ============================================================================
// SEROTONIN (NCCc1c[nH]c2ccc(O)cc12) — CLOCKWORK GEAR TRANCE (138 BPM)
// New Harmony & Melody: F# Minor / F# Dorian (F#m9 - Dmaj7#11 - Bm9 - C#m7)
// Concept: Molecular Clockwork Assembly — panoramic motion of gear teeth,
// where emergent arpeggio notes crystallize out of gear collisions / covalent bonds.
// Interactive UI Sliders enabled!
// ============================================================================

setcps(138 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ============================================================================
// TIMELINE (144 cycles @ 138 BPM, ~4:10):
// Part 1 (cycles 0-39):   Сборка атомов и шестерен, панорамное движение,
//                         рождение первых нот арпеджио из соприкосновений зубцов
// Part 2 (cycles 40-79):  Запуск маховика: бочка 4x4, rolling trance bass, полное арпеджио
// Part 3 (cycles 80-119): EUPHORIC ZENITH — Парящий лид F# Minor, максимальная полиметрия
// Part 4 (cycles 120-143): Синаптический клиренс и распад механизма (Fadeout)
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 1: ТЯЖЕЛЫЙ УГЛЕРОДНЫЙ МАХОВИК C10 (10 зубцов)
  // В части 1 спит; на такте 32 дает первые редкие толчки; с такта 40 — прямой 4x4
  // --------------------------------------------------------------------------
  s("<~!32 [~ bd:4]*2!8 [bd:4*4]!40 [bd:4*4]!40 [bd:4*2]!16 ~!8>")
    .gain(0.95),

  // K-B-B-B Rolling Trance Bass в F# Minor (<f#1 d1 b0 c#1>)
  s("<~!40 [~ saw*3]*4!40 [~ saw*3]*4!40 [~ saw*2]*4!16 ~!8>")
    .note("<f#1!4 d1!4 b0!4 c#1!4>")
    .decay(0.13).sustain(0.04)
    .lpf(slider(3400, 400, 8000, 50)) // Слайдер 1: Резонансный срез фильтра
    .lpq(slider(3.5, 1, 10, 0.1))     // Слайдер 2: Металлический звон (Resonance Q)
    .distort(slider(0.3, 0, 0.8, 0.02))// Слайдер 3: Трение шестерен (Distortion)
    .pan(0.5)
    .gain(slider(0.88, 0, 1.2, 0.02)), // Слайдер 4: Мощность привода маховика

  // Чистый саб-бас сердечника (46 Гц тоника F#)
  s("<~!40 sine*4!40 sine*4!40 sine*2!16 ~!8>")
    .note("<f#1!4 d1!4 b0!4 c#1!4>")
    .decay(0.22).sustain(0.18)
    .lpf(95)
    .gain(0.92),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 2A: 12 ВОДОРОДОВ (H12 — Движение по панораме)
  // В части 1 медленно блуждает слева направо: pan("<0.1 0.3 0.6 0.9 0.7 0.4 0.2>")
  // --------------------------------------------------------------------------
  s("<[hh*4]!40 [hh*4]!40 [hh*4]!40 [hh*4]!16 ~!8>")
    .hpf(4000)
    .pan("<0.1!8 0.3!8 0.6!8 0.85!8 0.5!8 0.25!80 0.5!24>")
    .gain("<0.35!40 0.48!40 0.52!40 0.25!16 0!8>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 2B: ЭМЕРДЖЕНТНОЕ ОБЛАКО ЭЛЕКТРОНОВ (Интерференция через 3/16 эхо)
  // 4 тика + 3/16 дилей с обратной связью справа = плотная 16-дольная сеть!
  // --------------------------------------------------------------------------
  s("<[click*4]!40 [click*4]!40 [click*4]!40 [click*4]!16 ~!8>")
    .hpf(4500)
    .crush(6)
    .delay(0.75).delaytime(3/16).delayfeedback(slider(0.68, 0.1, 0.88, 0.01)) // Слайдер 5: Эхо-интерференция
    .pan("<0.9!8 0.7!8 0.4!8 0.15!8 0.5!8 0.75!80 0.5!24>")
    .gain("<0.3!40 0.45!40 0.48!40 0.2!16 0!8>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 3: ПИРРОЛЬНОЕ КОЛЬЦО (5-зубчатая латунь — сближение из крайнего левого канала)
  // В части 1 движется от pan 0.05 к центру; каждый такт проворачивается на 1 зубец!
  // --------------------------------------------------------------------------
  s("<~!8 rim(5,16)!8 rim(5,16,1)!8 rim(5,16,2)!8 rim(5,16,3)!8 [rim(5,16) rim(5,16,1) rim(5,16,2) rim(5,16,3) rim(5,16,4)]!80 rim(5,16)!24>")
    .hpf(700)
    .pan("<0.05!8 0.1!8 0.15!8 0.2!8 0.25!112>")
    .delay(0.4).delaytime(2/16)
    .gain("<0!8 0.55!32 0.72!80 0.3!24>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 4: БЕНЗОЛЬНОЕ КОЛЬЦО (6-зубчатая сталь — сближение из крайнего правого канала)
  // В части 1 движется от pan 0.95 навстречу пирролу к центру!
  // --------------------------------------------------------------------------
  s("<~!8 metal:2(6,16)!8 metal:2(6,16,2)!8 metal:2(6,16,4)!8 metal:2(6,16,1)!8 [metal:2(6,16) metal:2(6,16,2) metal:2(6,16,4) metal:2(6,16,1) metal:2(6,16,3)]!80 metal:2(6,16)!24>")
    .hpf(900).lpf(3600)
    .pan("<0.95!8 0.9!8 0.85!8 0.8!8 0.75!112>")
    .delay(0.4).delaytime(3/16)
    .gain("<0!8 0.45!32 0.58!80 0.25!24>"),

  // --------------------------------------------------------------------------
  // COLLISION ENGINE: ИСКРЫ ПРИ СОПРИКОСНОВЕНИИ ЗУБЦОВ / КОВАЛЕНТНОЙ СВЯЗИ
  // В части 1 высекаются редкие искры на стыках шестерен, в части 2 и 3 — полный фейерверк
  // --------------------------------------------------------------------------
  s("<~!12 [industrial:4(3,16)]!12 [industrial:4(5,16,2)]!16 [industrial:4(11,16) industrial:4(11,16,3) industrial:4(11,16,6) industrial:4(11,16,2)]!80 industrial:4(3,16)!24>")
    .hpf(1200)
    .crush(5)
    .distort(0.32)
    .pan(rand)
    .gain(slider(0.58, 0, 0.9, 0.02)), // Слайдер 6: Громкость искр столкновения

  // --------------------------------------------------------------------------
  // РОЖДЕНИЕ АРПЕДЖИО ИЗ СОПРИКОСНОВЕНИЯ ШЕСТЕРЕНОК (Emergent Crystallization)
  // Такты 0-7: тишина
  // Такты 8-15: первая ковалентная связь -> рождается 1-я нота тоники [0] (F#4)
  // Такты 16-23: вторая связь -> рождается квинта [0 4] (F#4, C#5)
  // Такты 24-31: три связи -> трезвучие [0 4 8] (F#4, C#5, G#5)
  // Такты 32-39: сборка пиррола -> 5-нотный кластер F#m9 [[0 ~ 2 ~] [4 ~ 6 ~] [8 ~ ~ ~]]
  // Такты 40+: ПОЛНОЕ 16-ДОЛЬНОЕ КАСКАДНОЕ ВОДОПАДНОЕ АРПЕДЖИО!
  // --------------------------------------------------------------------------
  s("<[triangle/2]!40 [triangle*2]!40 [triangle*2]!40 triangle!24>")
    .note("<[~]!8 [~ ~ 0 ~]!8 [~ [0 4] ~ ~]!8 [[~ 0] [~ 4] [~ 8] ~]!8 [[0 ~ 2 ~] [4 ~ 6 ~] [8 ~ ~ ~]]!8 [0 4 7 11 2 6 9 12 4 7 11 14 7 11 14 16]!20 [14 11 7 4 12 9 6 2 11 7 4 0 9 6 4 2]!20 [0 7 12 7 2 9 14 9 4 11 16 11 6 12 18 12]!20 [7 11 9 6 4 7 6 2 0 4 2 1 0 2 4 7]!20 [0 4 7 11]!24>".scale("f#4:minor"))
    .decay("<0.25!40 0.09!80 0.18!24>").sustain(0)
    .lpf(slider(2800, 400, 7000, 50)) // Слайдер 7: Яркость арпеджио
    .lpq(2.5)
    .delay(0.42).delaytime(2/16).delayfeedback(0.55)
    .jux(rev)
    .gain("<[0.55 0.35 0.5 0.4]*4>")
    .gain("<0!8 0.45!8 0.5!8 0.55!8 0.6!8 0.75!80 0.35!24>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 7: НОВАЯ ГЛАВНАЯ МЕЛОДИЧЕСКАЯ ЛИНИЯ (F# Minor Celestial Lead)
  // Парящая тема курантов: F#4 -> C#5 -> E5 -> F#5 -> G#5 -> A5 (Dorian/Minor)
  // Появляется в части 3 во всей полноте трансового полета
  // --------------------------------------------------------------------------
  s("<~!80 saw!40 [saw/2]!16 ~!8>")
    .note("<[~ 4 ~ [6 7]] [8 ~ 7 ~]  [9 ~ 8 7] [6 ~ 4 ~]  [5 ~ 4 3] [4 ~ 2 ~]  [1 ~ 2 3] [4 6 8 7]>".scale("f#4:minor"))
    .attack(0.02).decay(0.32).sustain(0.4).release(0.35)
    .lpf(3400)
    .lpq(2.2)
    .delay(0.45).delaytime(3/16).delayfeedback(0.52)
    .jux(rev)
    .room(0.5).size(0.75)
    .gain("<0!80 0.8!40 0.35!16 0!8>"),

  // --------------------------------------------------------------------------
  // НОВАЯ ГАРМОНИЯ РЕЗОНАТОРНОГО КОРПУСА (Теплый пэд F#m9 - Dmaj7#11 - Bm9 - C#m7)
  // Плавно раскрывается в части 1 по мере объединения атомов
  // --------------------------------------------------------------------------
  s("<sine!40 sine!40 sine!40 sine!16 ~!8>")
    .note("<[f#3,a3,c#4,e4,g#4] [d3,f#3,a3,c#4,g#4] [b2,d3,f#3,a3,c#4] [c#3,e3,g#3,b3,d#4]>")
    .attack(0.4).release(0.9)
    .lpf("<600!16 1000!24 1600!40 2200!40 1000!24>")
    .room(0.75).size(0.85)
    .gain("<0.2!16 0.4!24 0.52!40 0.55!40 0.25!24>"),

  // --------------------------------------------------------------------------
  // ШЕСТЕРНЯ 8: МЯГКИЙ ХРУСТАЛЬНЫЙ КОЛОКОЛЬЧИК (5-OH Кислород в F# Minor)
  // Нежный кристаллический отклик в тональности [f#6, c#7]
  // --------------------------------------------------------------------------
  s("<~!40 sine!40 sine!40 sine!16 ~!8>")
    .note("<[~ ~ ~ [f#6,c#7]] [~ ~ ~ [g#6,d7]] [~ ~ ~ [a6,e7]] [~ ~ ~ [b6,f#7]]>")
    .attack(0.02).decay(0.38).sustain(0)
    .lpf(1800)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain("<0!40 0.22!40 0.28!40 0.12!16 0!8>"),

  // --------------------------------------------------------------------------
  // ВЫПУСК ПАРА / СИНКОПИРОВАННЫЙ ОФФБИТ-ХЭТ (Подключается с такта 40)
  // --------------------------------------------------------------------------
  s("<~!40 [~ oh]*4!40 [~ oh]*4!40 ~!24>")
    .hpf(1800)
    .gain("<0!40 0.68!40 0.72!40 0!24>")
)
