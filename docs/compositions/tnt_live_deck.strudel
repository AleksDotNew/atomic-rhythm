// ============================================================================
// TNT (2,4,6-TRINITROTOLUENE, C7H5N3O6) — INTERACTIVE GABBER & METAL LIVE DECK (175 BPM)
// Powered by Dirt-Samples: gabba, gtr, hoover, metal, industrial, future, cr, sd, cp, hh
// Controls:
// - detonation: 0.0 = глухой предвзрывной гул -> 1.0 = полный взрывной хардкор и бластбит!
// - guitarGain: громкость и перегруз тяжелого метал-стека нитрогрупп
// - hooverGain: уровень визжащего Alpha Juno Mentasm Hoover кислорода
// ============================================================================

setcps(175 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// ИНТЕРАКТИВНЫЕ СЛАЙДЕРЫ УПРАВЛЕНИЯ ВЗРЫВОМ:
// ----------------------------------------------------------------------------
const detonation = slider(0.5, 0, 1, 0.01) // Ползунок детонации ТНТ (0.0 -> 1.0)
const guitarGain = slider(0.85, 0, 1, 0.01) // Громкость тяжелых гитар
const hooverGain = slider(0.75, 0, 1, 0.01) // Громкость рэйв-хувера

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: БЕНЗОЛЬНОЕ КОЛЬЦО (C6) — GABBER KICK
  // --------------------------------------------------------------------------
  s("<[gabba:0!4]!3 [gabba:0!2 gabba:0*2 gabba:0*4]>")
    .lpf(1200 + detonation * 6800)
    .distort(0.35 + detonation * 0.5)
    .shape(0.7)
    .gain(0.7 + detonation * 0.28),

  // --------------------------------------------------------------------------
  // TRACK 2: ТРИ НИТРОГРУППЫ (-NO2) — ТЯЖЕЛЫЙ МЕТАЛ-РИФФ (gtr:2)
  // Drop D метал-рифф с палм-мьютом: D1 - F1 - G1 - Ab1 - C1
  // --------------------------------------------------------------------------
  note("<[d1 d1 ~ d1] [d1 ~ f1 d1] [g1 ~ ab1 g1] [f1 d1 c1 ~] [d1 d1 ~ d1] [f1 ~ g1 ab1] [d1 ~ d1 d1] [f1 eb1 d1 ~]>")
    .s("gtr:2")
    .decay(0.2).sustain(0.15)
    .lpf(1500 + detonation * 6000)
    .room(0.25).size(0.8)
    .delay(0.25).delaytime(3/16).delayfeedback(0.5)
    .pan(0.35)
    .gain(guitarGain),

  // --------------------------------------------------------------------------
  // TRACK 3: СУБ-ПАНЧ ГИТАРНОГО СТЕКА (Перегруженная пила Doom OST)
  // --------------------------------------------------------------------------
  note("<[d1 d1 ~ d1] [d1 ~ f1 d1] [g1 ~ ab1 g1] [f1 d1 c1 ~] [d1 d1 ~ d1] [f1 ~ g1 ab1] [d1 ~ d1 d1] [f1 eb1 d1 ~]>")
    .s("saw")
    .decay(0.16).sustain(0.08)
    .distort(0.85)
    .lpf(1200 + detonation * 2300)
    .lpq(4)
    .pan(0.65)
    .gain(guitarGain * 0.9),

  // --------------------------------------------------------------------------
  // TRACK 4: 6 АТОМОВ КИСЛОРОДА — РЕЙВ-ХУВЕР (Alpha Juno Mentasm hoover:0)
  // --------------------------------------------------------------------------
  note("<[~ d3 ~ f3] [g3 ~ ab3 ~] [g3 ~ f3 ~] [eb3 ~ d3 ~]>")
    .s("hoover:0")
    .decay(0.32).sustain(0.5)
    .lpf(1500 + detonation * 5000)
    .lpq(2.8)
    .distort(0.35)
    .room(0.5).size(0.7)
    .pan(0.5)
    .jux(rev)
    .gain(hooverGain * (0.2 + detonation * 0.8)),

  // --------------------------------------------------------------------------
  // TRACK 5: МЕТИЛЬНАЯ ГРУППА (-CH3) — ВЫСОКОСКОРОСТНЫЕ ХЭТЫ
  // --------------------------------------------------------------------------
  s("hh*16")
    .velocity("<[0.25 0.75 0.35 0.9 0.25 0.8 0.4 0.95]*2>")
    .hpf(4500)
    .pan(0.7)
    .gain(0.4 + detonation * 0.25),

  // Оффбитный открытый хэт:
  s("~ oh ~ oh")
    .hpf(3500)
    .decay(0.2)
    .gain(0.45 + detonation * 0.25),

  // --------------------------------------------------------------------------
  // TRACK 6: АТОМАРНЫЙ СКРЕЖЕТ — ИНДУСТРИАЛЬНЫЙ МЕТАЛЛ (metal & industrial)
  // --------------------------------------------------------------------------
  s("<[metal:1(5,16)] [metal:3(7,16)] [industrial:2(5,16)] [metal:0(7,16)]>")
    .hpf(2200)
    .pan("<0.2 0.8 0.3 0.7>")
    .gain(0.3 + detonation * 0.25),

  // --------------------------------------------------------------------------
  // TRACK 7: ХАРДКОРНЫЙ СНЕЙР / КЛЭП
  // --------------------------------------------------------------------------
  s("~ [sd,cp] ~ [sd,cp]")
    .hpf(200)
    .distort(0.4)
    .room(0.3)
    .gain(0.6 + detonation * 0.25),

  // --------------------------------------------------------------------------
  // TRACK 8: ИНДУСТРИАЛЬНЫЙ САБ-БАС (40-60 Гц)
  // --------------------------------------------------------------------------
  note("<d1!2 f1!2 g1!2 eb1!2>")
    .s("saw")
    .decay(0.28).sustain(0.12)
    .lpf(280)
    .lpq(3)
    .gain(0.65 + detonation * 0.22),

  // --------------------------------------------------------------------------
  // TRACK 9: КРЭШ НА ПЕРВУЮ ДОЛЮ
  // --------------------------------------------------------------------------
  s("<cr ~!7>")
    .gain(0.45 + detonation * 0.25)
)
