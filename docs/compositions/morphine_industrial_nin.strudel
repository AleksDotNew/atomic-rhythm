// ============================================================================
// MORPHINE (C17H19NO3) — INDUSTRIAL ROCK & DREAD (96 BPM)
// In the spirit of Trent Reznor & Nine Inch Nails (The Downward Spiral, Fragile, Doom)
// Powered by prebake.strudel macros & Deep Dirt-Samples: feel, industrial, metal, moog, gtr, gretsch, click
//
// Chemical Architecture:
// 1. Ring A (Phenol / Benzene ring): Cold, isolated 4-on-the-floor industrial kick (feel:0), hard panned left.
// 2. Rings B & C (Cyclohexyl core): Gritty syncopated Minimoog bass groove (moog + saw), hard panned right.
// 3. Ring E (Ether bridge C4-O-C5): Hydraulic clanks (industrial:2, metal:2), closing physical distance.
// 4. Ring D (Piperidine with N-CH3): Rapid nervous 16th-note hi-hat clouds & covalent bond snap (bondFlash).
// 5. The Morphinan Pentacyclic Cage: Full industrial catharsis — abrasive wall-of-fuzz guitars (guitarMetal)
//    contrasted with Trent Reznor's signature fragile, broken, melancholic piano echoing in massive reverb.
//
// Key: C Minor / C Dorian | Tempo: 96 BPM
// ============================================================================

// Установка темпа с химическим макросом из prebake.strudel:
chemTempo(96)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// TIMELINE (64 cycles @ 96 BPM, ~2:40):
// Phase 1 (cycles 0-7):   Кольцо А — Одинокий холодный пульс фенола слева, эхо шестеренок
// Phase 2 (cycles 8-15):  Кольца B & C — Появление синкопированного Moog-баса справа, гидравлика
// Phase 3 (cycles 16-23): Эфирный мостик E — Сближение панорам к центру, раскрытие фильтров
// Phase 4 (cycles 24-31): Азотный мостик D — Разгон снейров, суб-напряжение, ковалентная вспышка (bondFlash)
// Phase 5 (cycles 32-55): Полный остов Морфина — Яростный NIN Industrial Groove, перегруз и хрупкое пианино
// Phase 6 (cycles 56-63): The Downward Spiral — Механический распад, угасание в тишину и эхо
// ----------------------------------------------------------------------------

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: КОЛЬЦО А (ФЕНОЛ) — ИНДУСТРИАЛЬНЫЙ КИК (feel:0 + industrial:0)
  // Начинает в глубоком левом канале (pan 0.15) и по мере сборки мигрирует в центр
  // --------------------------------------------------------------------------
  s("<[feel:0 ~ feel:0 ~]!8 [feel:0 ~ feel:0 feel:0]!8 [feel:0 feel:0 feel:0 ~]!8 [feel:0!4]!8 [feel:0 ~ [feel:0 feel:0] feel:0]!24 [feel:0 ~ ~ ~]!8>")
    .pan("<0.15!8 0.25!8 0.38!8 0.5!8 0.5!24 0.5!8>")
    .lpf("<450!8 800!8 1800!8 4500!8 8000!24 600!8>")
    .distort("<0.2!8 0.35!8 0.5!8 0.65!8 0.75!24 0.2!8>")
    .gain("<0.8!8 0.85!8 0.9!8 0.92!8 0.96!24 0.4!8>"),

  // --------------------------------------------------------------------------
  // TRACK 2: КОЛЬЦА B & C (ЦИКЛОГЕКСИЛ) — СИНКОПИРОВАННЫЙ REZNOR MOOG BASS
  // Начинает справа (pan 0.85) и движется навстречу кольцу А
  // --------------------------------------------------------------------------
  note("<[c1 ~ c1 ~ ~ c1 ~ ~] [eb1 ~ f1 ~ ~ g1 ~ ~] [bb0 ~ c1 ~ ~ c1 ~ ~] [ab0 ~ bb0 ~ g0 ~ ~ ~]>")
    .s("moog")
    .decay(0.32).sustain(0.2)
    .lpf("<350!8 550!8 950!8 1800!8 2800!24 400!8>")
    .lpq(4.5)
    .distort(0.4)
    .pan("<0.85!8 0.75!8 0.62!8 0.5!8 0.5!24 0.5!8>")
    .gain("<0!8 0.75!8 0.82!8 0.88!8 0.92!24 0.3!8>"),

  // Фундаментальный саб-бас (макрос subBass из prebake):
  subBass("<c1!2 eb1!2 bb0!2 ab0!2>")
    .gain("<0!8 0.7!8 0.8!8 0.85!8 0.9!24 0.25!8>"),

  // --------------------------------------------------------------------------
  // TRACK 3: ЭФИРНЫЙ МОСТИК E — ГИДРАВЛИЧЕСКИЕ СОУДАРЕНИЯ И МИКРО-ГЛИТЧ
  // Сэмплы industrial:2, metal:2, industrial:4, click:0
  // --------------------------------------------------------------------------
  s("<[industrial:2(3,8)] [metal:2(5,16)] [industrial:4(3,8)] [click:0(7,16)]>")
    .hpf(1200)
    .room(0.5)
    .pan("<0.2 0.8 0.35 0.65 0.5>")
    .gain("<0.25!8 0.45!8 0.6!8 0.72!8 0.75!24 0.2!8>"),

  // --------------------------------------------------------------------------
  // TRACK 4: АЗОТНЫЙ МОСТИК D (-N-CH3) — ВОДОРОДНЫЕ ХЭТЫ (макрос hydrogenHats)
  // 16-дольный нервный шелест метильной группы третичного азота
  // --------------------------------------------------------------------------
  hydrogenHats("hh*16", 3500)
    .pan(0.65)
    .gain("<0!16 0.45!8 0.65!8 0.72!24 0.2!8>"),

  // Оффбитный открытый хэт:
  s("<~!24 [~ oh ~ oh]!32 ~!8>")
    .hpf(3000)
    .gain("<0!24 0.68!32 0!8>"),

  // Акустический снейр NIN (gretsch:20 на 2 и 4 долю):
  s("<~!16 [~ gretsch:20 ~ gretsch:20]!40 ~!8>")
    .hpf(200)
    .distort(0.3)
    .room(0.4)
    .gain("<0!16 0.75!8 0.82!8 0.88!24 0!8>"),

  // --------------------------------------------------------------------------
  // TRACK 5: ФИНАЛЬНЫЙ ЩЕЛЧОК СБОРКИ АЗОТА (макрос bondFlash)
  // Вспышка на 31-м такте ровно перед входом в полный катарсис
  // --------------------------------------------------------------------------
  bondFlash("<~!31 [future:1, cr]!1 ~!32>")
    .gain(0.95),

  // --------------------------------------------------------------------------
  // TRACK 6: ПОЛНЫЙ ОСТОВ МОРФИНА — СТЕНА ГИТАРНОГО ФАТАЛИЗМА (макрос guitarMetal)
  // Тяжелый индустриальный рифф Reznor / NIN в C Minor
  // --------------------------------------------------------------------------
  guitarMetal("<[c1 c1 ~ c1] [eb1 ~ f1 g1] [bb0 ~ c1 c1] [ab0 g0 f0 ~]>", 6500)
    .gain("<0!32 0.88!24 0!8>"),

  // --------------------------------------------------------------------------
  // TRACK 7: ХРУПКОЕ МЕЛАНХОЛИЧНОЕ ПИАНИНО ТРЕНТА РЕЗНОРА (The Fragile Piano)
  // Фирменный контраст NIN: обнаженная, изломанная, нежная мелодия сквозь дисторшн
  // --------------------------------------------------------------------------
  note("<[~ g4 ~ c5] [eb5 ~ d5 ~] [~ bb4 ~ c5] [g4 ~ f4 ~] [~ eb5 ~ g5] [f5 ~ d5 ~] [~ c5 ~ eb5] [d5 ~ g4 ~]>")
    .s("sine")
    .decay(0.8).sustain(0.15)
    .lpf(2800)
    .delay(0.5).delaytime(3/16).delayfeedback(0.65)
    .room(0.85).size(0.92)
    .pan(0.45)
    .gain("<0!4 0.55!12 0.65!8 0.75!8 0.85!24 0.65!8>"),

  // --------------------------------------------------------------------------
  // TRACK 8: КИНЕМАТОГРАФИЧЕСКИЙ МРАЧНЫЙ ЭМБИЕНТ-ПЭД (макрос ambientPad)
  // --------------------------------------------------------------------------
  ambientPad("<[c2,g2,eb3,bb3] [ab1,eb2,c3,g3] [bb1,f2,d3,ab3] [g1,d2,b2,f3]>", 1100)
    .gain("<0.3!16 0.45!16 0.6!24 0.35!8>")
)
