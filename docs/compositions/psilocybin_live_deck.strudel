// ============================================================================
// PSILOCYBIN (LIVE PERFORMANCE DECK) — ORGANIC FOREST PSYTRANCE
// Immediate jam session version: all instruments active in full shamanic drive!
// Key: E Phrygian | Master Tempo: 142 BPM | Meter: 4/4
// ============================================================================

// ----------------------------------------------------------------------------
// 1. LIVE PERFORMANCE SLIDERS (strudel.cc GUI compatible)
// Сигнатура в Strudel: slider(defaultValue, min, max, step)
// ----------------------------------------------------------------------------
const getSlider = (val, min, max, step) => 
  (typeof slider === 'function' ? slider(val, min, max, step) : val);

const sporeCutoff  = getSlider(2600, 400, 7500, 50);
const sporeRes     = getSlider(16, 1, 30, 1);
const bassCutoff   = getSlider(700, 250, 1600, 25);
const bassRes      = getSlider(6, 1, 14, 0.5);
const bassDrive    = getSlider(0.35, 0, 0.75, 0.05);
const shamanBright = getSlider(4800, 1000, 9000, 100);
const shamanGain   = getSlider(0.88, 0, 1.0, 0.02);
const caveDelay    = getSlider(0.55, 0, 0.85, 0.02);
const forestVerb   = getSlider(0.75, 0.1, 0.95, 0.02);

// ----------------------------------------------------------------------------
// 2. ИНИЦИАЛИЗАЦИЯ СЭМПЛОВ И ТЕМПА (142 BPM)
// ----------------------------------------------------------------------------
samples('github:tidalcycles/dirt-samples')

const chemTempo = globalThis.chemTempo || ((bpm, temp = 0) => setcps((bpm * (1 + Math.max(0, Math.min(100, temp)) / 100)) / 60 / 4));
chemTempo(142, 0);

stack(
  // 1. Земляной 4-on-the-floor кик (C12)
  s("bd:4*4")
    .bank("tr909")
    .gain(0.98),

  // 2. Rolling Forest Bass (Индольный корень в E Phrygian)
  note("<[~ e1*3]!4 [~ f1*3]!4 [~ a1*3]!4 [~ d1*3]!2 [~ b0*3]!2>")
    .s("saw")
    .decay(0.13).sustain(0.04)
    .lpf(bassCutoff)
    .lpq(bassRes)
    .distort(bassDrive)
    .pan(0.5)
    .gain(0.92),

  // 3. Тяжелый гравитационный саб фосфора P (Z=15)
  note("<e1!4 f1!4 a1!4 d1!2 b0!2>")
    .s("sine")
    .decay(0.26).sustain(0.22)
    .lpf(90)
    .gain(0.95),

  // 4. Водородные 16-дольные хэты (H17)
  s("hh*16")
    .velocity("<[0.28 0.72 0.35 0.92 0.28 0.75 0.38 0.98]*2>")
    .hpf(3500)
    .gain(0.75),

  // 5. Открытый sizzle-хэт
  s("[~ oh]*4")
    .hpf(2000)
    .gain(0.75),

  // 6. Органический древесный клап
  s("[~ cp ~ cp]")
    .hpf(800)
    .room(0.35).size(0.6)
    .gain(0.82),

  // 7. Капли спор и мицелий (Пузырьковые капли)
  s("<[bubble:0 ~ bubble:2 ~] [~ bubble:1 ~ bubble:3]>")
    .lpf(1600)
    .room(0.6).size(0.8)
    .gain(0.4),

  // 8. Древесные щелчки (Бензол 6-пульсов vs Пиррол 5-пульсов)
  s("can:2(6,16)")
    .hpf(1000).lpf(4000)
    .pan(0.85)
    .gain(0.58),

  s("glitch:5(5,16)")
    .hpf(1200)
    .pan(0.15)
    .gain(0.62),

  // 9. Кислотный арпеджио диметиламина N(CH3)2
  note("<[e3 g3 a3 b3] [c4 b3 a3 g3] [e3 g3 b3 d4] [c4 b3 a3 f3]>".fast(2))
    .s("saw")
    .decay(0.13).sustain(0.03)
    .lpf(sporeCutoff)
    .lpq(sporeRes)
    .distort(0.35)
    .delay(caveDelay).delaytime(3/16).delayfeedback(0.62)
    .pan(0.32)
    .gain(0.8),

  // 10. ГЛАВНЫЙ ШАМАНСКИЙ ДУХОВЫЙ ЛИД (ПСИЛОЦИН 4-OH-DMT)
  note("<[[~ e4] [f4 g4] [a4 b4] [c5 b4]] [[e5 ~] [d5 c5] [b4 a4] [g4 f4]] [[e4 g4] [b4 e5] [f5 e5] [d5 b4]] [[c5 b4] [a4 g4] [f4 ~] [e4 ~]] [[~ e5] [f5 g5] [a5 b5] [c6 b5]] [[e6 d6] [c6 b5] [a5 g5] [a5 b5]] [[c6 b5] [a5 b5] [g5 f5] [g5 a5]] [[b5 ~] [g5 ~] [f5 ~] [e5 ~]] [e4(3,8) g4(3,8) b4(2,8)] [c5 b4 a4 g4 f4 e4 d4 f4]>")
    .s("triangle")
    .attack(0.03).decay(0.4).sustain(0.5).release(0.4)
    .lpf(shamanBright)
    .delay(caveDelay).delaytime(3/16).delayfeedback(0.65)
    .jux(rev)
    .room(forestVerb).size(0.9)
    .gain(shamanGain),

  // 11. Октавный резонансный дубль (Sawtooth)
  note("<[[~ e5] [f5 g5] [a5 b5] [c6 b5]] [[e6 ~] [d6 c6] [b5 a5] [g5 f5]] [[e5 g5] [b5 e6] [f6 e6] [d6 b5]] [[c6 b5] [a5 g5] [f5 ~] [e5 ~]] [[~ e6] [f6 g6] [a6 b6] [c7 b6]] [[e7 d7] [c7 b6] [a6 g6] [a6 b6]] [[c7 b6] [a6 b6] [g6 f6] [g6 a6]] [[b6 ~] [g6 ~] [f6 ~] [e6 ~]]>")
    .s("saw")
    .decay(0.28).sustain(0.35)
    .lpf(shamanBright)
    .lpq(3.5)
    .delay(caveDelay).delaytime(2/16).delayfeedback(0.58)
    .pan(0.7)
    .gain(shamanGain * 0.8),

  // 12. Темный лесной пэд
  note("<[e3,g3,b3,d4] [f3,a3,c4,e4] [a2,c3,e3,g3] [d3,f3,a3,c4]>")
    .s("sine")
    .attack(0.6).release(1.2)
    .lpf(1300)
    .room(forestVerb).size(0.95)
    .gain(0.68)
)
