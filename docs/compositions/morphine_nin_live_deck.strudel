// ============================================================================
// MORPHINE (C17H19NO3) — NIN INDUSTRIAL LIVE DECK (96 BPM)
// In the spirit of Trent Reznor & Nine Inch Nails (The Downward Spiral, Fragile, Doom)
// Powered by prebake.strudel macros & Deep Dirt-Samples: feel, industrial, glitch, moog, gtr, gretsch, click
//
// ============================================================================
// ИНТЕРАКТИВНАЯ ПАНЕЛЬ СЛАЙДЕРОВ В НАЧАЛЕ СТРАНИЦЫ:
// Все слайдеры сгруппированы в самом верху для удобного лайв-контроля в Strudel!
// ============================================================================
const assemblyProgress  = slider(0.5, 0, 1, 0.01)   // Сборка 5 колец: 0.0 (раздельные атомы) -> 1.0 (остов Морфина)
const industrialDrive   = slider(0.75, 0, 1, 0.01)  // Перегруз, дисторшн и резноровская ярость
const fragilePiano      = slider(0.7, 0, 1, 0.01)   // Громкость фирменного меланхоличного пианино Резнора
const mechanicalGlitch  = slider(0.6, 0, 1, 0.01)   // Плотность гидравлических ударов и шестеренок
// ============================================================================

// Автономные фоллбэки макросов (код работает автономно, даже если prebake.strudel не загружен):
const chemTempo    = globalThis.chemTempo || ((bpm, temp = 0) => setcps((bpm * (1 + temp / 100)) / 60 / 4));
const subBass      = globalThis.subBass || ((pat, lpf = 95) => note(pat).s("sine").decay(0.5).sustain(0.4).lpf(lpf));
const hydrogenHats = globalThis.hydrogenHats || ((pat = "hh*16", hpf = 3500) => s(pat).velocity("<[0.25 0.75 0.35 0.9 0.25 0.8 0.4 0.95]*2>").hpf(hpf));
const guitarMetal  = globalThis.guitarMetal || ((pat, lpf = 6500) => stack(note(pat).s("gtr:2").decay(0.2).sustain(0.15).lpf(lpf).room(0.25).size(0.8).delay(0.2).delaytime(3/16).delayfeedback(0.5).pan(0.35), note(pat).s("saw").decay(0.16).sustain(0.08).distort(0.85).lpf(lpf * 0.5).lpq(4).pan(0.65)));
const ambientPad   = globalThis.ambientPad || ((chords, lpf = 1200) => note(chords).s("sine").attack(0.8).release(1.2).lpf(lpf).room(0.88).size(0.95));

chemTempo(96)
samples('github:tidalcycles/dirt-samples')

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: КОЛЬЦО А (ФЕНОЛ) — ИНДУСТРИАЛЬНЫЙ КИК
  // При сборке (assemblyProgress) физически мигрирует слева (0.15) в центр (0.5)
  // --------------------------------------------------------------------------
  s("<[feel:0 ~ feel:0 ~] [feel:0 ~ [feel:0 feel:0] feel:0]>")
    .pan(0.15 + assemblyProgress * 0.35)
    .lpf(450 + assemblyProgress * 7500)
    .distort(0.2 + industrialDrive * 0.6)
    .gain(0.8 + assemblyProgress * 0.18),

  // --------------------------------------------------------------------------
  // TRACK 2: КОЛЬЦА B & C (ЦИКЛОГЕКСИЛ) — СИНКОПИРОВАННЫЙ REZNOR MOOG BASS
  // При сборке физически мигрирует справа (0.85) навстречу кольцу А в центр (0.5)
  // --------------------------------------------------------------------------
  note("<[c1 ~ c1 ~ ~ c1 ~ ~] [eb1 ~ f1 ~ ~ g1 ~ ~] [bb0 ~ c1 ~ ~ c1 ~ ~] [ab0 ~ bb0 ~ g0 ~ ~ ~]>")
    .s("moog")
    .decay(0.32).sustain(0.2)
    .lpf(400 + assemblyProgress * 2400)
    .lpq(3.5 + industrialDrive * 2.0)
    .distort(0.2 + industrialDrive * 0.5)
    .pan(0.85 - assemblyProgress * 0.35)
    .gain(0.6 + assemblyProgress * 0.32),

  // Фундаментальный саб-бас (макрос subBass из prebake):
  subBass("<c1!2 eb1!2 bb0!2 ab0!2>")
    .gain(0.6 + assemblyProgress * 0.3),

  // --------------------------------------------------------------------------
  // TRACK 3: ЭФИРНЫЙ МОСТИК E — ГИДРАВЛИЧЕСКИЕ СОУДАРЕНИЯ И МИКРО-ГЛИТЧ
  // --------------------------------------------------------------------------
  s("<[industrial:2(3,8)] [glitch:5(5,16)] [industrial:4(3,8)] [click:0(7,16)]>")
    .hpf(1200)
    .room(0.5)
    .pan("<0.2 0.8 0.35 0.65 0.5>")
    .gain(mechanicalGlitch * (0.4 + assemblyProgress * 0.5)),

  // --------------------------------------------------------------------------
  // TRACK 4: АЗОТНЫЙ МОСТИК D (-N-CH3) — ВОДОРОДНЫЕ ХЭТЫ (макрос hydrogenHats)
  // --------------------------------------------------------------------------
  hydrogenHats("hh*16", 3500)
    .pan(0.65)
    .gain(0.3 + assemblyProgress * 0.42),

  // Оффбитный открытый хэт:
  s("~ oh ~ oh")
    .hpf(3000)
    .gain(assemblyProgress > 0.3 ? 0.68 : 0),

  // Акустический снейр NIN (gretsch:20 на 2 и 4 долю):
  s("~ gretsch:20 ~ gretsch:20")
    .hpf(200)
    .distort(0.2 + industrialDrive * 0.3)
    .room(0.4)
    .gain(0.5 + assemblyProgress * 0.38),

  // --------------------------------------------------------------------------
  // TRACK 5: ПОЛНЫЙ ОСТОВ МОРФИНА — СТЕНА ГИТАРНОГО ФАТАЛИЗМА (макрос guitarMetal)
  // --------------------------------------------------------------------------
  guitarMetal("<[c1 c1 ~ c1] [eb1 ~ f1 g1] [bb0 ~ c1 c1] [ab0 g0 f0 ~]>", 3000 + industrialDrive * 4500)
    .gain(assemblyProgress > 0.4 ? (assemblyProgress - 0.4) * 1.5 * industrialDrive : 0),

  // --------------------------------------------------------------------------
  // TRACK 6: ХРУПКОЕ МЕЛАНХОЛИЧНОЕ ПИАНИНО ТРЕНТА РЕЗНОРА (The Fragile Piano)
  // --------------------------------------------------------------------------
  note("<[~ g4 ~ c5] [eb5 ~ d5 ~] [~ bb4 ~ c5] [g4 ~ f4 ~] [~ eb5 ~ g5] [f5 ~ d5 ~] [~ c5 ~ eb5] [d5 ~ g4 ~]>")
    .s("sine")
    .decay(0.8).sustain(0.15)
    .lpf(2800)
    .delay(0.5).delaytime(3/16).delayfeedback(0.65)
    .room(0.85).size(0.92)
    .pan(0.45)
    .gain(fragilePiano),

  // --------------------------------------------------------------------------
  // TRACK 7: КИНЕМАТОГРАФИЧЕСКИЙ МРАЧНЫЙ ЭМБИЕНТ-ПЭД (макрос ambientPad)
  // --------------------------------------------------------------------------
  ambientPad("<[c2,g2,eb3,bb3] [ab1,eb2,c3,g3] [bb1,f2,d3,ab3] [g1,d2,b2,f3]>", 1100)
    .gain(0.3 + assemblyProgress * 0.3)
)
