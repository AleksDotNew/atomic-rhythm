// ============================================================================
// LSD-25 (CCN(CC)C(=O)C1CN(C)C2Cc3c[nH]c4cccc(C2=C1)c34)
// HYPNOTIC PSYCHEDELIC GOA TRANCE (3:06, 112 Cycles @ 144 BPM)
//
// Genre: Full-On Psytrance / Goa Trance (Astral Projection / Hallucinogen style)
// Concept: Subatomic genesis -> Atomic Nucleation (C, N, O, H) -> 
//          Ergoline 6-5-6-6 Tetracyclic Rings -> Twin Diethylamide Stereo Arms ->
//          5-HT2A Serotonin Receptor Docking Climax & Dissociation.
// Key: D Phrygian Dominant (D, Eb, F#, G, A, Bb, C) / D Aeolian
// Master Tempo: 144 BPM | Total Duration: 112 Cycles (~3:06)
// ============================================================================

// ----------------------------------------------------------------------------
// 1. INTERACTIVE CONTROL SLIDERS (strudel.cc GUI compatible, safe offline defaults)
// ----------------------------------------------------------------------------
if (typeof slider === 'undefined') {
  globalThis.slider = (name, val) => val;
}

// Master Tempo (144 BPM baseline)
const tempo       = slider('tempo', 144, 136, 152, 1);

// 303 Acid Resonant Filter Cutoff & Squelch Q
const acidCutoff  = slider('acidCutoff', 2400, 300, 7500, 50);
const acidRes     = slider('acidRes', 16, 1, 32, 1);

// Rolling Bassline Cutoff & Distortion Drive
const bassCutoff  = slider('bassCutoff', 650, 200, 1800, 25);
const bassDrive   = slider('bassDrive', 0.35, 0, 0.8, 0.05);

// Goa Melodic Lead Brightness & Presence
const leadBright  = slider('leadBright', 4800, 1000, 9000, 100);
const leadGain    = slider('leadGain', 0.82, 0, 1.0, 0.02);

// Space Echo (3/16 Dotted Delay) & Cosmic Reverb Wetness
const spaceDelay  = slider('spaceDelay', 0.52, 0, 0.85, 0.02);
const spaceEchoFb = slider('spaceEchoFb', 0.65, 0.1, 0.88, 0.02);
const cosmicVerb  = slider('cosmicVerb', 0.72, 0.1, 0.95, 0.02);

// ----------------------------------------------------------------------------
// 2. RUNTIME ENVIRONMENT & SAMPLE INITIALIZATION
// ----------------------------------------------------------------------------
samples('github:tidalcycles/dirt-samples')

const chemTempo = globalThis.chemTempo || ((bpm, temp = 0) => setcps((bpm * (1 + Math.max(0, Math.min(100, temp)) / 100)) / 60 / 4));
chemTempo(tempo, 0);

// ============================================================================
// DRAMATURGY TIMELINE (6 PHASES across 112 cycles @ 144 BPM, 1 cycle = ~1.67s):
//
// Phase 1 (0:00 - 0:26, cycles 0-15):   Квантовый генезис: электроны и протоны в вакууме.
// Phase 2 (0:26 - 0:53, cycles 16-31):  Нуклеация атомов: C, H, N, O. Мягкий кик и хэты.
// Phase 3 (0:53 - 1:20, cycles 32-47):  Ковалентные связи: кольца индола A (6) и B (5). Роллинг-бас.
// Phase 4 (1:20 - 1:46, cycles 48-63):  Кольца C и D + диэтиламидный хвост. Pre-drop билдап и пауза.
// Phase 5 (1:46 - 2:39, cycles 64-95):  EUPHORIC FULL-ON CLIMAX: Вход в рецептор 5-HT2A. Парящий лид!
// Phase 6 (2:39 - 3:06, cycles 96-111): Диссоциация молекулы и растворение в космическом эхе.
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: 4-ON-THE-FLOOR ПАНЧЕВАЯ ТРАНС-БОЧКА (Ядерное притяжение C20)
  // Прямой, плотный трансовый кик с четким кликом
  // --------------------------------------------------------------------------
  s("<~!16 [~ bd:4]*2!8 [bd:4*4]!8 [bd:4*4]!31 ~ [bd:4*4]!32 [bd:4*2]!12 ~!4>")
    .bank("tr909")
    .gain("<0!16 0.75!8 0.9!8 0.95!31 0 0.98!32 0.7!12 0!4>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ROLLING PSYTRANCE BASS (Эрголиновый тетрацикл C20H25N3O)
  // 16-дольный роллинг бас (K-B-B-B), гармонически проходящий через 4 кольца:
  // Кольцо A (Бензол, 6C) -> d1
  // Кольцо B (Пиррол, 5C/N) -> eb1 (Фригийская секунда)
  // Кольцо C (Тетрагидропиридин, C9=C10) -> g1
  // Кольцо D (Пиперидин + Амид) -> c1 / a0
  // --------------------------------------------------------------------------
  note("<[~ d1*3]!4 [~ eb1*3]!4 [~ g1*3]!4 [~ c1*3]!2 [~ a0*3]!2>".slow(4))
    .s("saw")
    .decay(0.12).sustain(0.05)
    .lpf("<250!16 420!16 650!16 850!15 0 950!32 450!12 0!4>")
    .lpq(acidRes * 0.4)
    .distort(bassDrive)
    .pan(0.5)
    .gain("<0!16 0.65!16 0.85!16 0.88!15 0 0.92!32 0.65!12 0!4>"),

  // Фундаментальный саб-бас (45-55 Гц чистый синус под бочку и бас)
  note("<d1!4 eb1!4 g1!4 c1!2 a0!2>".slow(4))
    .s("sine")
    .decay(0.24).sustain(0.2)
    .lpf(95)
    .gain("<0!32 0.85!16 0.88!15 0 0.94!32 0.6!12 0!4>"),

  // --------------------------------------------------------------------------
  // TRACK 3: ЭЛЕКТРОННЫЕ ОРБИТАЛИ (Водородные хэты H25)
  // 16-дольная катящаяся дробь хэтов с динамическим грувом
  // --------------------------------------------------------------------------
  s("<~!16 [hh*8]!16 [hh*16]!16 [hh*16]!15 ~ [hh*16]!32 [hh*8]!12 ~!4>")
    .velocity("<[0.3 0.7 0.35 0.95 0.3 0.75 0.4 1.0]*2>")
    .hpf(3800)
    .gain("<0!16 0.55!16 0.65!16 0.7!15 0 0.75!32 0.5!12 0!4>"),

  // Открытый трансовый sizzle-хэт на слабую долю (Связи C-H)
  s("<~!32 [~ oh]*4!16 [~ oh]*4!15 ~ [~ oh]*4!32 ~!16>")
    .hpf(2200)
    .gain("<0!32 0.65!16 0.7!15 0 0.75!32 0!16>"),

  // Ковалентные хлопки (Связи между кольцами) на 2 и 4 долю
  s("<~!32 [~ cp ~ cp]!16 [~ cp ~ cp]!15 ~ [~ cp ~ cp]!32 ~!16>")
    .hpf(900)
    .room(0.3).size(0.5)
    .gain("<0!32 0.72!16 0.76!15 0 0.82!32 0!16>"),

  // --------------------------------------------------------------------------
  // TRACK 4: 303 ACID SQUELCH (Резонанс бензольного и пиррольного колец A + B)
  // Извивающаяся кислотная 16-дольная линия с живым фильтром и дилеем
  // --------------------------------------------------------------------------
  note("<[d3 eb3 f3 g3] [a3 g3 f#3 eb3] [d3 f#3 a3 c4] [bb3 a3 g3 f#3]>".fast(2))
    .s("saw")
    .decay(0.14).sustain(0.04)
    .lpf("<600!16 1100!16 2200!16 3500!15 0 4200!32 1200!12 0!4>")
    .lpq(acidRes)
    .distort(0.4)
    .delay(spaceDelay * 0.8).delaytime(3/16).delayfeedback(spaceEchoFb)
    .pan(0.35)
    .gain("<0!16 0.6!16 0.74!16 0.78!15 0 0.82!32 0.4!12 0!4>"),

  // --------------------------------------------------------------------------
  // TRACK 5: ДВУХКРЫЛЫЙ ДИЭТИЛАМИДНЫЙ ХВОСТ (Стерео-разветвление N(CH2CH3)2)
  // Левое крыло (Pan 0.15, 3/16 Delay) и Правое крыло (Pan 0.85, 2/16 Delay)
  // Создают захватывающую психоделическую стерео-панораму
  // --------------------------------------------------------------------------
  note("<[d5 f#5 a5 d6] [d6 a5 f#5 eb5] [g5 bb5 d6 c6] [a5 f#5 eb5 d5]>".fast(2))
    .s("triangle")
    .decay(0.08).sustain(0)
    .lpf(acidCutoff)
    .delay(spaceDelay).delaytime(3/16).delayfeedback(spaceEchoFb)
    .pan(0.18)
    .gain("<0!48 0.65!15 0 0.72!32 0.4!12 0!4>"),

  note("<[d6 a5 f#5 d5] [eb5 f#5 a5 d6] [c6 d6 bb5 g5] [d5 eb5 f#5 a5]>".fast(2))
    .s("sine")
    .decay(0.08).sustain(0)
    .lpf(acidCutoff)
    .delay(spaceDelay).delaytime(2/16).delayfeedback(spaceEchoFb)
    .pan(0.82)
    .gain("<0!48 0.65!15 0 0.72!32 0.4!12 0!4>"),

  // --------------------------------------------------------------------------
  // TRACK 6: ПАРИТЕТ ПОЛИМЕТРИИ КОЛЕЦ (Бензол 6-пульсов vs Пиррол 5-пульсов)
  // Акустическая интерференция на стыке двух колец индола
  // --------------------------------------------------------------------------
  s("can:1(6,16)")
    .hpf(1200).lpf(4500)
    .pan(0.88)
    .gain("<0!32 0.45!16 0.52!15 0 0.58!32 0!16>"),

  s("rim(5,16)")
    .hpf(800).lpf(3800)
    .pan(0.12)
    .gain("<0!32 0.5!16 0.55!15 0 0.62!32 0!16>"),

  // --------------------------------------------------------------------------
  // TRACK 7: ГЛАВНЫЙ ПАcompiler GOA МЕЛОДИЧЕСКИЙ ЛИД (Вход в рецептор 5-HT2A)
  // Незабываемая, мистическая восточная тема в D Phrygian Dominant (Hijaz)
  // Поющая двойная пила с портаменто, каскадными трелями и эхо
  // --------------------------------------------------------------------------
  note("<[~ d4] [eb4 f#4] [g4 a4] [bb4 a4]  [d5 ~] [c5 bb4] [a4 g4] [f#4 eb4]  [d4 f#4] [a4 d5] [eb5 d5] [c5 a4]  [bb4 a4] [g4 f#4] [eb4 ~] [d4 ~]  [~ d5] [eb5 f#5] [g5 a5] [bb5 a5]  [d6 c6] [bb5 a5] [g5 f#5] [g5 a5]  [bb5 a5] [g5 a5] [f#5 eb5] [f#5 g5]  [a5 ~] [f#5 ~] [eb5 ~] [d5 ~]>".slow(8))
    .s("saw")
    .attack(0.015).decay(0.35).sustain(0.45).release(0.3)
    .lpf(leadBright)
    .lpq(3.5)
    .distort(0.2)
    .delay(spaceDelay).delaytime(3/16).delayfeedback(spaceEchoFb)
    .jux(rev)
    .room(cosmicVerb).size(0.85)
    .gain("<0!64 0.85!16 0.92!16 0.5!12 0!4>"),

  // Октавная гармония лида на втором пике (Cycles 80-95)
  note("<[~ d5] [eb5 f#5] [g5 a5] [bb5 a5]  [d6 ~] [c6 bb5] [a5 g5] [f#5 eb5]  [d5 f#5] [a5 d6] [eb6 d6] [c6 a5]  [bb5 a5] [g5 f#5] [eb5 ~] [d5 ~]  [~ d6] [eb6 f#6] [g6 a6] [bb6 a6]  [d7 c7] [bb6 a6] [g6 f#6] [g6 a6]  [bb6 a6] [g6 a6] [f#6 eb6] [f#6 g6]  [a6 ~] [f#6 ~] [eb6 ~] [d6 ~]>".slow(8))
    .s("triangle")
    .decay(0.25).sustain(0.3)
    .lpf(leadBright * 1.1)
    .delay(spaceDelay * 0.9).delaytime(2/16).delayfeedback(0.6)
    .pan(0.65)
    .gain("<0!80 0.72!16 0!16>"),

  // --------------------------------------------------------------------------
  // TRACK 8: КВАНТОВЫЙ ВАКУУМ & АТМОСФЕРНЫЙ ПЭД (Электроны оболочек K, L, M)
  // Синусоидальные орбитальные всплески и глубокий психоделический пад
  // --------------------------------------------------------------------------
  note("<[d3,f#3,a3,c4] [eb3,g3,bb3,d4] [g3,bb3,d4,f4] [c3,eb3,g3,bb3]>".slow(4))
    .s("sine")
    .attack(0.5).release(1.1)
    .lpf(1400)
    .room(cosmicVerb).size(0.92)
    .gain("<0.42!16 0.48!16 0.55!16 0.6!15 0 0.65!32 0.5!12 0.2!4>"),

  // Квантовые фотонные синусы в верхнем регистре (Одиночные электроны)
  note("<[d6 a6 f#7] [eb6 bb6 g7] [f#6 c7 a7] [a6 e7 c8]>".scramble())
    .s("sine")
    .decay(0.04).sustain(0)
    .delay(0.6).delaytime(3/16).delayfeedback(0.75)
    .pan("<0.1 0.9 0.25 0.75>")
    .gain("<0.32!16 0.25!16 0.28!16 0.35!15 0 0.3!32 0.28!12 0.15!4>"),

  // --------------------------------------------------------------------------
  // TRACK 9: PRE-DROP РАЗГОН & БОНД-ВСПЫШКИ (Cycles 60-63 перед дропом)
  // Нарастающая дробь малого барабана и краш-вспышка на дропе
  // --------------------------------------------------------------------------
  s("<~!60 [sd*8] [sd*16] [sd*24] [sd*32] ~!48>")
    .hpf(600)
    .room(0.5).size(0.8)
    .gain("<0!60 0.65 0.75 0.85 0.95 0!48>"),

  // Краш-акцент в момент входа в рецептор (Cycle 64 и Cycle 80)
  s("<~!64 cr ~!15 cr ~!31>")
    .hpf(1500)
    .room(0.8).size(0.9)
    .gain(0.85)
)
