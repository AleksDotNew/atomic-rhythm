// ============================================================================
// PSILOCYBIN (CN(C)CCc1c[nH]c2cccc(OP(=O)(O)O)c12)
// ORGANIC FOREST PSYTRANCE & SHAMANIC GOA (3:09, 112 Cycles @ 142 BPM)
//
// Genre: Forest Psytrance / Shamanic Goa (Earthy, Mystical, Hyperdimensional)
// Concept: 
//   1. Subatomic genesis: Protons (Z), Electrons (K, L, M shells), spore water drops.
//   2. Atomic Nucleation: Carbon (C12), Nitrogen (N2), Oxygen (O4), Phosphorus (P, Z=15).
//   3. Covalent bonding: Fused Indole core (Benzene 6C + Pyrrole 5C/N).
//   4. Phosphate anchor & 5-Bar Legato Hold: 6 eighth notes + long held note across 5 bars!
//   5. Dephosphorylation -> PSILOCIN (4-OH-DMT): Shamanic Drop with 10 diverse patterns!
//   6. Ego Dissolution & Quantum Outro.
//
// Key: E Phrygian (E, F, G, A, B, C, D) | Master Tempo: 142 BPM
// Duration: 112 Cycles (~3:09)
// ============================================================================

// ----------------------------------------------------------------------------
// 1. ИНТЕРАКТИВНЫЕ СЛАЙДЕРЫ (strudel.cc GUI compatible, safe offline defaults)
// Сигнатура в Strudel: slider(defaultValue, min, max, step)
// ----------------------------------------------------------------------------
const getSlider = (val, min, max, step) => 
  (typeof slider === 'function' ? slider(val, min, max, step) : val);

// Срез и резонанс органического фильтра
const sporeCutoff  = getSlider(2200, 300, 7000, 50);
const sporeRes     = getSlider(14, 1, 30, 1);

// Плотность земляного роллинг-баса и перегруз
const bassCutoff   = getSlider(600, 200, 1600, 25);
const bassRes      = getSlider(6, 1, 14, 0.5);
const bassDrive    = getSlider(0.32, 0, 0.75, 0.05);

// Шаманский лид (Псилоцин 4-OH-DMT)
const shamanBright = getSlider(4200, 800, 8500, 100);
const shamanGain   = getSlider(0.85, 0, 1.0, 0.02);

// Пещерный 3/16 дилей и глубина лесного ревербератора
const caveDelay    = getSlider(0.55, 0, 0.85, 0.02);
const forestVerb   = getSlider(0.75, 0.1, 0.95, 0.02);

// ----------------------------------------------------------------------------
// 2. ИНИЦИАЛИЗАЦИЯ СЭМПЛОВ И ТЕМПА (142 BPM)
// ----------------------------------------------------------------------------
samples('github:tidalcycles/dirt-samples')

const chemTempo = globalThis.chemTempo || ((bpm, temp = 0) => setcps((bpm * (1 + Math.max(0, Math.min(100, temp)) / 100)) / 60 / 4));
chemTempo(142, 0);

// ============================================================================
// DRAMATURGY TIMELINE (6 PHASES across 112 cycles @ 142 BPM, 1 cycle = ~1.69s):
//
// Phase 1 (0:00 - 0:27, cycles 0-15):   Квантовый генезис: электроны, протоны, споры.
// Phase 2 (0:27 - 0:54, cycles 16-31):  Нуклеация атомов: C12, H17, N2, O4, P15. Мягкий кик.
// Phase 3 (0:54 - 1:21, cycles 32-47):  Индольное кольцо (6C + 5C/N). Роллинг-бас E Phrygian.
// Phase 4 (1:21 - 1:48, cycles 48-63):  Фосфатная группа: 6 ВОСЬМУШЕК + ЛЕГАТО НА 5 ТАКТОВ!
// Phase 5 (1:48 - 2:42, cycles 64-95):  ДЕФОСФОРИЛИРОВАНИЕ -> ПСИЛОЦИН! 10 разнообразных паттернов!
// Phase 6 (2:42 - 3:09, cycles 96-111): Растворение эго в мицелии и уход в космическую тишину.
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: ЗЕМЛЯНОЙ ТРАНСОВЫЙ КИК (Углеродное ядро C12)
  // Прямой 4-on-the-floor кик с плотным панчем
  // --------------------------------------------------------------------------
  s("<~!16 [~ bd:4]*2!8 [bd:4*4]!8 [bd:4*4]!15 ~ [bd:4*4]!36 [bd:4*2]!20 ~!4>")
    .bank("tr909")
    .gain("<0!16 0.72!8 0.88!8 0.94!15 0 0.98!36 0.7!20 0!4>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ROLLING FOREST BASS (Индольный корень в E Phrygian)
  // Гармонический цикл по 4 сегментам:
  // e1 (Корень) -> f1 (Фригийская малая секунда) -> a1 (Азот) -> d1/b0 (Фосфат)
  // --------------------------------------------------------------------------
  note("<[~ e1*3]!4 [~ f1*3]!4 [~ a1*3]!4 [~ d1*3]!2 [~ b0*3]!2>")
    .s("saw")
    .decay(0.13).sustain(0.04)
    .lpf("<240!16 380!16 580!16 750!15 0 880!36 420!20 0!4>")
    .lpq(bassRes)
    .distort(bassDrive)
    .pan(0.5)
    .gain("<0!16 0.65!16 0.84!16 0.88!15 0 0.92!36 0.65!20 0!4>"),

  // Тяжёлый гравитационный саб фосфора P (Z=15, атомный вес 30.97 u)
  note("<e1!4 f1!4 a1!4 d1!2 b0!2>")
    .s("sine")
    .decay(0.26).sustain(0.22)
    .lpf(90)
    .gain("<0!32 0.85!16 0.88!15 0 0.95!36 0.6!20 0!4>"),

  // --------------------------------------------------------------------------
  // TRACK 3: ВОДОРОДНЫЕ ХЭТЫ (H17) И СВЯЗИ
  // --------------------------------------------------------------------------
  s("<~!16 [hh*8]!16 [hh*16]!16 [hh*16]!15 ~ [hh*16]!36 [hh*8]!20 ~!4>")
    .velocity("<[0.28 0.72 0.35 0.92 0.28 0.75 0.38 0.98]*2>")
    .hpf(3500)
    .gain("<0!16 0.52!16 0.65!16 0.7!15 0 0.75!36 0.5!20 0!4>"),

  // Открытый трансовый sizzle-хэт на слабую долю
  s("<~!32 [~ oh]*4!16 [~ oh]*4!15 ~ [~ oh]*4!36 ~!20>")
    .hpf(2000)
    .gain("<0!32 0.65!16 0.7!15 0 0.75!36 0!20>"),

  // Ковалентные хлопки (Связи между кольцами) на 2 и 4 долю
  s("<~!32 [~ cp ~ cp]!16 [~ cp ~ cp]!15 ~ [~ cp ~ cp]!36 ~!20>")
    .hpf(800)
    .room(0.35).size(0.6)
    .gain("<0!32 0.7!16 0.75!15 0 0.82!36 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 4: КАПЛИ СПОР И ДРЕВЕСНЫЙ МИЦЕЛИЙ
  // --------------------------------------------------------------------------
  s("<[bubble:0 ~ bubble:2 ~] [~ bubble:1 ~ bubble:3]>")
    .lpf(1600)
    .room(0.6).size(0.8)
    .gain("<0.45!16 0.35!16 0.4!16 0.45!15 0 0.4!36 0.35!20 0.2!4>"),

  // Древесные щелчки: Бензол 6-пульсов (справа) vs Пиррол 5-пульсов (слева)
  s("can:2(6,16)")
    .hpf(1000).lpf(4000)
    .pan(0.85)
    .gain("<0!16 0.42!16 0.52!16 0.55!15 0 0.58!36 0.4!20 0!4>"),

  s("glitch:5(5,16)")
    .hpf(1200)
    .pan(0.15)
    .gain("<0!16 0.45!16 0.55!16 0.58!15 0 0.62!36 0.4!20 0!4>"),

  // --------------------------------------------------------------------------
  // TRACK 5: ДИМЕТИЛАМИННЫЙ ХВОСТ N(CH3)2 — КИСЛОТНЫЙ 16-ДОЛЬНЫЙ АРПЕДЖИО
  // --------------------------------------------------------------------------
  note("<[e3 g3 a3 b3] [c4 b3 a3 g3] [e3 g3 b3 d4] [c4 b3 a3 f3]>".fast(2))
    .s("saw")
    .decay(0.13).sustain(0.03)
    .lpf(sporeCutoff)
    .lpq(sporeRes)
    .distort(0.35)
    .delay(caveDelay).delaytime(3/16).delayfeedback(0.62)
    .pan(0.32)
    .gain("<0!32 0.65!16 0.72!15 0 0.8!36 0.4!20 0!4>"),

  // --------------------------------------------------------------------------
  // TRACK 6: ШАМАНСКИЙ ЛИД — ПСИЛОЦИН (4-OH-DMT)
  //
  // Включает:
  // 1) ФОСФАТНУЮ ЛЕГАТО-ФРАЗУ (Cycle 48): 6 восьмушек + нота b4 на 4-й доле,
  //    тянущаяся через следующие 5 тактов (legato 21, длительность 5.25 такта)!
  // 2) 10 РАЗНООБРАЗНЫХ МЕЛОДИЧЕСКИХ ПАТТЕРНОВ НА ДРОПЕ (Cycles 64-95):
  //    Богатая, нерубленая, поющая психоделическая тема в E Phrygian!
  // --------------------------------------------------------------------------
  note("<~!48 [[e4 f4] [g4 a4] [b4 c5] b4] ~!5 [[e5 d5] [c5 b4] [a4 g4] [f4 e4]]!10 [[~ e4] [f4 g4] [a4 b4] [c5 b4]] [[e5 ~] [d5 c5] [b4 a4] [g4 f4]] [[e4 g4] [b4 e5] [f5 e5] [d5 b4]] [[c5 b4] [a4 g4] [f4 ~] [e4 ~]] [[~ e5] [f5 g5] [a5 b5] [c6 b5]] [[e6 d6] [c6 b5] [a5 g5] [a5 b5]] [[c6 b5] [a5 b5] [g5 f5] [g5 a5]] [[b5 ~] [g5 ~] [f5 ~] [e5 ~]] [e4(3,8) g4(3,8) b4(2,8)] [c5 b4 a4 g4 f4 e4 d4 f4] [[~ e4] [f4 g4] [a4 b4] [c5 b4]]!22 ~!4>")
    .legato("<~!48 [[1 1] [1 1] [1 1] 21] ~!5 1!68>")
    .s("triangle")
    .attack(0.02).decay(0.38).sustain(0.48).release(0.35)
    .lpf(shamanBright)
    .delay(caveDelay).delaytime(3/16).delayfeedback(0.65)
    .jux(rev)
    .room(forestVerb).size(0.9)
    .gain("<0!48 0.85!48 0.5!12 0!4>"),

  // Октавный резонансный дубль лида (Sawtooth) на кульминации дропа
  note("<[[~ e5] [f5 g5] [a5 b5] [c6 b5]] [[e6 ~] [d6 c6] [b5 a5] [g5 f5]] [[e5 g5] [b5 e6] [f6 e6] [d6 b5]] [[c6 b5] [a5 g5] [f5 ~] [e5 ~]] [[~ e6] [f6 g6] [a6 b6] [c7 b6]] [[e7 d7] [c7 b6] [a6 g6] [a6 b6]] [[c7 b6] [a6 b6] [g6 f6] [g6 a6]] [[b6 ~] [g6 ~] [f6 ~] [e6 ~]]>")
    .s("saw")
    .decay(0.28).sustain(0.35)
    .lpf(shamanBright)
    .lpq(3.5)
    .delay(caveDelay).delaytime(2/16).delayfeedback(0.58)
    .pan(0.7)
    .gain("<0!72 0.74!20 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 7: ТЕМНЫЙ ЛЕСНОЙ ПЭД (Мицелий и фосфатная группа OP(=O)(OH)2)
  // --------------------------------------------------------------------------
  note("<[e3,g3,b3,d4] [f3,a3,c4,e4] [a2,c3,e3,g3] [d3,f3,a3,c4]>")
    .s("sine")
    .attack(0.6).release(1.2)
    .lpf(1300)
    .room(forestVerb).size(0.95)
    .gain("<0.45!16 0.5!16 0.58!16 0.62!15 0 0.68!36 0.5!20 0.2!4>"),

  // --------------------------------------------------------------------------
  // TRACK 8: PRE-DROP РАЗГОН И РАЗРЫВ ФОСФАТНОЙ СВЯЗИ (Cycle 60-63)
  // --------------------------------------------------------------------------
  s("<~!60 [sd*8] [sd*16] [sd*24] [sd*32] ~!48>")
    .hpf(500)
    .room(0.5).size(0.8)
    .gain("<0!60 0.65 0.75 0.85 0.95 0!48>"),

  // Вспышка дефосфорилирования (Cycle 64 дроп)
  s("<~!64 cr ~!47>")
    .hpf(1200)
    .room(0.85).size(0.92)
    .gain(0.88)
)
