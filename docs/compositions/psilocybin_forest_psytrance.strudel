// ============================================================================
// PSILOCYBIN (CN(C)CCc1c[nH]c2cccc(OP(=O)(O)O)c12)
// ORGANIC FOREST PSYTRANCE & SHAMANIC GOA (3:03, 108 Cycles @ 142 BPM)
//
// Genre: Forest Psytrance / Shamanic Goa (Earthy, Mystical, Hyperdimensional)
// Concept: Fungal spore germination -> Indole nucleus assembly ->
//          Phosphorus (Z=15) heavy atomic anchor -> Enzymatic dephosphorylation
//          into Psilocin (4-OH-DMT) -> Shamanic breakthrough & Dissolution.
// Key: E Phrygian (E, F, G, A, B, C, D) | Master Tempo: 142 BPM
// Duration: 108 Cycles (~3:03)
// ============================================================================

// ----------------------------------------------------------------------------
// 1. ИНТЕРАКТИВНЫЕ СЛАЙДЕРЫ (strudel.cc GUI compatible)
// ----------------------------------------------------------------------------
const getSlider = (val, min, max, step) => 
  (typeof slider === 'function' ? slider(val, min, max, step) : val);

// Органический срез фильтра и резонанс
const sporeCutoff  = getSlider(2200, 300, 7000, 50);
const sporeRes     = getSlider(14, 1, 30, 1);

// Плотность земляного роллинг-баса
const bassCutoff   = getSlider(600, 200, 1600, 25);
const bassDrive    = getSlider(0.32, 0, 0.75, 0.05);

// Шаманский лид (Флейта / Деревянный синтез)
const shamanBright = getSlider(4200, 800, 8500, 100);
const shamanGain   = getSlider(0.85, 0, 1.0, 0.02);

// Пещерное эхо и глубина мицелия
const caveDelay    = getSlider(0.55, 0, 0.85, 0.02);
const forestVerb   = getSlider(0.75, 0.1, 0.95, 0.02);

// ----------------------------------------------------------------------------
// 2. ИНИЦИАЛИЗАЦИЯ СЭМПЛОВ И ТЕМПА (142 BPM)
// ----------------------------------------------------------------------------
samples('github:tidalcycles/dirt-samples')

const chemTempo = globalThis.chemTempo || ((bpm, temp = 0) => setcps((bpm * (1 + Math.max(0, Math.min(100, temp)) / 100)) / 60 / 4));
chemTempo(142, 0);

// ============================================================================
// DRAMATURGY TIMELINE (5 PHASES across 108 cycles @ 142 BPM):
// Phase 1 (0:00 - 0:27, cycles 0-15):   Мицелий в темноте: капли воды, квантовые споры.
// Phase 2 (0:27 - 0:54, cycles 16-31):  Нуклеация: индол (C12, N2), тяжелый фосфор P (Z=15).
// Phase 3 (0:54 - 1:21, cycles 32-47):  Диметиламидный хвост, роллинг-бас E Phrygian.
// Phase 4 (1:21 - 2:22, cycles 48-83):  ДЕФОСФОРИЛИРОВАНИЕ: переход в ПСИЛОЦИН! Шаманский дроп!
// Phase 5 (2:22 - 3:03, cycles 84-107): Растворение эго в мицелии и уход в тишину.
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: ЗЕМЛЯНОЙ ТРАНСОВЫЙ КИК (Углеродный мицелий C12)
  // --------------------------------------------------------------------------
  s("<~!16 [~ bd:4]*2!8 [bd:4*4]!8 [bd:4*4]!15 ~ [bd:4*4]!36 [bd:4*2]!16 ~!8>")
    .bank("tr909")
    .gain("<0!16 0.72!8 0.88!8 0.94!15 0 0.98!36 0.7!16 0!8>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ROLLING FOREST BASS (Индольный корень в E Phrygian)
  // Модуляция: e1 (Корень) -> f1 (Фригийская секунда) -> a1 (Азот) -> d1/b0 (Фосфат)
  // --------------------------------------------------------------------------
  note("<[~ e1*3]!4 [~ f1*3]!4 [~ a1*3]!4 [~ d1*3]!2 [~ b0*3]!2>")
    .s("saw")
    .decay(0.13).sustain(0.04)
    .lpf("<240!16 380!16 580!16 750!15 0 880!36 420!16 0!8>")
    .lpq(6)
    .distort(bassDrive)
    .pan(0.5)
    .gain("<0!16 0.65!16 0.84!16 0.88!15 0 0.92!36 0.65!16 0!8>"),

  // Тяжелый гравитационный саб фосфора P (Z=15, глубина 40-50 Гц)
  note("<e1!4 f1!4 a1!4 d1!2 b0!2>")
    .s("sine")
    .decay(0.26).sustain(0.22)
    .lpf(90)
    .gain("<0!32 0.85!16 0.88!15 0 0.95!36 0.6!16 0!8>"),

  // --------------------------------------------------------------------------
  // TRACK 3: ВОДОРОДНЫЕ ХЭТЫ H17 & КАПЛИ СПОР
  // --------------------------------------------------------------------------
  s("<~!16 [hh*8]!16 [hh*16]!16 [hh*16]!15 ~ [hh*16]!36 [hh*8]!16 ~!8>")
    .velocity("<[0.28 0.72 0.35 0.92 0.28 0.75 0.38 0.98]*2>")
    .hpf(3500)
    .gain("<0!16 0.52!16 0.65!16 0.7!15 0 0.75!36 0.5!16 0!8>"),

  // Открытый хэт на слабую долю
  s("<~!32 [~ oh]*4!16 [~ oh]*4!15 ~ [~ oh]*4!36 ~!24>")
    .hpf(2000)
    .gain("<0!32 0.65!16 0.7!15 0 0.75!36 0!24>"),

  // Органический хлопковый хлопок (Ксилофонический древесный клап)
  s("<~!32 [~ cp ~ cp]!16 [~ cp ~ cp]!15 ~ [~ cp ~ cp]!36 ~!24>")
    .hpf(800)
    .room(0.35).size(0.6)
    .gain("<0!32 0.7!16 0.75!15 0 0.82!36 0!24>"),

  // --------------------------------------------------------------------------
  // TRACK 4: КАПЛИ СПОР И ДРЕВЕСНЫЙ МИЦЕЛИЙ (Органический перкуссионный грув)
  // --------------------------------------------------------------------------
  s("<[bubble:0 ~ bubble:2 ~] [~ bubble:1 ~ bubble:3]>")
    .lpf(1600)
    .room(0.6).size(0.8)
    .gain("<0.45!16 0.35!16 0.4!16 0.45!15 0 0.4!36 0.35!16 0.2!8>"),

  // Древесные щелчки (Бензол 6-пульсов vs Пиррол 5-пульсов)
  s("can:2(6,16)")
    .hpf(1000).lpf(4000)
    .pan(0.85)
    .gain("<0!16 0.42!16 0.52!16 0.55!15 0 0.58!36 0.4!16 0!8>"),

  s("glitch:5(5,16)")
    .hpf(1200)
    .pan(0.15)
    .gain("<0!16 0.45!16 0.55!16 0.58!15 0 0.62!36 0.4!16 0!8>"),

  // --------------------------------------------------------------------------
  // TRACK 5: ДИМЕТИЛАМИДНЫЙ ХВОСТ N(CH3)2 — КИСЛОТНЫЙ 16-ДОЛЬНЫЙ АРПЕДЖИО
  // --------------------------------------------------------------------------
  note("<[e3 g3 a3 b3] [c4 b3 a3 g3] [e3 g3 b3 d4] [c4 b3 a3 f3]>".fast(2))
    .s("saw")
    .decay(0.13).sustain(0.03)
    .lpf(sporeCutoff)
    .lpq(sporeRes)
    .distort(0.35)
    .delay(caveDelay).delaytime(3/16).delayfeedback(0.62)
    .pan(0.32)
    .gain("<0!32 0.65!16 0.72!15 0 0.8!36 0.4!16 0!8>"),

  // --------------------------------------------------------------------------
  // TRACK 6: ШАМАНСКИЙ ДУХОВЫЙ ЛИД (ПСИЛОЦИН 4-OH-DMT)
  // Глубокая, гипнотическая тема в E Phrygian
  // --------------------------------------------------------------------------
  note("<[[~ e4] [f4 g4] [a4 b4] [c5 b4]] [[e5 ~] [d5 c5] [b4 a4] [g4 f4]] [[e4 g4] [b4 e5] [f5 e5] [d5 b4]] [[c5 b4] [a4 g4] [f4 ~] [e4 ~]] [[~ e5] [f5 g5] [a5 b5] [c6 b5]] [[e6 d6] [c6 b5] [a5 g5] [a5 b5]] [[c6 b5] [a5 b5] [g5 f5] [g5 a5]] [[b5 ~] [g5 ~] [f5 ~] [e5 ~]]>")
    .s("triangle")
    .attack(0.03).decay(0.4).sustain(0.5).release(0.4)
    .lpf(shamanBright)
    .delay(caveDelay).delaytime(3/16).delayfeedback(0.65)
    .jux(rev)
    .room(forestVerb).size(0.9)
    .gain("<0!48 0.85!36 0.5!16 0!8>"),

  // Октавный резонансный дубль (Sawtooth)
  note("<[[~ e5] [f5 g5] [a5 b5] [c6 b5]] [[e6 ~] [d6 c6] [b5 a5] [g5 f5]] [[e5 g5] [b5 e6] [f6 e6] [d6 b5]] [[c6 b5] [a5 g5] [f5 ~] [e5 ~]] [[~ e6] [f6 g6] [a6 b6] [c7 b6]] [[e7 d7] [c7 b6] [a6 g6] [a6 b6]] [[c7 b6] [a6 b6] [g6 f6] [g6 a6]] [[b6 ~] [g6 ~] [f6 ~] [e6 ~]]>")
    .s("saw")
    .decay(0.28).sustain(0.35)
    .lpf(shamanBright)
    .lpq(3.5)
    .delay(caveDelay).delaytime(2/16).delayfeedback(0.58)
    .pan(0.7)
    .gain("<0!64 0.7!20 0!24>"),

  // --------------------------------------------------------------------------
  // TRACK 7: ТЕМНЫЙ ЛЕСНОЙ ПЭД (Мицелий и фосфатная группа OP(=O)(OH)2)
  // --------------------------------------------------------------------------
  note("<[e3,g3,b3,d4] [f3,a3,c4,e4] [a2,c3,e3,g3] [d3,f3,a3,c4]>")
    .s("sine")
    .attack(0.6).release(1.2)
    .lpf(1300)
    .room(forestVerb).size(0.95)
    .gain("<0.45!16 0.5!16 0.58!16 0.62!15 0 0.68!36 0.5!16 0.2!8>"),

  // --------------------------------------------------------------------------
  // TRACK 8: PRE-DROP РАЗГОН И РАЗРЫВ ФОСФАТНОЙ СВЯЗИ (Cycle 44-47)
  // --------------------------------------------------------------------------
  s("<~!44 [sd*8] [sd*16] [sd*24] [sd*32] ~!60>")
    .hpf(500)
    .room(0.5).size(0.8)
    .gain("<0!44 0.65 0.75 0.85 0.95 0!60>"),

  // Вспышка дефосфорилирования (Cycle 48 дроп)
  s("<~!48 cr ~!59>")
    .hpf(1200)
    .room(0.85).size(0.92)
    .gain(0.88)
)
