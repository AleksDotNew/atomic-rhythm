// ============================================================================
// SEROTONIN (NCCc1c[nH]c2ccc(O)cc12) — LIQUID NEURO DRUM & BASS
// Genre: Drum & Bass (Expressive Liquid Lead + Evolving Arpeggio + Aggressive Reese Bass)
// BPM: 174 | Meter: 4/4 | Key: D Dorian / D Minor | Duration: ~3:40 (160 cycles)
// ============================================================================

setcps(174 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// Optional Switchangel Prebake:
// await import('https://cdn.jsdelivr.net/gh/switchangel/strudel-scripts@main/allscripts(deprecated).js')

// ============================================================================
// DRAMATURGY TIMELINE (4 PHASES across 160 cycles @ 174 BPM, 1 cycle = ~1.38s):
// Phase 1 (0:00 - 0:50, cycles 0-35):   Квантовые электроны (94 e-), теплый 5-HT падевый аккорд
// Phase 2 (0:50 - 1:40, cycles 36-71):  Сборка индола: пиррол (5/16) + бензол (6/16), разгон хэтов
// Phase 3 (1:40 - 2:45, cycles 72-119): THE DROP — Узнаваемый Liquid Lead, каскадные арпеджио, Neuro Reese
// Phase 4 (2:45 - 3:40, cycles 120-159): Синаптический захват (SERT) и плавное затухание (Fadeout)
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: ЭЛЕКТРОНЫ / КВАНТОВЫЕ ЩЕЛЧКИ (94 электрона в молекуле)
  // Микроскопические гейгеровские импульсы и квантовые переходы
  // --------------------------------------------------------------------------
  s("<[click(7,16) glitch(5,16,2)]!36 [click(11,16) glitch(7,16)]!36 [glitch(13,16)]!48 [click(3,16)]!20 ~!20>")
    .hpf(4200)
    .crush("<5!36 5!36 4!48 7!40>")
    .pan(rand)
    .gain("<0.52!36 0.45!36 0.58!48 0.25!20 0!20>"),

  // Одиночные квантовые фотонные микро-точки
  s("<sine!36 sine!36 sine!48 ~!40>")
    .note("<[d6 a6 c7] [f6 c7 e7] [g6 d7 f7] [a6 e7 g7]>".scramble())
    .decay(0.04).sustain(0)
    .pan("<0.2 0.8 0.35 0.65>")
    .gain("<0.35!36 0.3!36 0.35!48 0!40>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ТЕПЛЫЙ 5-HT АТМОСФЕРНЫЙ ПЭД (Эйфория серотонина: Dm9 - G13 - Bbmaj7 - Am7)
  // Роскошные джазовые гармонии (чувство тепла и эмоционального подъема)
  // --------------------------------------------------------------------------
  s("<sine!36 sine!36 sine!48 sine!20 ~!20>")
    .note("<[d3,f3,a3,c4,e4] [g3,bb3,d4,f4,a4] [bb2,d3,f3,a3,c4] [a2,c3,e3,g3,b3]>")
    .attack(0.35).release(0.85)
    .lpf("<800 1200 1600 1100 700>")
    .room(0.7).size(0.85)
    .gain("<0.42!36 0.5!36 0.55!48 0.3!20 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 3: ИНДОЛЬНОЕ КОЛЬЦО — ПИРРОЛ (5-членное кольцо с [nH])
  // Полиметрический остинато 5 против 16 (Woodblock / Rimshot)
  // --------------------------------------------------------------------------
  s("<~!36 [rim(5,16)]!36 [rim(5,16)]!48 [rim(5,16)]!20 ~!20>")
    .hpf(600)
    .pan(0.25)
    .gain("<0!36 0.65!36 0.75!48 0.35!20 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 4: ИНДОЛЬНОЕ КОЛЬЦО — БЕНЗОЛ (6-членное кольцо)
  // Полиметрический остинато 6 против 16 (мягкая перкуссия)
  // --------------------------------------------------------------------------
  s("<~!36 [metal:2(6,16)]!36 [metal:2(6,16)]!48 [metal:2(3,16)]!20 ~!20>")
    .hpf(900).lpf(3500)
    .pan(0.75)
    .gain("<0!36 0.52!36 0.6!48 0.25!20 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 5: ЭТИЛАМИНОВЫЙ ХВОСТ И АЗОТ N (DnB Snare & Ghost Roll)
  // Первичный амин N формирует хлесткий рабочий барабан на 2 и 4 долю + призрачные дроби
  // --------------------------------------------------------------------------
  s("<~!48 [~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~]!24 [~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ [~ sd:2]]!48 [~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~]!20 ~!20>")
    .hpf(250)
    .room("<0.15!72 0.35!48 0.7!40>")
    .gain("<0!48 0.75!24 0.88!48 0.4!20 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 6: 12 АТОМОВ ВОДОРОДА (H12 — 16-дольный роллинг хэтов)
  // Стремительный шаффл закрытых и открытых хэтов
  // --------------------------------------------------------------------------
  s("<~!24 [hh*8]!24 [hh*16]!24 [hh*16]!48 [hh*8]!20 ~!20>")
    .gain("<[0.2 0.65 0.35 0.75 0.25 0.6 0.4 0.8]*2>")
    .hpf(3200)
    .pan(0.4)
    .gain("<0!24 0.5!24 0.6!24 0.68!48 0.3!20 0!20>"),

  // Открытый хэт на синкопы
  s("<~!72 [~ ~ oh ~ ~ ~ oh ~ ~ ~ ~ ~ oh ~ ~ ~]!48 ~!40>")
    .hpf(2000)
    .gain(0.65),

  // --------------------------------------------------------------------------
  // TRACK 7: УГЛЕРОДНЫЙ КАРКАС И 2-STEP БОЧКА (10 атомов C10)
  // Синкопированный классический Drum & Bass 2-step кик (1-я доля и синкопа перед 4-й)
  // --------------------------------------------------------------------------
  s("<~!36 [bd ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ ~ ~]!36 [bd ~ ~ ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~]!48 [bd ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~]!20 ~!20>")
    .gain(0.95),

  // --------------------------------------------------------------------------
  // TRACK 8: АГРЕССИВНЫЙ NEUROFUNK REESE BASS (Хищный рычащий бас)
  // Перегруженная расстроенная пила с модуляцией резонансного фильтра
  // --------------------------------------------------------------------------
  s("<~!72 saw!48 [saw/2]!20 ~!20>")
    .note("<[d1@3 ~ d1@2 ~!2 d1@3 ~!5] [f1@3 ~ f1@2 ~!2 f1@3 ~!5] [g1@3 ~ g1@2 ~!2 g1@3 ~!5] [eb1@3 ~ eb1@2 ~!2 eb1@3 ~!5]>")
    .decay(0.28).sustain(0.15)
    .lpf("<350 700 1400 900 500 2000 1100 400>")
    .lpq(5.5)
    .distort(0.62)
    .pan(0.5)
    .gain("<0!72 0.85!48 0.45!20 0!20>"),

  // Глубокий саб-бас (чистый синус под риз-басом, 45 Гц)
  s("<~!72 sine!48 sine!20 ~!20>")
    .note("<d1 f1 g1 eb1>")
    .decay(0.35).sustain(0.4)
    .lpf(110)
    .gain("<0!72 0.92!48 0.5!20 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 9: УЗНАВАЕМАЯ ГЛАВНАЯ МЕЛОДИЧЕСКАЯ ЛИНИЯ (Liquid DnB Anthem Lead)
  // Запоминающаяся парящая мелодия (Call & Response) в D Dorian
  // --------------------------------------------------------------------------
  s("<~!72 saw!48 [saw/2]!20 ~!20>")
    .note("<[~ 4 ~ [6 7]] [8 ~ 7 ~]  [9 ~ 8 7] [5 ~ 4 ~]  [3 ~ 4 5] [4 ~ 2 ~]  [1 ~ 2 3] [4 6 8 7]>".scale("d4:dorian"))
    .attack(0.01).decay(0.26).sustain(0.35).release(0.3)
    .lpf("<2400 3200 4500 2800 1600>")
    .lpq(2)
    .delay(0.4).delaytime(3/16).delayfeedback(0.5)
    .jux(rev)
    .room(0.45).size(0.7)
    .gain("<0!72 0.78!48 0.4!20 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 10: РАЗНООБРАЗНОЕ КАСКАДНОЕ АРПЕДЖИО (Liquid Waterfall Arp)
  // 4 разных контура: подъем по терциям, каскадный водопад, октавные скачки, разворот
  // --------------------------------------------------------------------------
  s("<triangle!36 triangle!36 [triangle*2]!48 triangle!20 ~!20>")
    .note("<[0 4 7 11 2 6 9 12 4 7 11 14 7 11 14 16] [14 11 7 4 12 9 6 2 11 7 4 0 9 6 4 2] [0 7 12 7 2 9 14 9 4 11 16 11 6 12 18 12] [7 11 9 6 4 7 6 2 0 4 2 1 0 2 4 7]>".scale("d4:dorian"))
    .decay(0.09).sustain(0)
    .lpf(2600)
    .delay(0.35).delaytime(2/16).delayfeedback(0.5)
    .jux(rev)
    .gain("<[0.55 0.35 0.5 0.4]*4>")
    .gain("<0.35!36 0.45!36 0.65!48 0.3!20 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 11: МЯГКИЙ ХРУСТАЛЬНЫЙ КОЛОКОЛЬЧИК (5-OH Кислород: нежный, не бьет по голове)
  // Редкие, шелковистые синусоидальные акценты в конце такта с глубоким ревербом
  // --------------------------------------------------------------------------
  s("<~!36 sine!36 sine!48 sine!20 ~!20>")
    .note("<[~ ~ ~ [d6,a6]] [~ ~ ~ [e6,b6]] [~ ~ ~ [f6,c7]] [~ ~ ~ [g6,d7]]>")
    .attack(0.02).decay(0.35).sustain(0)
    .lpf(1800)
    .room(0.8).size(0.85)
    .gain("<0!36 0.22!36 0.28!48 0.15!20 0!20>")
    .pan(0.8)
)
