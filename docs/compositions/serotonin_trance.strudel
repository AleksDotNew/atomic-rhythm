// ============================================================================
// SEROTONIN (NCCc1c[nH]c2ccc(O)cc12) — HYPNOTIC PROGRESSIVE TRANCE
// Genre: Progressive / Uplifting / Psy-Trance (138 BPM)
// Concept: Additive atomic assembly via acoustic delay interference, phase shifting & stereo morphing
// Key: D Dorian / D Minor | BPM: 138 | Duration: ~4:05 (140 cycles)
// ============================================================================

setcps(138 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// Optional Switchangel Prebake:
// await import('https://cdn.jsdelivr.net/gh/switchangel/strudel-scripts@main/allscripts(deprecated).js')

// ============================================================================
// DRAMATURGY TIMELINE (4 PHASES across 140 cycles @ 138 BPM, 1 cycle = ~1.74s):
// Phase 1 (0:00 - 1:10, cycles 0-39):   Квантовая интерференция (4 хэта + 3/16 эхо = 16-дольное облако)
// Phase 2 (1:10 - 2:20, cycles 40-79):  Сборка индола (5/16 + 6/16), rolling trance bass, раскрытие фильтров
// Phase 3 (2:20 - 3:30, cycles 80-119): EUPHORIC TRANCE PEAK — Полный резонанс, парящий лид, каскадный арп
// Phase 4 (3:30 - 4:05, cycles 120-139): Синаптический захват и океаническое угасание (Fadeout)
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // TRACK 1A: 4 ТИХИХ ХЭТА ЭЛЕКТРОНОВ (Сухой квантовый импульс)
  // 4 ровных четвертных удара в левом канале
  // --------------------------------------------------------------------------
  s("<[hh*4]!40 [hh*4]!40 [hh*4]!40 [hh*4]!15 ~!5>")
    .hpf(4000)
    .pan(0.25)
    .gain("<0.32!40 0.42!40 0.52!40 0.22!15 0!5>"),

  // --------------------------------------------------------------------------
  // TRACK 1B: ФАНТОМНОЕ ОБЛАКО ЭЛЕКТРОНОВ (Эмерджентная акустическая интерференция)
  // Те же 4 импульса, пропущенные через 3/16 дилей с обратной связью в правом канале.
  // В сумме с Track 1A рождает плотное, самоорганизующееся 16-дольное переливающееся стерео-облако!
  // --------------------------------------------------------------------------
  s("<[click*4]!40 [click*4]!40 [click*4]!40 [click*4]!15 ~!5>")
    .hpf(4500)
    .crush(6)
    .delay(0.75).delaytime(3/16).delayfeedback(0.68)
    .pan(0.75)
    .gain("<0.3!40 0.4!40 0.48!40 0.18!15 0!5>"),

  // Одиночные квантовые синусоидальные фотоны
  s("<sine!40 sine!40 sine!40 ~!20>")
    .note("<[d6 a6 c7] [f6 c7 e7] [g6 d7 f7] [a6 e7 g7]>".scramble())
    .decay(0.04).sustain(0)
    .pan("<0.15 0.85 0.3 0.7>")
    .gain("<0.3!40 0.28!40 0.32!40 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ТЕПЛЫЙ 5-HT ТРАНСОВЫЙ ПЭД (Эйфорический подъем Dm9 - G13 - Bbmaj7 - Am7)
  // Создает бесконечное ощущение гармонического полета и растворения
  // --------------------------------------------------------------------------
  s("<sine!40 sine!40 sine!40 sine!15 ~!5>")
    .note("<[d3,f3,a3,c4,e4] [g3,bb3,d4,f4,a4] [bb2,d3,f3,a3,c4] [a2,c3,e3,g3,b3]>")
    .attack(0.4).release(0.9)
    .lpf("<700 1100 1600 2200 1200 600>")
    .room(0.75).size(0.85)
    .gain("<0.4!40 0.48!40 0.54!40 0.28!15 0!5>"),

  // --------------------------------------------------------------------------
  // TRACK 3: 4-ON-THE-FLOOR ПАНЧЕВАЯ ТРАНС-БОЧКА (Углеродный каркас C10)
  // Прямой плотный трансовый кик с четким кликом
  // --------------------------------------------------------------------------
  s("<~!32 [~ bd:4]*2!8 [bd:4*4]!40 [bd:4*4]!40 [bd:4*2]!15 ~!5>")
    .gain(0.95),

  // --------------------------------------------------------------------------
  // TRACK 4: ROLLING TRANCE BASSLINE (K-B-B-B Грув)
  // 16-дольный роллинг бас с акцентом на слабые доли, сливающийся с бочкой в локомотив
  // --------------------------------------------------------------------------
  s("<~!40 [~ saw*3]*4!40 [~ saw*3]*4!40 [~ saw*2]*4!15 ~!5>")
    .note("<d1!4 f1!4 g1!4 eb1!4>")
    .decay(0.13).sustain(0.04)
    .lpf("<250 400 650 900 1200 700 400>")
    .lpq(3.5)
    .distort(0.3)
    .pan(0.5)
    .gain("<0!40 0.78!40 0.88!40 0.45!15 0!5>"),

  // Фундаментальный саб-бас (45 Гц чистый синус)
  s("<~!40 sine*4!40 sine*4!40 sine*2!15 ~!5>")
    .note("<d1!4 f1!4 g1!4 eb1!4>")
    .decay(0.22).sustain(0.18)
    .lpf(95)
    .gain("<0!40 0.88!40 0.94!40 0.5!15 0!5>"),

  // --------------------------------------------------------------------------
  // TRACK 5: ОТКРЫТЫЙ ТРАНСОВЫЙ ХЭТ НА СЛАБУЮ ДОЛЮ (Offbeat Energy)
  // Прорезающий воздух классический трансовый оффбит
  // --------------------------------------------------------------------------
  s("<~!56 [~ oh]*4!24 [~ oh]*4!40 ~!20>")
    .hpf(1800)
    .gain("<0!56 0.62!24 0.72!40 0!20>"),

  // --------------------------------------------------------------------------
  // TRACK 6: ИНДОЛЬНОЕ КОЛЬЦО — ФАЗОВОЕ СЛИЯНИЕ 5/16 И 6/16
  // Пиррол слева, бензол справа — их взаимные эхо-отражения встречаются в центре!
  // --------------------------------------------------------------------------
  // Пиррол (5/16) в левом ухе с перекрестным дилеем
  s("<~!40 [rim(5,16)]!40 [rim(5,16)]!40 [rim(5,16)]!15 ~!5>")
    .hpf(700)
    .pan(0.2)
    .delay(0.4).delaytime(2/16)
    .gain("<0!40 0.65!40 0.75!40 0.3!15 0!5>"),

  // Бензол (6/16) в правом ухе с перекрестным дилеем
  s("<~!40 [metal:2(6,16)]!40 [metal:2(6,16)]!40 [metal:2(3,16)]!15 ~!5>")
    .hpf(900).lpf(3600)
    .pan(0.8)
    .delay(0.4).delaytime(3/16)
    .gain("<0!40 0.5!40 0.58!40 0.25!15 0!5>"),

  // --------------------------------------------------------------------------
  // TRACK 7: ГИПНОТИЧЕСКИЙ КАСКАДНЫЙ ТРАНС-АРПЕДЖИО (Liquid-to-Trance Arp)
  // Разнообразные 16-дольные контуры с плавно раскрывающимся фильтром и jux-панорамой
  // --------------------------------------------------------------------------
  s("<triangle*2!40 [triangle*2]!40 [triangle*2]!40 triangle!15 ~!5>")
    .note("<[0 4 7 11 2 6 9 12 4 7 11 14 7 11 14 16] [14 11 7 4 12 9 6 2 11 7 4 0 9 6 4 2] [0 7 12 7 2 9 14 9 4 11 16 11 6 12 18 12] [7 11 9 6 4 7 6 2 0 4 2 1 0 2 4 7]>".scale("d4:dorian"))
    .decay(0.09).sustain(0)
    .lpf("<400 800 1600 3200 6500 4500 2200 800>")
    .lpq(2.5)
    .delay(0.42).delaytime(2/16).delayfeedback(0.55)
    .jux(rev)
    .gain("<[0.55 0.35 0.5 0.4]*4>")
    .gain("<0.3!40 0.45!40 0.72!40 0.3!15 0!5>"),

  // --------------------------------------------------------------------------
  // TRACK 8: ПАРЯЩИЙ ЭЙФОРИЧЕСКИЙ ТРАНС-ЛИД (Главная узнаваемая тема)
  // Мощный, поющий суперпил в ладу D Dorian с объемным аналоговым дилеем
  // --------------------------------------------------------------------------
  s("<~!60 [saw/2]!20 saw!40 [saw/2]!15 ~!5>")
    .note("<[~ 4 ~ [6 7]] [8 ~ 7 ~]  [9 ~ 8 7] [5 ~ 4 ~]  [3 ~ 4 5] [4 ~ 2 ~]  [1 ~ 2 3] [4 6 8 7]>".scale("d4:dorian"))
    .attack(0.02).decay(0.32).sustain(0.4).release(0.35)
    .lpf("<1200 2400 4800 6500 3500 1500>")
    .lpq(2.2)
    .delay(0.45).delaytime(3/16).delayfeedback(0.52)
    .jux(rev)
    .room(0.5).size(0.75)
    .gain("<0!60 0.55!20 0.8!40 0.35!15 0!5>"),

  // --------------------------------------------------------------------------
  // TRACK 9: ШЕЛКОВИСТЫЙ ХРУСТАЛЬНЫЙ КОЛОКОЛЬЧИК (5-OH Кислород: мягкое мерцание)
  // Нежный синус в дальнем поле реверберации, не бьет по ушам
  // --------------------------------------------------------------------------
  s("<~!40 sine!40 sine!40 sine!15 ~!5>")
    .note("<[~ ~ ~ [d6,a6]] [~ ~ ~ [e6,b6]] [~ ~ ~ [f6,c7]] [~ ~ ~ [g6,d7]]>")
    .attack(0.02).decay(0.38).sustain(0)
    .lpf(1800)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain("<0!40 0.22!40 0.28!40 0.12!15 0!5>")
)
