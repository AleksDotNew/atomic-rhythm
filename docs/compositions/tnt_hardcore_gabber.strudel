// ============================================================================
// TNT (2,4,6-TRINITROTOLUENE, C7H5N3O6) — HARDCORE TECHNO / METAL / GABBER (175 BPM)
// Powered by Dirt-Samples: gabba, gtr, hoover, metal, industrial, future, cr, sd, cp, hh
// Chemical Architecture:
// 1. Central Benzene Ring (C6): Monolithic 4-on-the-floor 175 BPM Gabber Kick (gabba:0)
// 2. 3 Nitro Groups (-NO2 at 2,4,6): Crushing Drop D Heavy Metal Riff (gtr:2 + saw chug)
// 3. Methyl Group (-CH3 at C1): Rapid 16th-note Blast Beats & Industrial metal clatter
// 4. 6 Oxygen Atoms (O6): Piercing Alpha Juno "Mentasm" Hoover Rave Lead (hoover:0)
// 5. Shockwave Detonation (6,900 m/s): Massive pitch-dive roll fills, bitcrush & explosion
// Key: D Minor / Drop D | Tempo: 175 BPM
// ============================================================================

setcps(175 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// TIMELINE (64 cycles @ 175 BPM, ~1:28):
// Phase 1 (cycles 0-7):   Зарядка ядра: глухой пульс бензола, щебет метила
// Phase 2 (cycles 8-15):  Ввод нитрогрупп: тяжелый гитарный палм-мьют, разгон снейров
// Phase 3 (cycles 16-39): ДЕТОНАЦИЯ / GABBER DROP: сокрушительный кик, гитары, ревущий хувер
// Phase 4 (cycles 40-47): Брейкдаун / Резонанс: гитарный рифф в реверберации, затишье
// Phase 5 (cycles 48-63): Ударная волна 6900 м/с: максимальный Gabber blast beat & финал
// ----------------------------------------------------------------------------

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: БЕНЗОЛЬНОЕ КОЛЬЦО (C6) — СОКРУШИТЕЛЬНЫЙ GABBER KICK
  // Жесткая, перегруженная габбер-бочка с пулеметными сбивками перед дропами
  // --------------------------------------------------------------------------
  s("<[gabba:0 ~ ~ ~]!4 [gabba:0 ~ gabba:0 ~]!4 [gabba:0!4]!7 [gabba:0*2 gabba:0*2 gabba:0*4 gabba:0*4]!1 [gabba:0!4]!24 [gabba:0 ~ ~ ~]!6 [gabba:0*2 gabba:0*2 gabba:0*4 gabba:0*8]!2 [gabba:0!4]!15 [gabba:0*8]!1>")
    .lpf("<500!4 800!4 2500!8 8000!24 600!6 3500!2 8000!16>")
    .distort("<0.3!8 0.5!8 0.75!24 0.2!6 0.6!2 0.85!16>")
    .shape(0.7)
    .gain("<0.6!4 0.75!4 0.9!8 0.95!24 0!6 0.8!2 0.98!16>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ТРИ НИТРОГРУППЫ (-NO2) — ТЯЖЕЛЫЙ МЕТАЛ-РИФФ (Сэмпл gtr:2)
  // Настоящий сэмпл перегруженной электрогитары в строе Drop D (D1-F1-G1-Ab1-C1)
  // --------------------------------------------------------------------------
  note("<[d1 d1 ~ d1] [d1 ~ f1 d1] [g1 ~ ab1 g1] [f1 d1 c1 ~] [d1 d1 ~ d1] [f1 ~ g1 ab1] [d1 ~ d1 d1] [f1 eb1 d1 ~]>")
    .s("gtr:2")
    .decay(0.2).sustain(0.15)
    .lpf("<800!8 2400!8 6500!24 1600!8 7500!16>")
    .room("<0.2!40 0.75!8 0.25!16>").size(0.85)
    .delay("<0.1!40 0.45!8 0.15!16>").delaytime(3/16).delayfeedback(0.55)
    .pan(0.35)
    .gain("<0!8 0.8!8 0.88!24 0.7!8 0.92!16>"),

  // --------------------------------------------------------------------------
  // TRACK 3: СУБ-ПАНЧ ГИТАРНОГО СТЕКА (Перегруженная низкая пила)
  // Слой массивного джент-низа в стиле Mick Gordon / Doom OST для плотности риффа
  // --------------------------------------------------------------------------
  note("<[d1 d1 ~ d1] [d1 ~ f1 d1] [g1 ~ ab1 g1] [f1 d1 c1 ~] [d1 d1 ~ d1] [f1 ~ g1 ab1] [d1 ~ d1 d1] [f1 eb1 d1 ~]>")
    .s("saw")
    .decay(0.16).sustain(0.08)
    .distort(0.85)
    .lpf("<600!8 1800!8 3200!24 1200!8 3500!16>")
    .lpq(4)
    .pan(0.65)
    .gain("<0!8 0.72!8 0.82!24 0.55!8 0.86!16>"),

  // --------------------------------------------------------------------------
  // TRACK 4: 6 АТОМОВ КИСЛОРОДА — РЕЙВ-ХУВЕР (Alpha Juno Mentasm hoover:0)
  // Культовый зловещий рэйв-лид 90-х, символизирующий раскаленный окислитель
  // --------------------------------------------------------------------------
  note("<[~ d3 ~ f3] [g3 ~ ab3 ~] [g3 ~ f3 ~] [eb3 ~ d3 ~]>")
    .s("hoover:0")
    .decay(0.32).sustain(0.5)
    .lpf("<1200!16 4200!24 1800!8 6000!16>")
    .lpq(2.8)
    .distort(0.35)
    .room(0.5).size(0.7)
    .pan(0.5)
    .jux(rev)
    .gain("<0!16 0.75!24 0.3!8 0.82!16>"),

  // --------------------------------------------------------------------------
  // TRACK 5: МЕТИЛЬНАЯ ГРУППА (-CH3) — БЛАСТБИТ И ВЫСОКОСКОРОСТНЫЕ ХЭТЫ
  // Вибрации легких водородов метила: 16-дольный шелест и оффбит-хэт
  // --------------------------------------------------------------------------
  s("hh*16")
    .velocity("<[0.25 0.75 0.35 0.9 0.25 0.8 0.4 0.95]*2>")
    .hpf(4500)
    .pan(0.7)
    .gain("<0!4 0.5!12 0.62!24 0.3!8 0.65!16>"),

  // Оффбитный открытый хэт (драйв 175 BPM):
  s("<~!8 [~ oh ~ oh]!24 ~!8 [~ oh ~ oh]!24>")
    .hpf(3500)
    .decay(0.2)
    .gain("<0!8 0.68!24 0!8 0.72!16>"),

  // --------------------------------------------------------------------------
  // TRACK 6: АТОМАРНЫЙ СКРЕЖЕТ — ИНДУСТРИАЛЬНЫЙ МЕТАЛЛ (metal & industrial)
  // Лязг и скрежет кристаллической решетки ТНТ
  // --------------------------------------------------------------------------
  s("<[metal:1(5,16)] [metal:3(7,16)] [industrial:2(5,16)] [metal:0(7,16)]>")
    .hpf(2200)
    .pan("<0.2 0.8 0.3 0.7>")
    .gain("<0.3!8 0.45!8 0.52!24 0.25!8 0.55!16>"),

  // --------------------------------------------------------------------------
  // TRACK 7: ХАРДКОРНЫЙ СНЕЙР / КЛЭП (Стена огня на 2 и 4 долю)
  // --------------------------------------------------------------------------
  s("<~!8 [~ [sd,cp] ~ [sd,cp]]!7 [~ [sd,cp] [sd*4] [sd*8]]!1 [~ [sd,cp] ~ [sd,cp]]!24 ~!6 [sd*2 sd*2 sd*4 sd*8]!2 [~ [sd,cp] ~ [sd,cp]]!15 [sd*16]!1>")
    .hpf(200)
    .distort(0.4)
    .room(0.3)
    .gain("<0!8 0.75!8 0.82!24 0!6 0.8!2 0.85!16>"),

  // --------------------------------------------------------------------------
  // TRACK 8: ИНДУСТРИАЛЬНЫЙ САБ-БАС (40-60 Гц основа под гитарами)
  // --------------------------------------------------------------------------
  note("<d1!2 f1!2 g1!2 eb1!2>")
    .s("saw")
    .decay(0.28).sustain(0.12)
    .lpf(280)
    .lpq(3)
    .gain("<0!8 0.75!8 0.85!24 0!8 0.88!16>"),

  // --------------------------------------------------------------------------
  // TRACK 9: ДЕТОНАЦИОННАЯ ВОЛНА — КРЭШИ И ВСПЫШКИ (future:1, cr)
  // Вспышка на тактах 15 и 47 прямо перед дропом
  // --------------------------------------------------------------------------
  s("<~!15 [future:1, cr]!1 ~!31 [future:1, cr]!1 ~!16>")
    .hpf(600)
    .crush(5)
    .distort(0.4)
    .room(0.8).size(0.9)
    .gain(0.95),

  // Крэш на начало 8-тактовых квадратов
  s("<cr ~!7>")
    .gain("<0!16 0.65!24 0!8 0.7!16>")
)
