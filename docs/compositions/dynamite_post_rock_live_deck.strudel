// ============================================================================
// DYNAMITE (NITROGLYCERIN IN DIATOMITE) — POST-ROCK LIVE DECK (72 BPM)
// Inspired by: Félperc ("Escape to the World of Silence", "Follow the Compass")
// Powered by Dirt-Samples: gretsch (acoustic kit), gtr (clean/ovrd/dist), tink, wind, pebbles, cr
// 
// Interactive Sliders:
// - crescendo: 0.0 = хрупкий мир безмолвия -> 1.0 = эпическая стена звука (Wall of Sound)!
// - guitarDelay: глубина ленточного эхо и отражений гитарных переборов
// - shimmerGain: громкость парящих хрустальных капель нитроглицерина (tink)
// ============================================================================

setcps(72 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// ИНТЕРАКТИВНЫЕ СЛАЙДЕРЫ УПРАВЛЕНИЯ КРЕЩЕНДО:
// ----------------------------------------------------------------------------
const crescendo = slider(0.35, 0, 1, 0.01)   // Ползунок пост-рок крещендо (0.0 -> 1.0)
const guitarDelay = slider(0.48, 0, 0.8, 0.01) // Интенсивность ленточного дилея
const shimmerGain = slider(0.5, 0, 1, 0.01)   // Хрустальные обертоны (tink)

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: КИЗЕЛЬГУР (ДИАТОМИТ) — ВЕТЕР И КРЕМНИСТЫЙ МИКРО-ШЕЛЕСТ
  // --------------------------------------------------------------------------
  s("wind:3/8")
    .lpf(1200 + crescendo * 1000)
    .room(0.9).size(0.95)
    .pan(0.3)
    .gain(0.25 - crescendo * 0.15),

  s("<[pebbles:0(3,8)] [pebbles:0(5,16)]>")
    .hpf(3000)
    .pan(0.75)
    .room(0.7)
    .gain(0.28 - crescendo * 0.18),

  // --------------------------------------------------------------------------
  // TRACK 2: ГЛИЦЕРИНОВЫЙ КАРКАС (C3) — НЕОДНООБРАЗНОЕ ГИТАРНОЕ АРПЕДЖИО
  // 16-тактовый развивающийся цикл переборов чистой электрогитары
  // --------------------------------------------------------------------------
  note("<[d3 a3 f4 e4 a4 f4] [bb2 f3 d4 e4 a4 d4] [f2 c3 a3 e4 g4 a3] [c3 g3 e4 d4 g4 e4] [d3 f3 a3 c4 e4 a4] [bb2 d3 f3 a3 d4 f4] [f2 a2 c3 e4 a4 c5] [c3 g3 c4 d4 e4 g4] [d4 a4 f5 ~ a4 e5] [d5 ~ f5 e5 a5 d5] [c5 a4 e5 ~ g5 a4] [e5 d5 c5 ~ g4 c5] [a4 f4 d4 e4 f4 a4] [bb4 f4 d4 e4 f4 a4] [c5 a4 f4 g4 a4 c5] [d5 c5 g4 e4 d4 c4]>")
    .s("gtr:0")
    .decay(0.4).sustain(0.2)
    .lpf(2400 + crescendo * 3500)
    .delay(guitarDelay).delaytime(3/16).delayfeedback(0.65)
    .room(0.75).size(0.85)
    .pan(0.35)
    .gain(0.85 - crescendo * 0.25),

  // --------------------------------------------------------------------------
  // TRACK 3: НАРАСТАНИЕ ТЕПЛОГО ОВЕРДРАЙВА (gtr:1)
  // --------------------------------------------------------------------------
  note("<[d3 a3 f4 e4 a4 f4] [bb2 f3 d4 e4 a4 d4] [f2 c3 a3 e4 g4 a3] [c3 g3 e4 d4 g4 e4] [d3 f3 a3 c4 e4 a4] [bb2 d3 f3 a3 d4 f4] [f2 a2 c3 e4 a4 c5] [c3 g3 c4 d4 e4 g4] [d4 a4 f5 ~ a4 e5] [d5 ~ f5 e5 a5 d5] [c5 a4 e5 ~ g5 a4] [e5 d5 c5 ~ g4 c5] [a4 f4 d4 e4 f4 a4] [bb4 f4 d4 e4 f4 a4] [c5 a4 f4 g4 a4 c5] [d5 c5 g4 e4 d4 c4]>")
    .s("gtr:1")
    .decay(0.35).sustain(0.25)
    .lpf(4200)
    .delay(guitarDelay * 0.9).delaytime(3/16).delayfeedback(0.6)
    .room(0.65).size(0.8)
    .pan(0.65)
    .gain(crescendo * 0.82),

  // --------------------------------------------------------------------------
  // TRACK 4: КАТАКЛИЗМ / СТЕНА ЗВУКА (gtr:2) — ДИСТОРШН В КРЕЩЕНДО
  // --------------------------------------------------------------------------
  note("<[d3 a3 f4 e4 a4 f4] [bb2 f3 d4 e4 a4 d4] [f2 c3 a3 e4 g4 a3] [c3 g3 e4 d4 g4 e4] [d3 f3 a3 c4 e4 a4] [bb2 d3 f3 a3 d4 f4] [f2 a2 c3 e4 a4 c5] [c3 g3 c4 d4 e4 g4] [d4 a4 f5 ~ a4 e5] [d5 ~ f5 e5 a5 d5] [c5 a4 e5 ~ g5 a4] [e5 d5 c5 ~ g4 c5] [a4 f4 d4 e4 f4 a4] [bb4 f4 d4 e4 f4 a4] [c5 a4 f4 g4 a4 c5] [d5 c5 g4 e4 d4 c4]>")
    .s("gtr:2")
    .decay(0.45).sustain(0.35)
    .distort(0.2 + crescendo * 0.45)
    .lpf(3000 + crescendo * 3500)
    .room(0.7).size(0.9)
    .delay(guitarDelay * 0.8).delaytime(3/16).delayfeedback(0.55)
    .pan(0.5)
    .jux(rev)
    .gain(crescendo > 0.5 ? (crescendo - 0.5) * 1.8 : 0),

  // Соло-лид в кульминации:
  note("<[a4 ~ c5 ~ d5 ~ e5 ~] [f5 ~ e5 ~ d5 ~ c5 ~] [e5 ~ f5 ~ g5 ~ a5 ~] [g5 ~ f5 ~ e5 ~ d5 ~]>")
    .s("gtr:2")
    .attack(0.05).decay(0.6).sustain(0.5)
    .lpf(4800)
    .delay(0.5).delaytime(3/16).delayfeedback(0.65)
    .room(0.8).size(0.95)
    .pan(0.55)
    .gain(crescendo > 0.6 ? (crescendo - 0.6) * 2.0 : 0),

  // --------------------------------------------------------------------------
  // TRACK 5: ТРИ НИТРАТНЫЕ ГРУППЫ (-NO3) — МЕЛОДИЧЕСКИЙ ПОСТ-РОК БАС
  // 8-тактовый поющий бас с октавными прыжками и контрапунктом
  // --------------------------------------------------------------------------
  note("<[d2 ~ a2 ~ f2 ~ [e2 d2]] [bb1 ~ f2 ~ d2 ~ [c2 bb1]] [f1 ~ c2 ~ a2 ~ [g2 f2]] [c2 ~ g2 ~ e2 ~ [d2 c2]] [d2 a2 d3 ~ c3 ~ a2 ~] [bb1 f2 bb2 ~ a2 ~ f2 ~] [f1 c2 f2 ~ e2 ~ c2 ~] [c2 g2 c3 ~ [b2 a2] [g2 e2]]>")
    .s("saw")
    .decay(0.45).sustain(0.35)
    .lpf(400 + crescendo * 1000)
    .lpq(2.5)
    .distort(0.1 + crescendo * 0.55)
    .room(0.4).size(0.6)
    .pan(0.5)
    .gain(0.55 + crescendo * 0.38),

  // Фундаментальный саб-бас (40-60 Гц):
  note("<d1!2 bb0!2 f1!2 c1!2>")
    .s("sine")
    .decay(0.5).sustain(0.4)
    .lpf(95)
    .gain(0.55 + crescendo * 0.38),

  // --------------------------------------------------------------------------
  // TRACK 6: КРИСТАЛЬНЫЙ ШИММЕР — СЭМПЛ TINK (Хрустальные капли)
  // --------------------------------------------------------------------------
  note("<[~ a5 ~ e6] [~ f5 ~ a5] [~ g5 ~ c6] [~ e5 ~ d6] [~ a5 ~ c6] [~ d6 ~ f6] [~ c6 ~ e6] [~ g5 ~ d6]>")
    .s("tink")
    .decay(0.5)
    .lpf(3500)
    .delay(0.5).delaytime(3/16).delayfeedback(0.7)
    .room(0.85).size(0.92)
    .pan("<0.2 0.8 0.3 0.7>")
    .gain(shimmerGain * (0.3 + crescendo * 0.6)),

  // --------------------------------------------------------------------------
  // TRACK 7: АКУСТИЧЕСКИЕ БАРАБАНЫ GRETSCH
  // --------------------------------------------------------------------------
  // Кик:
  s("<[gretsch:13 ~ ~ ~ gretsch:13 ~ ~ ~] [gretsch:13 ~ gretsch:13 ~ gretsch:13 ~ ~ ~]>")
    .lpf(3000)
    .room(0.3)
    .gain(0.45 + crescendo * 0.5),

  // Щеточный снейр:
  s("~ gretsch:3 ~ gretsch:2 ~ gretsch:3 gretsch:2 ~")
    .hpf(400)
    .room(0.5).size(0.7)
    .pan(0.45)
    .gain(crescendo < 0.7 ? 0.7 : 0.2),

  // Мощный акустический снейр в крещендо:
  s("~ gretsch:20 ~ gretsch:20")
    .hpf(250)
    .room(0.65).size(0.85)
    .pan(0.5)
    .gain(crescendo > 0.5 ? (crescendo - 0.5) * 1.8 : 0),

  // Шелест хэта / райда:
  s("gretsch:19*6")
    .velocity("<[0.3 0.6 0.4 0.7 0.35 0.65]*2>")
    .hpf(3500)
    .pan(0.65)
    .gain(0.4 + crescendo * 0.42),

  // Крэш:
  s("<cr ~!3>")
    .gain(crescendo > 0.6 ? 0.75 : 0),

  // --------------------------------------------------------------------------
  // TRACK 8: КИНЕМАТОГРАФИЧЕСКИЙ ЭМБИЕНТ-ПЭД (Dm9 - Bbmaj7 - Fmaj7 - C)
  // --------------------------------------------------------------------------
  note("<[d3,a3,f4,c5,e5] [bb2,f3,d4,a4,e5] [f2,c3,a3,e4,g4] [c3,g3,e4,d4,g4]>")
    .s("sine")
    .attack(0.8).release(1.2)
    .lpf(800 + crescendo * 1800)
    .room(0.88).size(0.95)
    .gain(0.4 + crescendo * 0.4)
)
