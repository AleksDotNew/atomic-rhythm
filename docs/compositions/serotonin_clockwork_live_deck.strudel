// ============================================================================
// SEROTONIN (LIVE PERFORMANCE DECK) — CLOCKWORK GEAR TRANCE (138 BPM)
// New Harmony & Melody: F# Minor / F# Dorian (F#m9 - Dmaj7#11 - Bm9 - C#m7)
// FEATURING: Heavy Pendulum-style distorted guitar riff!
// Immediate jam session version: all instruments active in full euphoria!
// ============================================================================

setcps(138 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// ----------------------------------------------------------------------------
// ИНТЕРАКТИВНЫЕ РЕГУЛЯТОРЫ (Именованные слайдеры верхнего уровня)
// ----------------------------------------------------------------------------
const bassCutoff = slider(3400, 400, 8000, 50)
const guitarDist = slider(0.78, 0.4, 0.95, 0.02)
const arpCutoff  = slider(2800, 400, 7000, 50)
const sparkGain  = slider(0.58, 0, 0.9, 0.02)

stack(
  // 1. Углеродный маховик (4-on-the-floor кик)
  s("bd:4*4")
    .gain(0.95),

  // 2. K-B-B-B Rolling Trance Bass в F# Minor
  note("<[~ f#1*3]!4 [~ d1*3]!4 [~ b0*3]!4 [~ c#1*3]!4>")
    .s("saw")
    .decay(0.13).sustain(0.04)
    .lpf(bassCutoff)
    .lpq(3.5)
    .distort(0.3)
    .pan(0.5)
    .gain(0.88),

  // 3. Саб-бас сердечника (46 Гц F#)
  note("<f#1!4 d1!4 b0!4 c#1!4>")
    .s("sine")
    .decay(0.22).sustain(0.18)
    .lpf(95)
    .gain(0.92),

  // 4. ТЯЖЕЛЫЙ ГИТАРНЫЙ РИФФ В СТИЛЕ PENDULUM (Rob Swire Drop)
  // Dug-dug-dug... dug-dug-dug... DAH! DAH! в духе Showdown / Self vs Self
  note("<[f#1!3 ~ f#1!3 ~] [f#1 f#1 [a1,e2] ~]  [f#1!3 ~ f#1!3 ~] [[d1,a1] ~ [c#1,g#1] ~]  [f#1!3 ~ f#1!3 ~] [f#1 f#1 [b1,f#2] ~]  [f#1!2 a1!2 b1!2 c#2!2] [[d2,a2]!2 [c#2,g#2]!2]>")
    .s("saw")
    .attack(0.005).decay(0.14).sustain(0.12).release(0.05)
    .lpf(2600) // Эмуляция кабинета Marshall/Mesa
    .lpq(4)
    .hpf(120)  // Срез саб-мусора
    .distort(guitarDist) // Высокогейновый дисторшн
    .jux(rev)  // Дабл-трекинг по стереопанораме (стена звука)
    .gain(0.85),

  // 5. Открытый трансовый хэт на слабую долю
  s("[~ oh]*4")
    .hpf(1800)
    .gain(0.72),

  // 6A. 4 Тика храповика слева
  s("hh*4")
    .hpf(4000)
    .pan(0.25)
    .gain(0.48),

  // 6B. Эмерджентное облако электронов (3/16 эхо справа)
  s("click*4")
    .hpf(4500)
    .crush(6)
    .delay(0.75).delaytime(3/16).delayfeedback(0.68)
    .pan(0.75)
    .gain(0.46),

  // 7. Пиррольное кольцо (5 зубцов, вращение 0..4)
  s("<rim(5,16) rim(5,16,1) rim(5,16,2) rim(5,16,3) rim(5,16,4)>")
    .hpf(700)
    .pan(0.2)
    .delay(0.4).delaytime(2/16)
    .gain(0.72),

  // 8. Бензольное кольцо (6 зубцов: мягкий полый резонатор can:1)
  s("<can:1(6,16) can:1(6,16,2) can:1(6,16,4) can:1(6,16,1) can:1(6,16,3)>")
    .hpf(500).lpf(2200)
    .pan(0.8)
    .delay(0.35).delaytime(3/16).delayfeedback(0.4)
    .gain(0.52),

  // 9. Искры соприкосновения зубцов (Collision Engine)
  s("<industrial:4(11,16) industrial:4(11,16,3) industrial:4(11,16,6) industrial:4(11,16,2)>")
    .hpf(1200)
    .crush(5)
    .distort(0.32)
    .pan("<0.2 0.8 0.35 0.65 0.5 0.85>")
    .gain(sparkGain),

  // 10. Полное 16-дольное каскадное арпеджио в F# Minor (4 эволюционирующих контура)
  note("<[0 4 7 11 2 6 9 12 4 7 11 14 7 11 14 16] [14 11 7 4 12 9 6 2 11 7 4 0 9 6 4 2] [0 7 12 7 2 9 14 9 4 11 16 11 6 12 18 12] [7 11 9 6 4 7 6 2 0 4 2 1 0 2 4 7]>".scale("f#4:minor"))
    .s("triangle")
    .decay(0.09).sustain(0)
    .lpf(arpCutoff)
    .lpq(2.5)
    .delay(0.42).delaytime(2/16).delayfeedback(0.55)
    .jux(rev)
    .gain(0.75),

  // 11. ГЛАВНАЯ МЕЛОДИЯ (F# Minor Celestial Lead)
  note("<[~ 4 ~ [6 7]] [8 ~ 7 ~]  [9 ~ 8 7] [6 ~ 4 ~]  [5 ~ 4 3] [4 ~ 2 ~]  [1 ~ 2 3] [4 6 8 7]>".scale("f#4:minor"))
    .s("saw")
    .attack(0.02).decay(0.32).sustain(0.4).release(0.35)
    .lpf(3400)
    .lpq(2.2)
    .delay(0.45).delaytime(3/16).delayfeedback(0.52)
    .jux(rev)
    .room(0.5).size(0.75)
    .gain(0.8),

  // 12. Резонаторный корпус (Теплый пэд F#m9 - Dmaj7#11 - Bm9 - C#m7)
  note("<[f#3,a3,c#4,e4,g#4] [d3,f#3,a3,c#4,g#4] [b2,d3,f#3,a3,c#4] [c#3,e3,g#3,b3,d#4]>")
    .s("sine")
    .attack(0.4).release(0.9)
    .lpf(1600)
    .room(0.75).size(0.85)
    .gain(0.52),

  // 13. Мягкий хрустальный колокольчик (5-OH Кислород в тонике F#)
  note("<[~ ~ ~ [f#6,c#7]] [~ ~ ~ [g#6,d7]] [~ ~ ~ [a6,e7]] [~ ~ ~ [b6,f#7]]>")
    .s("sine")
    .attack(0.02).decay(0.38).sustain(0)
    .lpf(1800)
    .room(0.85).size(0.9)
    .pan(0.85)
    .gain(0.28)
)
