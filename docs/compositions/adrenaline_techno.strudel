// ============================================================================
// ADRENALINE (CNC[C@@H](C1=CC(=C(C=C1)O)O)O) — BERLIN & RUSSIAN INDUSTRIAL TECHNO
// Style: Berlin & Russian Techno (Monasterio / Nina Kraviz) + Rhythmic Noise (Ancient Methods, Orphx)
// BPM: 160 | Meter: 4/4 | Key: D Phrygian | Duration: ~3:45 (150 cycles)
// ============================================================================

// 1. Setup Tempo & Sample Libraries:
setcps(160 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

// Optional Switchangel Prebake (раскомментируйте, если не загружен через настройки Strudel):
// await import('https://cdn.jsdelivr.net/gh/switchangel/strudel-scripts@main/allscripts(deprecated).js')

// ============================================================================
// DRAMATURGY TIMELINE (4 PHASES across 150 cycles @ 160 BPM):
// Phase 1 (0:00 - 1:00, cycles 0-39):   Генезис электронов (квантовые щелчки, глитч, саб-гул)
// Phase 2 (1:00 - 2:00, cycles 40-79):  Сборка молекулы (26 атомов, катехоловое кольцо 6/8, бочка 4x4)
// Phase 3 (2:00 - 3:00, cycles 80-119): Адреналиновый пик (Russian/Berlin Techno, нойз, кислотное арпеджио)
// Phase 4 (3:00 - 3:45, cycles 120-150): Распад и растворение адреналина (фильтрация, эхо, затухание)
// ============================================================================

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: ЭЛЕКТРОНЫ / КВАНТОВЫЕ ЩЕЛЧКИ (Микро-физика, 98 электронов)
  // Микроскопические гейгеровские импульсы, квантовые скачки между оболочками
  // --------------------------------------------------------------------------
  s("<[click(7,16,1) glitch(5,16,3)]!40 [click(11,16) glitch(7,16)]!40 [glitch(13,16)]!40 [click(3,16)]!30>")
    .hpf(3800)
    .crush("<5!40 5!40 4!40 7!30>")
    .pan(rand)
    .gain("<0.55!40 0.5!40 0.6!40 0.25!30>"),

  // Одиночные квантовые фотонные скачки (синусоидальные микро-точки)
  s("<sine!40 sine!40 sine!40 ~!30>")
    .note("<[d6 f6 a6 c7 eb7] [g6 d7 f7 bb7] [a6 c7 e7 g7] [d7 f7 a7]>".scramble())
    .decay(0.035).sustain(0)
    .pan("<0.15 0.85 0.3 0.7>")
    .gain("<0.38!40 0.3!40 0.35!40 0!30>"),

  // --------------------------------------------------------------------------
  // TRACK 2: УГЛЕРОДНЫЙ СКЕЛЕТ И 909 БОЧКА (9 атомов Углерода C9)
  // Прямая берлинская 4-на-4 бочка с плотным пробивным панчем
  // --------------------------------------------------------------------------
  s("<~!32 [~ bd:4]*2!8 [bd:4*4]!40 [bd:4*4]!40 [bd:4*2]!20 ~!10>")
    .gain(0.95),

  // --------------------------------------------------------------------------
  // TRACK 3: РУССКИЙ / БЕРЛИНСКИЙ САБ-РАМБЛ (Monasterio Low-End Rumble)
  // 16-дольный перегруженный реверберирующий саб-бас (частота катехолового резонанса)
  // --------------------------------------------------------------------------
  s("<~!40 [bd:4*16]!40 [bd:4*16]!40 [bd:4*8]!20 ~!10>")
    .lpf("<110!40 130!40 140!40 80!20 50!10>")
    .lpq(2.5)
    .distort(0.45)
    .gain("<0!40 0.75!40 0.85!40 0.5!20 0!10>")
    .pan(0.5),

  // --------------------------------------------------------------------------
  // TRACK 4: КОВАЛЕНТНЫЕ СВЯЗИ И ХИРАЛЬНЫЙ ЦЕНТР (Clap & Industrial Flam)
  // Мощный бэкбит на 2 и 4 долю с индустриальным пружинным откликом
  // --------------------------------------------------------------------------
  s("<~!48 [~ cp ~ cp]!32 [~ [cp, industrial:1] ~ [cp, industrial:1]]!40 [~ cp ~ ~]!20 ~!10>")
    .hpf(400)
    .room("<0.2!80 0.45!40 0.8!30>")
    .size(0.55)
    .gain("<0!48 0.72!32 0.82!40 0.4!20 0!10>"),

  // --------------------------------------------------------------------------
  // TRACK 5: 13 АТОМОВ ВОДОРОДА (H13 — Высокочастотные вибрирующие хэты)
  // Непрерывное 16-дольное движение легких атомов водорода с грувом
  // --------------------------------------------------------------------------
  s("<~!56 [hh*16]!24 [hh*16]!40 ~!30>")
    .velocity("<[0.2 0.6 0.35 0.7 0.25 0.65 0.4 0.75]*2>")
    .hpf(3000)
    .pan(0.4)
    .gain("<0!56 0.55!24 0.65!40 0!30>"),

  // Берлинский открытый хэт на слабую долю (driving offbeat sizzle)
  s("<~!80 [~ oh]*4!40 ~!30>")
    .hpf(1600)
    .gain(0.7),

  // --------------------------------------------------------------------------
  // TRACK 6: КАТЕХОЛОВОЕ КОЛЬЦО (6 атомов Углерода в бензольном кольце)
  // Полиметрический 6-дольный остинато против сетки 4/4 (Hands Productions / Ancient Methods)
  // --------------------------------------------------------------------------
  s("<~!40 [industrial:2(6,16)]!40 [industrial:2(6,16)]!40 [industrial:2(3,16)]!20 ~!10>")
    .hpf(700)
    .distort(0.42)
    .pan(0.3)
    .gain("<0!40 0.7!40 0.78!40 0.35!30>"),

  // --------------------------------------------------------------------------
  // TRACK 7: ДВА ФЕНОЛА -OH (Кислород C3 и C4 — Резонансные колокола)
  // Звонкие металлические отклики кислородных групп
  // --------------------------------------------------------------------------
  s("<~!64 [cb(3,16,2)]!16 [cb(5,16,1)]!40 ~!30>")
    .n("<[~ 7] [~ 10] [~ 12] [~ 9]>")
    .hpf(1200)
    .room(0.4)
    .gain("<0!64 0.55!16 0.65!40 0!30>")
    .pan(0.75),

  // --------------------------------------------------------------------------
  // TRACK 8: АМИН И РИТМИК-НОЙЗ (Азот N7 и боковая цепь — Broken Industrial Clang)
  // Ритмический нойз-паттерн (Orphx / Converter aesthetic)
  // --------------------------------------------------------------------------
  s("<~!80 [industrial:7(11,16,2)]!40 ~!30>")
    .distort(0.58)
    .crush(5)
    .hpf(900)
    .pan(0.65)
    .gain(0.72),

  // --------------------------------------------------------------------------
  // TRACK 9: АДРЕНАЛИНОВЫЙ ВСПЛЕСК — ACID / FM ARPEGGIO (D Phrygian)
  // Мотив синтезатора построен на атомных номерах: C=6, H=1, N=7, O=8 -> [0 1 3 5 3 7 8 7]
  // Нарастающий резонансный фильтр (срез открывается в пике и захлопывается при распаде)
  // --------------------------------------------------------------------------
  note("<d2 eb2 g2 bb2 g2 d3 eb3 d3>*2")
    .s("saw")
    .decay(0.12).sustain(0)
    .lpf("<400 800 1600 3200 4800 2400 1200 600>")
    .lpq(7.5)
    .distort(0.38)
    .pan(0.55)
    .gain("<0!80 0.72!40 0.4!20 0!10>"),

  // --------------------------------------------------------------------------
  // TRACK 10: ГЛУБИННЫЙ ТЕХНО-ГУЛ / ДРОН (50 Hz Russian Industrial Mains Drone)
  // Создает монолитную мрачную атмосферу подпольного бункера
  // --------------------------------------------------------------------------
  note("d1")
    .s("triangle")
    .lpf("<70 90 110 80 60>")
    .room(0.5).size(0.8)
    .gain("<0.3!40 0.45!40 0.5!40 0.2!30>")
)
