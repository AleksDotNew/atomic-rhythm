// ============================================================================
// TESTOSTERONE (17β-HYDROXYANDROST-4-EN-3-ONE, C19H28O2)
// PROGRESSIVE DJENT / HEAVY METAL (125 BPM)
// In the spirit of GOJIRA ("The Art of Dying", "Silvera", "Flying Whales")
// & MESHUGGAH ("Bleed", "Clockworks", "Rational Gaze")
//
// Chemical Architecture (Subatomic & Atomic Genesis to Molecular Wall of Sound):
// 1. Act I (cycles 0-15):   "Atomic Genesis" — Изолированные атомы: C (глубокий дрон),
//                           H (хрупкий акустический перебор с ленточным дилеем),
//                           O (высокие кристаллические обертоны tink/pebbles).
// 2. Act II (cycles 16-31):  "Covalent Nucleation" — Сближение атомов, первобытный шаманский
//                           том, нарастающий овердрайв, электронный пульс H (E(5,16))
//                           и сокрушительный Gojira Pick Scrape на 31-м такте.
// 3. Act III (cycles 32-55): "Cyclization of the Sterane Nucleus" — Замыкание колец A-B-C-D.
//                           Вступает 19/16 полиметр Мешугги (19 атомов Углерода!):
//                           рифф [3+3+3+3+3+4]/16 поверх несгибаемого 4/4 счета тарелок и снейра.
// 4. Act IV (cycles 56-79):  "17β-OH Wall of Sound" — Полное рубилово: пулеметные herta-бочки,
//                           стена звука перегруженных 8-струнных гитар (Drop C#),
//                           диссонансы C#-D-G и парящий мелодический лид 17-OH гидроксила.
// 5. Act V (cycles 80-95):   "Endocrine Binding & Doom Outro" — Сейсмический сладж-брейкдаун
//                           в духе финала Flying Whales, фидбек и возвращение в тишину.
//
// Tuning: Drop C# (C#1 - G#1 - C#2 - F#2) | Meter: 4/4 vs 19/16 Polymeter | Tempo: 125 BPM
// Total Duration: 96 cycles @ 125 BPM = ~3:04
// ============================================================================

setcps(125 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

stack(
  // --------------------------------------------------------------------------
  // TRACK 1: АТМОСФЕРА КВАНТОВОГО ВАКУУМА — ВЕТЕР И КРЕМНИСТЫЙ ШЕЛЕСТ
  // Создает бездонное кинематографическое пространство в интро и аутро
  // --------------------------------------------------------------------------
  s("wind:3/8")
    .lpf("<600!16 1200!16 2000!24 3500!24 800!16>")
    .room(0.95).size(0.98)
    .pan(0.3)
    .gain("<0.35!16 0.2!16 0.05!24 0!24 0.38!16>"),

  // Одиночные микро-столкновения атомов (Кислород / Водород):
  s("<[pebbles:0(3,8)]!16 [pebbles:0(5,16)]!16 ~!48 [pebbles:0(2,8)]!16>")
    .hpf(3500)
    .pan(0.75)
    .room(0.8)
    .gain("<0.3!16 0.2!16 0!48 0.25!16>"),

  // --------------------------------------------------------------------------
  // TRACK 2: ИЗОЛИРОВАННЫЙ ВОДОРОД (28H) — АКУСТИЧЕСКИЙ АТМОСФЕРНЫЙ ПЕРЕБОР
  // Протяжные ноты с ленточным дилеем и реверберацией, изображающие облако атомов H
  // Начинает кристально чисто (gtr:0) и постепенно насыщается перегрузом
  // --------------------------------------------------------------------------
  note("<[c#3 g#3 e4 d#4 g#3 e4] [c#3 a3 e4 f#4 a3 e4] [c#3 g#3 e4 d#4 g#3 e4] [b2 f#3 d4 e4 f#4 d4]>")
    .s("gtr:0")
    .decay(0.45).sustain(0.3)
    .lpf("<1800!16 3500!16 6500!24 2400!24 1600!16>")
    .delay(0.52).delaytime(3/16).delayfeedback(0.68)
    .room(0.82).size(0.9)
    .pan(0.25)
    .gain("<0.9!16 0.85!16 0!48 0.75!16>"),

  // Слой теплого трубного овердрайва при формировании связей (Фаза 2):
  note("<[c#3 g#3 e4 d#4 g#3 e4] [c#3 a3 e4 f#4 a3 e4] [c#3 g#3 e4 d#4 g#3 e4] [b2 f#3 d4 e4 f#4 d4]>")
    .s("gtr:1")
    .decay(0.38).sustain(0.25)
    .distort(0.35)
    .lpf(4200)
    .delay(0.45).delaytime(3/16).delayfeedback(0.55)
    .room(0.65).size(0.8)
    .pan(0.75)
    .gain("<0!16 0.78!16 0!48 0!16>"),

  // --------------------------------------------------------------------------
  // TRACK 3: GOJIRA PICK SCRAPE & МЕТАЛЛИЧЕСКИЙ СКРЕЖЕТ СВЯЗИ C3=O
  // Фирменный скрежет медиатора Gojira на стыках фаз и перед брейкдаунами
  // --------------------------------------------------------------------------
  s("<~!31 [metal:1*2]!1 ~!23 [metal:1*4]!1 ~!23 [metal:1*2]!1 ~!15>")
    .speed("<0.8 0.5 0.35 0.25>")
    .distort(0.85)
    .hpf(400).lpf(5000)
    .delay(0.35).delaytime(2/16).delayfeedback(0.6)
    .room(0.7)
    .gain(0.9),

  // Высокие обертоны кислорода 17-OH:
  s("<[~ tink:0 ~ tink:1]!16 [tink:0(3,8)]!16 ~!48 [~ tink:0 ~ ~]!16>")
    .hpf(4000)
    .delay(0.4).delaytime(3/16).delayfeedback(0.65)
    .room(0.85)
    .gain("<0.65!16 0.5!16 0!48 0.5!16>"),

  // --------------------------------------------------------------------------
  // TRACK 4: 19 УГЛЕРОДНЫХ АТОМОВ — MESHUGGAH 19/16 POLYMETRIC GUITAR CHUG
  // 19-дольный рифф [3 + 3 + 3 + 3 + 3 + 4]/16 в строе Drop C# (C#1 -> D1)
  // Квадротрекинг: сэмпл gtr:2 + ультра-тяжелая пила saw с дисторшном
  // --------------------------------------------------------------------------
  note("<~!32 [c#1!3 ~ c#1!3 ~ c#1!3 ~ c#1!3 ~ d1!4 ~]%19!24 [c#1!3 ~ d1!3 ~ c#1!3 ~ g1!3 ~ c#1!4 ~]%19!24 [c#1!4 ~!4 d1!4 ~!4]!16>")
    .s("gtr:2")
    .decay(0.12).sustain(0.15).release(0.06)
    .distort("<0!32 0.75!24 0.9!24 0.85!16>")
    .lpf("<1200!32 2800!24 4500!24 2200!16>")
    .lpq(3.5)
    .hpf(85)
    .pan(0.35)
    .gain("<0!32 0.88!24 0.94!24 0.85!16>"),

  // Слой плотного суб-дисторшна (правый канал для максимальной стерео-стены звука):
  note("<~!32 [c#1!3 ~ c#1!3 ~ c#1!3 ~ c#1!3 ~ d1!4 ~]%19!24 [c#1!3 ~ d1!3 ~ c#1!3 ~ g1!3 ~ c#1!4 ~]%19!24 [c#1!4 ~!4 d1!4 ~!4]!16>")
    .s("saw")
    .decay(0.14).sustain(0.18).release(0.08)
    .distort(0.8)
    .lpf("<1000!32 2200!24 3800!24 1600!16>")
    .lpq(4.2)
    .hpf(75)
    .pan(0.65)
    .gain("<0!32 0.82!24 0.9!24 0.82!16>"),

  // --------------------------------------------------------------------------
  // TRACK 5: ФУНДАМЕНТАЛЬНЫЙ СУБ-БАС (Drop C#1 = 34.6 Гц)
  // Чистый монолитный инфраниз, который давит в грудь без искажений
  // --------------------------------------------------------------------------
  note("<c#1!16 c#1!16 [c#1!3 ~ c#1!3 ~ c#1!3 ~ c#1!3 ~ d1!4 ~]%19!24 [c#1!3 ~ d1!3 ~ c#1!3 ~ g1!3 ~ c#1!4 ~]%19!24 [c#1!4 ~!4 d1!4 ~!4]!16>")
    .s("sine")
    .decay(0.4).sustain(0.4)
    .lpf(110)
    .gain("<0.5!16 0.75!16 0.92!24 0.98!24 0.9!16>"),

  // --------------------------------------------------------------------------
  // TRACK 6: БОЧКА (KICK) — MESHUGGAH HERTA & GOJIRA DOUBLE-BASS CRUSH
  // Фаза 1: молчит -> Фаза 2: шаманский том -> Фаза 3: 19/16 полиметр -> Фаза 4: стена
  // --------------------------------------------------------------------------
  s("<~!16 [gretsch:13 ~ ~ ~ gretsch:13 ~ ~ ~]!16 [[bd,gretsch:13]!3 ~ [bd,gretsch:13]!3 ~ [bd,gretsch:13]!3 ~ [bd,gretsch:13]!3 ~ [bd,gretsch:13]!4 ~]%19!24 [bd*16]!24 [bd ~ ~ ~ bd ~ ~ ~]!16>")
    .lpf("<1200!16 1800!16 3500!24 8000!24 2200!16>")
    .distort("<0!16 0.2!16 0.4!24 0.6!24 0.5!16>")
    .gain("<0!16 0.85!16 1.0!24 1.1!24 1.05!16>"),

  // --------------------------------------------------------------------------
  // TRACK 7: ХЛЕСТКИЙ СНЕЙР MARIO DUPLANTIER (gretsch:20 + sd)
  // Ровный несгибаемый пульс на 2 и 4 четверти 4/4 такта — якорь для ушей
  // --------------------------------------------------------------------------
  s("<~!32 [~ [gretsch:20,sd] ~ [gretsch:20,sd]]!24 [~ [gretsch:20,sd] ~ [gretsch:20,sd]]!23 [sd*8]!1 [~ [gretsch:20,sd] ~ ~]!16>")
    .hpf(160)
    .room(0.28).size(0.55)
    .distort(0.25)
    .gain("<0!32 0.92!24 0.98!24 0.88!16>"),

  // Призрачные ghost-ноты на малом барабане (сложная внутренняя полиритмия):
  s("<~!32 [~ [gretsch:3]?0.5 ~ [gretsch:3]?0.4]%19!24 [~ [gretsch:3]?0.7]!24 ~!16>")
    .hpf(300)
    .gain(0.45),

  // --------------------------------------------------------------------------
  // TRACK 8: ТАРЕЛКИ (TIMEKEEPER) — ЧАЙНА, РАЙД И ХЭТЫ
  // Постоянный 4/4 метроном сверху: China на сильные доли, хэты на шестнадцатых
  // --------------------------------------------------------------------------
  // Чайна / Крэш на четвертях:
  s("<~!32 [cr ~ ~ ~]!8 [cr*2 ~ cr ~]!16 [cr*4]!24 [cr ~!3]!16>")
    .hpf(3500)
    .room(0.35)
    .gain("<0!32 0.75!24 0.88!24 0.75!16>"),

  // Угловые метильные группы C18/C19 — пинг в колокол райда:
  s("<~!16 [~ gretsch:4 ~ gretsch:4]!16 [metal:0(5,16,2)]!24 [metal:0(7,16,1)]!24 ~!16>")
    .hpf(4500)
    .room(0.4)
    .gain("<0!16 0.6!16 0.72!24 0.8!24 0!16>"),

  // Электронный хэт-грув:
  s("<~!16 [hh*8]!16 [hh*16]!24 [hh*16]!24 ~!16>")
    .hpf(5000)
    .gain("<0!16 0.5!16 0.6!24 0.65!24 0!16>"),

  // --------------------------------------------------------------------------
  // TRACK 9: 17β-OH СОЛО-ЛИД (Gojira "Silvera" style)
  // Прорезает стену звука в кульминации (Фаза 4) — яростная парящая мелодия
  // --------------------------------------------------------------------------
  note("<~!56 [c#5@2 e5@2 f#5@2 g5@2] [f#5@2 e5@2 d5@2 c#5@2] [c#5@2 g5@3 f#5@2 e5] [d5@2 c#5@2 b4@2 c#5@2] [f#5@2 g5@2 a5@2 g5@2] [f#5@2 e5@2 d5@2 c#5@2] [g5@3 f#5@2 e5@2 d5] [c#5@4 b4@2 c#5@2] ~!16>")
    .s("gtr:2")
    .attack(0.04).decay(0.6).sustain(0.45)
    .lpf(5500)
    .distort(0.45)
    .delay(0.48).delaytime(3/16).delayfeedback(0.62)
    .room(0.75).size(0.9)
    .pan(0.55)
    .jux(rev)
    .gain("<0!56 0.86!24 0!16>")
)
