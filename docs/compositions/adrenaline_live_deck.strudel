// ============================================================================
// ADRENALINE (LIVE PERFORMANCE DECK) — RUSSIAN & BERLIN INDUSTRIAL TECHNO
// Immediate jam session version: all instruments active with live tweak points
// BPM: 160 | Meter: 4/4 | Scale: D Phrygian
// ============================================================================

setcps(160 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

stack(
  // 1. Прямая 909 бочка (Углеродный каркас C9)
  s("bd:4*4")
    .gain(0.95),

  // 2. Monasterio Sub-Rumble (16-дольный перегруженный саб)
  s("bd:4*16")
    .lpf(135).lpq(2.5)
    .distort(0.45)
    .gain(0.85)
    .pan(0.5),

  // 3. Открытый берлинский хэт на слабую долю
  s("[~ oh]*4")
    .hpf(1600)
    .gain(0.7),

  // 4. Водородный 16-дольный роллинг (13 атомов H)
  s("hh*16")
    .velocity("<[0.2 0.6 0.35 0.7 0.25 0.65 0.4 0.75]*2>")
    .hpf(3200)
    .pan(0.4)
    .gain(0.65),

  // 5. Ковалентные связи — индустриальный бэкбит (Клэп + металлический флэм)
  s("~ [cp, industrial:1] ~ [cp, industrial:1]")
    .hpf(400)
    .room(0.4).size(0.5)
    .gain(0.8),

  // 6. Катехоловое 6-членное кольцо — полиметрия 6 против 16 (Hands Productions)
  s("industrial:2(6,16)")
    .hpf(700)
    .distort(0.45)
    .pan(0.3)
    .gain(0.75),

  // 7. Фенольные группы -OH (Кислород C3 & C4 — металлические колокола)
  s("cb(5,16,1)")
    .n("<[~ 7] [~ 10] [~ 12] [~ 9]>")
    .hpf(1200)
    .room(0.4)
    .gain(0.65)
    .pan(0.75),

  // 8. Аминная группа N7 — плотный ритмик-нойз (Ancient Methods / Orphx)
  s("industrial:7(11,16,2)")
    .distort(0.6)
    .crush(5)
    .hpf(900)
    .pan(0.65)
    .gain(0.7),

  // 9. Квантовые электронные щелчки (98 электронов в стерео-поле)
  s("click(7,16,1) glitch(5,16,3)")
    .hpf(4000)
    .crush(5)
    .pan("<0.2 0.8 0.3 0.7 0.5 0.85>")
    .gain(0.55),

  // 10. Адреналиновое кислотное арпеджио (D Phrygian: C=6, H=1, N=7, O=8)
  note("<d2 eb2 g2 bb2 g2 d3 eb3 d3>*2")
    .s("saw")
    .decay(0.12).sustain(0)
    .lpf("<400 800 1600 3200 4800 2400 1200 600>")
    .lpq(7.5)
    .distort(0.35)
    .pan(0.55)
    .gain(0.7),

  // 11. Глубинный 50 Гц бункерный гул
  note("d1")
    .s("triangle")
    .lpf(90)
    .room(0.6).size(0.8)
    .gain(0.45)
)
