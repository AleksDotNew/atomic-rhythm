// ============================================================================
// SEROTONIN (LIVE PERFORMANCE DECK) — LIQUID NEURO DRUM & BASS
// Immediate jam session version: all instruments active with live tweak points
// BPM: 174 | Meter: 4/4 | Scale: D Dorian / D Minor
// ============================================================================

setcps(174 / 60 / 4)
samples('github:tidalcycles/dirt-samples')

stack(
  // 1. 2-Step Drum & Bass кик (Углеродный каркас C10)
  s("bd ~ ~ ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~")
    .gain(0.95),

  // 2. Хлесткий рабочий + призрачные дроби (Амин N + этиламин)
  s("~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ [~ sd:2]")
    .hpf(250)
    .room(0.3).size(0.5)
    .gain(0.88),

  // 3. 12 Атомов Водорода — 16-дольный роллинг хэтов
  s("hh*16")
    .velocity("<[0.2 0.65 0.35 0.75 0.25 0.6 0.4 0.8]*2>")
    .hpf(3200)
    .pan(0.4)
    .gain(0.68),

  // 4. Открытый хэт на синкопы
  s("~ ~ oh ~ ~ ~ oh ~ ~ ~ ~ ~ oh ~ ~ ~")
    .hpf(2000)
    .gain(0.65),

  // 5. Агрессивный Neurofunk Reese Bass (Хищная пила с резонансом)
  note("<[d1@3 ~ d1@2 ~!2 d1@3 ~!5] [f1@3 ~ f1@2 ~!2 f1@3 ~!5] [g1@3 ~ g1@2 ~!2 g1@3 ~!5] [eb1@3 ~ eb1@2 ~!2 eb1@3 ~!5]>")
    .s("saw")
    .decay(0.28).sustain(0.15)
    .lpf("<350 700 1400 900 500 2000 1100 400>")
    .lpq(5.5)
    .distort(0.62)
    .pan(0.5)
    .gain(0.85),

  // 6. Суб-бас (чистый синус 45 Гц)
  note("<d1 f1 g1 eb1>")
    .s("sine")
    .decay(0.35).sustain(0.4)
    .lpf(110)
    .gain(0.92),

  // 7. УЗНАВАЕМАЯ ГЛАВНАЯ МЕЛОДИЧЕСКАЯ ЛИНИЯ (Liquid DnB Anthem Lead)
  // Запоминающаяся парящая мелодия (Call & Response) в D Dorian
  note("<[~ a4 ~ [c5 d5]] [e5 ~ d5 ~]  [f5 ~ e5 d5] [b4 ~ a4 ~]  [g4 ~ a4 b4] [a4 ~ f4 ~]  [e4 ~ f4 g4] [a4 c5 e5 d5]>")
    .s("saw")
    .attack(0.01).decay(0.26).sustain(0.35).release(0.3)
    .lpf(2800).lpq(2)
    .delay(0.4).delaytime(3/16).delayfeedback(0.5)
    .jux(rev)
    .room(0.45).size(0.7)
    .gain(0.78),

  // 8. РАЗНООБРАЗНОЕ КАСКАДНОЕ АРПЕДЖИО (Liquid Waterfall Arp)
  // 4 эволюционирующих контура (терции, водопад, октавы, разворот)
  note("<[d4 a4 d5 a5 f4 c5 f5 b5 a4 d5 a5 d6 d5 a5 d6 f6] [d6 a5 d5 a4 b5 f5 c5 f4 a5 d5 a4 d4 f5 c5 a4 f4] [d4 d5 b5 d5 f4 f5 d6 f5 a4 a5 f6 a5 c5 b5 a6 b5] [d5 a5 f5 c5 a4 d5 c5 f4 d4 a4 f4 e4 d4 f4 a4 d5]>")
    .s("triangle")
    .decay(0.09).sustain(0)
    .lpf(2600)
    .delay(0.35).delaytime(2/16).delayfeedback(0.5)
    .jux(rev)
    .gain(0.68),

  // 9. Теплый атмосферный 5-HT пэд (Dm9 - G13 - Bbmaj7 - Am7)
  note("<[d3,f3,a3,c4,e4] [g3,bb3,d4,f4,a4] [bb2,d3,f3,a3,c4] [a2,c3,e3,g3,b3]>")
    .s("sine")
    .attack(0.35).release(0.85)
    .lpf(1200)
    .room(0.7).size(0.85)
    .gain(0.55),

  // 10. Пиррол (индольное кольцо 5: полиметрия 5/16)
  s("rim(5,16)")
    .hpf(600)
    .pan(0.25)
    .gain(0.75),

  // 11. Бензол (индольное кольцо 6: полиметрия 6/16)
  s("can:1(6,16)")
    .hpf(900).lpf(3500)
    .pan(0.75)
    .gain(0.55),

  // 12. Мягкий хрустальный колокольчик (Кислород C5-OH: нежный, шелковистый)
  note("<[~ ~ ~ [d6,a6]] [~ ~ ~ [e6,b6]] [~ ~ ~ [f6,c7]] [~ ~ ~ [g6,d7]]>")
    .s("sine")
    .attack(0.02).decay(0.35).sustain(0)
    .lpf(1800)
    .room(0.8).size(0.85)
    .gain(0.26)
    .pan(0.8),

  // 13. Квантовые электроны (94 микро-щелчка)
  s("click(7,16) glitch(5,16,2)")
    .hpf(4200)
    .crush(5)
    .pan("<0.2 0.8 0.3 0.7 0.5 0.85>")
    .gain(0.52)
)
